module

public import SerrePositivity.HomologicalAlgebra.CompatibleRootFamilyTor
public import Mathlib.RingTheory.Nilpotent.Lemmas
/-! # Radical quotients and surjective maps of perfect rings have vanishing higher Tor

A radical ideal is generated by compatible Frobenius roots of its own elements.
This proves the quotient/surjective case, not yet arbitrary diagrams of perfect rings.
-/

@[expose] public noncomputable section
universe u
namespace SerrePositivity
open CategoryTheory CategoryTheory.Limits
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
variable {p : ℕ} [Fact p.Prime] {R : Type u} [CommRing R] [CharP R p] [PerfectRing R p]

/-- Canonical inverse-Frobenius roots of each element of the actual ideal. -/
def perfectRadicalIdealRootFamily (I : Ideal R) (x : I) (n : ℕ) : R :=
  ((frobeniusEquiv R p).symm^[n]) (x : R)

/-- These are compatible p-power roots. -/
lemma perfectRadicalIdealRootFamily_pow (I : Ideal R) (x : I) (n : ℕ) :
    perfectRadicalIdealRootFamily (p := p) I x (n + 1) ^ p = perfectRadicalIdealRootFamily (p := p) I x n := by
  dsimp only [perfectRadicalIdealRootFamily]
  rw [Function.iterate_succ_apply']
  exact frobeniusEquiv_symm_pow_p R p _

/-- A radical ideal contains all these roots and is generated by the resulting family. -/
lemma perfectRadicalIdealRootFamily_ideal_eq (I : Ideal R) (hI : I.IsRadical) :
    compatibleRootFamilyIdeal (perfectRadicalIdealRootFamily (p := p) I) = I := by
  have hx (x : I) (n : ℕ) : perfectRadicalIdealRootFamily (p := p) I x n ∈ I := by
    induction n with
    | zero => exact x.property
    | succ n ih =>
      apply hI
      exact ⟨p, by rw [perfectRadicalIdealRootFamily_pow]; exact ih⟩
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨⟨x, n⟩, rfl⟩
    exact hx x n
  · intro x h
    exact Ideal.subset_span ⟨(⟨x, h⟩, 0), rfl⟩

/-- All positive Tor with a radical quotient vanishes for every perfect coefficient algebra. -/
lemma radicalIdeal_quotient_tor_subsingleton_of_perfectRing (I : Ideal R) (hI : I.IsRadical)
    (C : Type u) [CommRing C] [Algebra R C] [PerfectRing C p] (i : ℕ) (hi : 0 < i) :
    Subsingleton (TorModule R i (R ⧸ I) C) := by
  rw [← perfectRadicalIdealRootFamily_ideal_eq (p := p) I hI]
  exact compatibleRootFamilyQuotient_tor_subsingleton (perfectRadicalIdealRootFamily (p := p) I)
    (perfectRadicalIdealRootFamily_pow I) C i hi

/-- Surjective maps between perfect rings are Tor-independent from perfect coefficient algebras. -/
lemma perfectRing_surjective_tor_subsingleton (S : Type u) [CommRing S] [Algebra R S]
    [PerfectRing S p] (hs : Function.Surjective (algebraMap R S))
    (C : Type u) [CommRing C] [Algebra R C] [PerfectRing C p] (i : ℕ) (hi : 0 < i) :
    Subsingleton (TorModule R i S C) := by
  have hS : IsReduced S := isReduced_of_perfectPower S p (Fact.out : p.Prime).one_lt
  have hI : (RingHom.ker (algebraMap R S)).IsRadical :=
    (RingHom.ker_isRadical_iff_reduced_of_surjective hs).mpr hS
  let f : R →ₐ[R] S := Algebra.ofId R S
  let e := Ideal.quotientKerAlgEquivOfSurjective (f := f) hs
  have ht := radicalIdeal_quotient_tor_subsingleton_of_perfectRing (p := p) (RingHom.ker (algebraMap R S)) hI C i hi
  let et := ((Tor (ModuleCat R) i).mapIso e.toLinearEquiv.toModuleIso).app (ModuleCat.of R C)
  have hz : IsZero (((Tor (ModuleCat R) i).obj
      (ModuleCat.of R (R ⧸ RingHom.ker f))).obj (ModuleCat.of R C)) := by
    apply ModuleCat.isZero_iff_subsingleton.mpr
    exact ht
  exact ModuleCat.subsingleton_of_isZero (hz.of_iso et.symm)
end SerrePositivity
