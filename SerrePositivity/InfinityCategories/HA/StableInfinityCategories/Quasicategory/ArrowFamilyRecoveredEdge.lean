/-!
分割で生成：docstring を書き直すこと
概要：両端点を固定した元の全辺族を、パラメータ関手圏の同じ実辺へ戻す。
方針：同じ uncurry を区間 Hom の厳密 fiber に入れ、全族の転置を適用する。
規約：回収辺の一次単体は元の全族の転置と厳密に一致する。
使われ方：元の分母・次辺・回収商辺を同じ Hom 内で合成し比較する。
-/

@[expose] public section
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
universe u
open CategoryTheory MonoidalCategory MonoidalClosed SSet
open scoped _root_.Simplicial
open SerrePositivity.InfinityCategories
namespace SerrePositivity.KST.LocalizingInvariants
end SerrePositivity.KST.LocalizingInvariants
namespace SerrePositivity.InfinityCategories.HA.StableInfinityCategories.Quasicategory
open _root_.SerrePositivity.KST.LocalizingInvariants
variable {K X : SSet.{u}} {x y : X _⦋0⦌}
  (f : K ⟶ (ihom (Δ[1] : SSet.{u})).obj X)
  (h₀ : f ≫ _root_.SerrePositivity.InfinityCategories.Kerodon.TheHomotopyTheoryOfInfinityCategories.Equivalence.evaluateFunctorAt (stdSimplex.obj₀Equiv.symm (0 : Fin 2)) = SSet.const x)
  (h₁ : f ≫ _root_.SerrePositivity.InfinityCategories.Kerodon.TheHomotopyTheoryOfInfinityCategories.Equivalence.evaluateFunctorAt (stdSimplex.obj₀Equiv.symm (1 : Fin 2)) = SSet.const y)

/-- 元の両端点を厳密に保持した、同じ全辺族の区間 Hom 表示。 -/
def spanArrowFamilyMapping : K ⟶ _root_.SerrePositivity.InfinityCategories.Kerodon.TheHomotopyTheoryOfInfinityCategories.MorphismSpaces.intervalMappingSpace x y :=
  _root_.SerrePositivity.InfinityCategories.Kerodon.TheHomotopyTheoryOfInfinityCategories.MorphismSpaces.intervalMappingCurryOfEndpoints (uncurry f)
    (by rw [← _root_.SerrePositivity.InfinityCategories.Kerodon.TheHomotopyTheoryOfInfinityCategories.Equivalence.curry_evaluateFunctorAt_interval, curry_uncurry]; exact h₀)
    (by rw [← _root_.SerrePositivity.InfinityCategories.Kerodon.TheHomotopyTheoryOfInfinityCategories.Equivalence.curry_evaluateFunctorAt_interval, curry_uncurry]; exact h₁)

/-- 区間 Hom 表示を包含しても、元の全辺族は変わらない。 -/
lemma spanArrowFamilyMapping_inclusion : _root_.SerrePositivity.InfinityCategories.HA.StableInfinityCategories.Quasicategory.spanArrowFamilyMapping f h₀ h₁ ≫
    _root_.SerrePositivity.InfinityCategories.Kerodon.TheHomotopyTheoryOfInfinityCategories.IsomorphismsAndIsofibrations.vertexFiberι ((pre (boundary 1).ι).app X)
      (_root_.SerrePositivity.InfinityCategories.Kerodon.KanComplexes.TheHomotopyTheoryOfKanComplexes.functorVertex (_root_.SerrePositivity.InfinityCategories.Kerodon.TheHomotopyTheoryOfInfinityCategories.MorphismSpaces.intervalMappingBoundary x y)) = f := by
  apply uncurry_injective
  change _root_.SerrePositivity.InfinityCategories.Kerodon.TheHomotopyTheoryOfInfinityCategories.MorphismSpaces.intervalMappingUncurry (_root_.SerrePositivity.InfinityCategories.HA.StableInfinityCategories.Quasicategory.spanArrowFamilyMapping f h₀ h₁) = _
  exact _root_.SerrePositivity.InfinityCategories.Kerodon.TheHomotopyTheoryOfInfinityCategories.MorphismSpaces.intervalMappingUncurry_curryOfEndpoints _ _ _

/-- 定値な実辺の族の始点は、元の同じ始点に厳密に定値。 -/
lemma spanConstantArrowFamily_source {Y P : SSet.{u}} {a b : Y _⦋0⦌}
    (e : Truncated.Edge (X := (truncation 2).obj Y) a b) :
    (SSet.const (_root_.SerrePositivity.InfinityCategories.Kerodon.KanComplexes.TheHomotopyTheoryOfKanComplexes.functorVertex (SSet.yonedaEquiv.symm e.edge)) :
      P ⟶ (ihom (Δ[1] : SSet.{u})).obj Y) ≫
      _root_.SerrePositivity.InfinityCategories.Kerodon.TheHomotopyTheoryOfInfinityCategories.Equivalence.evaluateFunctorAt (stdSimplex.obj₀Equiv.symm (0 : Fin 2)) = SSet.const a := by
  rw [SSet.const_comp, _root_.SerrePositivity.InfinityCategories.Kerodon.TheHomotopyTheoryOfInfinityCategories.Equivalence.evaluateFunctorAt_functorVertex]
  have hp : stdSimplex.obj₀Equiv.symm (0 : Fin 2) =
      SSet.yonedaEquiv (stdSimplex.δ (1 : Fin 2) : (Δ[0] : SSet.{u}) ⟶ Δ[1]) := by decide
  rw [hp, ← SSet.yonedaEquiv_comp, _root_.SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.edgeSimplex_source, Equiv.apply_symm_apply]

lemma spanConstantArrowFamily_target {Y P : SSet.{u}} {a b : Y _⦋0⦌}
    (e : Truncated.Edge (X := (truncation 2).obj Y) a b) :
    (SSet.const (_root_.SerrePositivity.InfinityCategories.Kerodon.KanComplexes.TheHomotopyTheoryOfKanComplexes.functorVertex (SSet.yonedaEquiv.symm e.edge)) :
      P ⟶ (ihom (Δ[1] : SSet.{u})).obj Y) ≫
      _root_.SerrePositivity.InfinityCategories.Kerodon.TheHomotopyTheoryOfInfinityCategories.Equivalence.evaluateFunctorAt (stdSimplex.obj₀Equiv.symm (1 : Fin 2)) = SSet.const b := by
  rw [SSet.const_comp, _root_.SerrePositivity.InfinityCategories.Kerodon.TheHomotopyTheoryOfInfinityCategories.Equivalence.evaluateFunctorAt_functorVertex]
  have hp : stdSimplex.obj₀Equiv.symm (1 : Fin 2) =
      SSet.yonedaEquiv (stdSimplex.δ (0 : Fin 2) : (Δ[0] : SSet.{u}) ⟶ Δ[1]) := by decide
  rw [hp, ← SSet.yonedaEquiv_comp, _root_.SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.edgeSimplex_target, Equiv.apply_symm_apply]

end SerrePositivity.InfinityCategories.HA.StableInfinityCategories.Quasicategory

