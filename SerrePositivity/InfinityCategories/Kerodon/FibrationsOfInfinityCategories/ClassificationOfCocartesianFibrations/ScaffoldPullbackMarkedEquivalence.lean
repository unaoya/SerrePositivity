/-- 同じ辺保存 core の比較も、部分底の充填性を仮定せず同値。 -/
lemma cocartesianScaffoldPullbackMarkedCorePre_isQCatEquivalence
    [_root_.SerrePositivity.InfinityCategories.Kerodon.FibrationsOfInfinityCategories.CartesianFibrations.CocartesianFibration p] [_root_.SerrePositivity.InfinityCategories.Kerodon.FibrationsOfInfinityCategories.CartesianFibrations.CocartesianFibration q] :
    _root_.SerrePositivity.InfinityCategories.Kerodon.KanComplexes.TheHomotopyTheoryOfKanComplexes.IsQCatEquivalence (cocartesianScaffoldPullbackMarkedCorePre p q a) :=
  (cocartesianScaffoldPullbackMarkedPre_isQCatEquivalence p q a).core

end SerrePositivity.InfinityCategories.Kerodon.FibrationsOfInfinityCategories.ClassificationOfCocartesianFibrations
