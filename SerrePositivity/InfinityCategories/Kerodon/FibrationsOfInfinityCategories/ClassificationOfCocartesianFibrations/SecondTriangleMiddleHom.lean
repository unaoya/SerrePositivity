    (_root_.SerrePositivity.InfinityCategories.Kerodon.FibrationsOfInfinityCategories.ClassificationOfCocartesianFibrations.cocartesianSecondTriangleBaseSimplex_obj_zero a j 1 hj) (𝟙 (ULift.up (0 : Fin 2)))
