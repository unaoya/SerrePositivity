module

public meta import SerrePositivity.Util.Citation
public import SerrePositivity.InfinityCategories.HA.ModelCategoryComparison.Basic

public import SerrePositivity.HomotopicalAlgebra.Transfer.Recognition

/-!
# Right transfer along an ordinary adjunction

Fibrations and weak equivalences are created by the right adjoint. The two
image generating classes must separately permit the small object argument;
acyclicity of the image J-cell complexes is explicit. No algebra-specific
smallness or monoid axiom is assumed by this general theorem.
-/

@[expose] public section

universe w u₁ v₁ u₂ v₂

open CategoryTheory HomotopicalAlgebra

namespace SerrePositivity.ModelGeneration

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
  {L : C ⥤ D} {R : D ⥤ C}

/-- The right lifting class of the image generators is created by the right
adjoint. This applies to arbitrary generating classes, not just model classes. -/
lemma strictMap_rlp (adj : L ⊣ R) (I : MorphismProperty C) :
    (I.strictMap L).rlp = I.rlp.inverseImage R := by
  ext X Y p
  constructor
  · intro h A B i hi
    exact (adj.hasLiftingProperty_iff i p).1 (h _ (I.map_mem_strictMap L i hi))
  · intro h A B i hi
    cases hi with
    | map hi => exact (adj.hasLiftingProperty_iff _ p).2 (h _ hi)

variable [ModelCategory C] (I J : MorphismProperty C) [_root_.SerrePositivity.InfinityCategories.HA.ModelCategoryComparison.CofibrantlyGenerated.{w} I J]
  [Limits.HasFiniteLimits D] [Limits.HasFiniteColimits D]
  [(I.strictMap L).HasSmallObjectArgument.{w}]
  [(J.strictMap L).HasSmallObjectArgument.{w}]

/-- Right-induced fibrations on the target category. -/
@[instance_reducible]
def rightTransferredFibrations : CategoryWithFibrations D where
  fibrations := (fibrations C).inverseImage R

/-- Right-induced weak equivalences on the target category. -/
@[instance_reducible]
def rightTransferredWeakEquivalences : CategoryWithWeakEquivalences D where
  weakEquivalences := (weakEquivalences C).inverseImage R

/-- Cofibrations generated by the images of I. -/
@[instance_reducible]
def rightTransferredCofibrations : CategoryWithCofibrations D where
  cofibrations := (I.strictMap L).rlp.llp

/-- Construct the right transferred Mathlib model structure, from image-cell
acyclicity and the two image small-object hypotheses. -/
@[instance_reducible]
def rightTransfer (adj : L ⊣ R)
    (hacyclic : MorphismProperty.transfiniteCompositions.{w}
      (MorphismProperty.coproducts.{w} (J.strictMap L)).pushouts ≤
        (weakEquivalences C).inverseImage R) : ModelCategory D := by
  letI := rightTransferredFibrations (R := R)
  letI := rightTransferredWeakEquivalences (R := R)
  letI := rightTransferredCofibrations (L := L) I
  have : (weakEquivalences D).HasTwoOutOfThreeProperty :=
    inferInstanceAs (((weakEquivalences C).inverseImage R).HasTwoOutOfThreeProperty)
  have : (weakEquivalences D).IsStableUnderRetracts :=
    inferInstanceAs (((weakEquivalences C).inverseImage R).IsStableUnderRetracts)
  have hI : (I.strictMap L).rlp = trivialFibrations D := by
    rw [strictMap_rlp adj, _root_.SerrePositivity.InfinityCategories.HA.ModelCategoryComparison.CofibrantlyGenerated.rlp_I (I := I) (J := J)]
    rfl
  have hJ : (J.strictMap L).rlp = fibrations D := by
    rw [strictMap_rlp adj, _root_.SerrePositivity.InfinityCategories.HA.ModelCategoryComparison.CofibrantlyGenerated.rlp_J (I := I) (J := J)]
    rfl
  exact modelCategoryOfRecognition (I.strictMap L) (J.strictMap L) hI hJ rfl
    (generatedLeft_le_of_cells_le (J.strictMap L) _ hacyclic)

section Consequences

variable (adj : L ⊣ R)
  (hacyclic : MorphismProperty.transfiniteCompositions.{w}
    (MorphismProperty.coproducts.{w} (J.strictMap L)).pushouts ≤
      (weakEquivalences C).inverseImage R)

/-- The transfer uses exactly the stated weak-equivalence class. -/
lemma rightTransfer_weakEquivalences :
    @weakEquivalences D _ (rightTransfer I J adj hacyclic).categoryWithWeakEquivalences =
      (weakEquivalences C).inverseImage R := rfl

/-- The transfer uses exactly the stated fibration class. -/
lemma rightTransfer_fibrations :
    @fibrations D _ (rightTransfer I J adj hacyclic).categoryWithFibrations =
      (fibrations C).inverseImage R := rfl

/-- The transferred structure is cofibrantly generated by the image classes. -/
lemma rightTransfer_cofibrantlyGenerated :
    let := rightTransfer I J adj hacyclic
    _root_.SerrePositivity.InfinityCategories.HA.ModelCategoryComparison.CofibrantlyGenerated.{w} (I.strictMap L) (J.strictMap L) := by
  let := rightTransfer I J adj hacyclic
  refine ⟨inferInstance, inferInstance, ?_, ?_⟩
  · rw [strictMap_rlp adj, _root_.SerrePositivity.InfinityCategories.HA.ModelCategoryComparison.CofibrantlyGenerated.rlp_I (I := I) (J := J)]
    rfl
  · rw [strictMap_rlp adj, _root_.SerrePositivity.InfinityCategories.HA.ModelCategoryComparison.CofibrantlyGenerated.rlp_J (I := I) (J := J)]
    rfl

/-- The right adjoint creates the two right classes, so the transferred
adjunction is Quillen. -/
lemma rightTransfer_isRightQuillen :
    let := rightTransfer I J adj hacyclic
    SerrePositivity.Quillen.IsRightQuillen R := by
  let := rightTransfer I J adj hacyclic
  exact ⟨fun _ _ _ h ↦ h, fun _ _ _ h ↦ h⟩

lemma rightTransfer_isLeftQuillen :
    let := rightTransfer I J adj hacyclic
    SerrePositivity.Quillen.IsLeftQuillen L := by
  let := rightTransfer I J adj hacyclic
  have := rightTransfer_isRightQuillen I J adj hacyclic
  exact SerrePositivity.Quillen.isLeftQuillen_of_isRightQuillen adj

end Consequences

end SerrePositivity.ModelGeneration

