module

public import SerrePositivity.InfinityCategories.Project.SimplicialCombinatorics.Subdivision.UniverseLift
public import SerrePositivity.HomotopicalAlgebra.Simplicial.FullyFaithfulLifting
public import Mathlib.AlgebraicTopology.SimplicialSet.CategoryWithFibrations
public import Mathlib.CategoryTheory.Limits.FunctorCategory.EpiMono

/-! # Boundary and horn lifting across simplicial universes

These equivalences are independent of model existence. The fixed right
classes generated by boundaries and horns are both preserved and reflected.
-/

@[expose] public section
universe w v
noncomputable section
open CategoryTheory

namespace SerrePositivity.SimplicialModel.UniverseLift
variable {X Y : SSet.{v}} (p : X ⟶ Y)

lemma boundary_lifting_iff (n : ℕ) :
    HasLiftingProperty (SSet.boundary.{max v w} n).ι (SSet.uliftFunctor.{w, v}.map p) ↔
      HasLiftingProperty (SSet.boundary.{v} n).ι p :=
  (HasLiftingProperty.iff_of_arrow_iso_left (_root_.SerrePositivity.InfinityCategories.Project.SimplicialCombinatorics.boundaryArrowIso n) _).symm.trans
    (ModelGeneration.hasLiftingProperty_map_iff SSet.uliftFunctor.{w, v} _ p)

lemma horn_lifting_iff (n : ℕ) (i : Fin (n + 1)) :
    HasLiftingProperty (SSet.horn.{max v w} n i).ι (SSet.uliftFunctor.{w, v}.map p) ↔
      HasLiftingProperty (SSet.horn.{v} n i).ι p :=
  (HasLiftingProperty.iff_of_arrow_iso_left (_root_.SerrePositivity.InfinityCategories.Project.SimplicialCombinatorics.hornArrowIso n i) _).symm.trans
    (ModelGeneration.hasLiftingProperty_map_iff SSet.uliftFunctor.{w, v} _ p)

lemma boundary_rightClass_iff :
    SSet.modelCategoryQuillen.I.{max v w}.rlp (SSet.uliftFunctor.{w, v}.map p) ↔
      SSet.modelCategoryQuillen.I.{v}.rlp p := by
  constructor
  · intro h A B i hi
    obtain ⟨n⟩ := hi
    exact (boundary_lifting_iff p n).mp
      (h _ (SSet.modelCategoryQuillen.boundary_ι_mem_I n))
  · intro h A B i hi
    obtain ⟨n⟩ := hi
    exact (boundary_lifting_iff p n).mpr
      (h _ (SSet.modelCategoryQuillen.boundary_ι_mem_I n))

lemma horn_rightClass_iff :
    SSet.modelCategoryQuillen.J.{max v w}.rlp (SSet.uliftFunctor.{w, v}.map p) ↔
      SSet.modelCategoryQuillen.J.{v}.rlp p := by
  constructor
  · intro h A B i hi
    simp only [SSet.modelCategoryQuillen.J, MorphismProperty.iSup_iff] at hi
    obtain ⟨n, ⟨i⟩⟩ := hi
    exact (horn_lifting_iff p (n + 1) i).mp
      (h _ (SSet.modelCategoryQuillen.horn_ι_mem_J (n + 1) i))
  · intro h A B i hi
    simp only [SSet.modelCategoryQuillen.J, MorphismProperty.iSup_iff] at hi
    obtain ⟨n, ⟨i⟩⟩ := hi
    exact (horn_lifting_iff p (n + 1) i).mpr
      (h _ (SSet.modelCategoryQuillen.horn_ι_mem_J (n + 1) i))

lemma mono_map [Mono p] : Mono (SSet.uliftFunctor.{w, v}.map p) := by
  have : ∀ n, Mono ((SSet.uliftFunctor.{w, v}.map p).app n) := by
    intro n
    rw [mono_iff_injective]
    intro a b h
    apply ULift.ext
    exact (mono_iff_injective (p.app n)).mp inferInstance (ULift.ext_iff.mp h)
  exact NatTrans.mono_of_mono_app _

end SerrePositivity.SimplicialModel.UniverseLift
