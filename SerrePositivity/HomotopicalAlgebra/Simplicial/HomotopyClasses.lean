/- 旧モジュールの技術注記（構成と注意を保存）
# Classes of simplicial maps under interval homotopies

The quotient uses the equivalence relation generated by actual interval homotopies.
No Kan condition or model structure is required to define the contravariant functor.
-/

@[expose] public section
universe v w uH vH
noncomputable section
open CategoryTheory CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open Opposite

namespace SerrePositivity.SimplicialModel.HomotopyClasses

abbrev obj (X K : SSet.{v}) := Quot (fun (f g : X ⟶ K) => Nonempty (SSet.Homotopy f g))

def mk {X K : SSet.{v}} (f : X ⟶ K) : obj X K := Quot.mk _ f

lemma sound {X K : SSet.{v}} {f g : X ⟶ K} (h : SSet.Homotopy f g) : mk f = mk g :=
  Quot.sound ⟨h⟩

def preHomotopy {A X K : SSet.{v}} (i : A ⟶ X) {f g : X ⟶ K}
    (H : SSet.Homotopy f g) : SSet.Homotopy (i ≫ f) (i ≫ g) where
  h := i ▷ _ ≫ H.h
  h₀ := by
    change SSet.ι₀ ≫ (i ▷ _ ≫ H.h) = i ≫ f
    have h : SSet.ι₀ ≫ i ▷ _ = i ≫ SSet.ι₀ := by
      apply NatTrans.ext
      funext n
      apply ConcreteCategory.hom_ext
      intro x
      rfl
    rw [← Category.assoc, h, Category.assoc, H.h₀]
  h₁ := by
    change SSet.ι₁ ≫ (i ▷ _ ≫ H.h) = i ≫ g
    have h : SSet.ι₁ ≫ i ▷ _ = i ≫ SSet.ι₁ := by
      apply NatTrans.ext
      funext n
      apply ConcreteCategory.hom_ext
      intro x
      rfl
    rw [← Category.assoc, h, Category.assoc, H.h₁]
  rel := by
    apply NatTrans.ext
    funext n
    exact ConcreteCategory.hom_ext _ _ (fun x => False.elim x.1.property)

def pre {A X K : SSet.{v}} (i : A ⟶ X) : obj X K → obj A K :=
  Quot.map (fun f => i ≫ f) (fun _ _ ⟨H⟩ => ⟨preHomotopy i H⟩)

@[simp] lemma pre_mk {A X K : SSet.{v}} (i : A ⟶ X) (f : X ⟶ K) :
    pre i (mk f) = mk (i ≫ f) := rfl

def postHomotopy {X K T : SSet.{v}} (p : K ⟶ T) {f g : X ⟶ K}
    (H : SSet.Homotopy f g) : SSet.Homotopy (f ≫ p) (g ≫ p) where
  h := H.h ≫ p
  h₀ := by change SSet.ι₀ ≫ (H.h ≫ p) = f ≫ p; rw [← Category.assoc, H.h₀]
  h₁ := by change SSet.ι₁ ≫ (H.h ≫ p) = g ≫ p; rw [← Category.assoc, H.h₁]
  rel := by
    apply NatTrans.ext
    funext n
    exact ConcreteCategory.hom_ext _ _ (fun x => False.elim x.1.property)

def post {X K T : SSet.{v}} (p : K ⟶ T) : obj X K → obj X T :=
  Quot.map (fun f => f ≫ p) (fun _ _ ⟨H⟩ => ⟨postHomotopy p H⟩)

@[simp] lemma post_mk {X K T : SSet.{v}} (p : K ⟶ T) (f : X ⟶ K) :
    post p (mk f) = mk (f ≫ p) := rfl

def functor (K : SSet.{v}) : SSet.{v}ᵒᵖ ⥤ Type v where
  obj X := obj X.unop K
  map i := ↾(pre i.unop)
  map_id X := by
    apply ConcreteCategory.hom_ext
    intro x
    refine Quot.inductionOn x (fun f => ?_)
    exact congrArg mk (Category.id_comp f)
  map_comp i j := by
    apply ConcreteCategory.hom_ext
    intro x
    refine Quot.inductionOn x (fun f => ?_)
    exact congrArg mk (Category.assoc _ _ _)

variable {H : Type uH} [Category.{vH} H] (L : SSet.{v} ⥤ H)
  (hL : SSet.anodyneExtensions.IsInvertedBy L)

def toLocalizedHom (X K : SSet.{v}) : obj X K → (L.obj X ⟶ L.obj K) :=
  Quot.lift L.map (fun _ _ ⟨h⟩ => AnodyneHomotopy.map_homotopy_eq L hL h)

@[simp] lemma toLocalizedHom_mk {X K : SSet.{v}} (f : X ⟶ K) :
    toLocalizedHom L hL X K (mk f) = L.map f := rfl

include hL in
/-- 全ての区間ホモトピー類によるテストから局所化像の可逆性を判定する。

宇宙・境界・比較射は各宣言に指定されたものを用いる。
実写像または区間ホモトピーの関係を商へ降ろす。
代表元に依らないことを確認してから、誘導写像と比較を組み立てる。
-/
lemma map_isIso_of_tests {X Y : SSet.{v}} (f : X ⟶ Y)
    (hs : Function.Surjective (pre f (K := X)))
    (hj : Function.Injective (pre f (K := Y))) : IsIso (L.map f) := by
  obtain ⟨x, hx⟩ := hs (mk (𝟙 X))
  obtain ⟨g, rfl⟩ := Quot.exists_rep x
  have hfg : mk (f ≫ g) = mk (𝟙 X) := hx
  have hgf : mk (g ≫ f) = mk (𝟙 Y) := hj (by
    simpa only [pre_mk, post_mk, Category.assoc, Category.id_comp, Category.comp_id]
      using congrArg (post f) hfg)
  let e : L.obj X ≅ L.obj Y :=
    { hom := L.map f
      inv := L.map g
      hom_inv_id := (L.map_comp _ _).symm.trans
        ((congrArg (toLocalizedHom L hL X X) hfg).trans (L.map_id X))
      inv_hom_id := (L.map_comp _ _).symm.trans
        ((congrArg (toLocalizedHom L hL Y Y) hgf).trans (L.map_id Y)) }
  exact e.isIso_hom

end SerrePositivity.SimplicialModel.HomotopyClasses
