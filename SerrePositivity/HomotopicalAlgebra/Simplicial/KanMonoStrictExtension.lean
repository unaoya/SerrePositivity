module

public import SerrePositivity.HomotopicalAlgebra.Simplicial.KanMonoEndpointExtension
public import SerrePositivity.HomotopicalAlgebra.Simplicial.KanTestDetection

/-!
# Kan値ホモトピー類のテストから指定写像の厳密な延長を構成する

## 概要
Kan値ホモトピー類のテストから指定写像の厳密な延長を構成する。
一般に再利用できる道具として分類Aに整理する。

## 方針（定義・証明）
指定された境界と基底から可換正方形を作り、その持ち上げ性を使う。
元の指定部分を保つ等式は、対角射の二つの分解等式から確認する。

## 規約と注意
Kan条件・右持ち上げ性・単射性は各宣言で指定された範囲で用いる。
ここでのKan条件は外側も含む全hornの充填であり、内側hornだけの条件ではない。

## 使われ方
stage 4の完成部分L・E・Sからの利用はない（依存監査で確認済み）。
今後はK理論空間の充填・ホモトピー比較やπ_*計算の基礎として利用できる。
[棚卸し m0426][inventory]と[計画書 §396][plan]を参照。

[inventory]: ../../../formalization-plans/k-theory-generalization-inventory.md#m0426
[plan]: ../../../formalization-plans/archive/k-theory-v1.md#396-任意モデル源への一般化中断2026-10-17
-/

/- 旧モジュールの技術注記（構成と注意を保存）
# Strict extension of prescribed maps from Kan-valued homotopy-class tests

Extension along a monomorphism is invariant under the entire equivalence
relation generated by interval homotopies, in both directions. Hence a
surjective class test gives an actual extension of the original map.
-/

@[expose] public section
universe v
noncomputable section
open CategoryTheory CategoryTheory.Limits

namespace SerrePositivity.SimplicialModel.KanMonoStrictExtension
open HomotopyClasses
variable {A B K : SSet.{v}} (i : A ⟶ B) [Mono i]
  (hK : SSet.modelCategoryQuillen.J.rlp (terminal.from K))

abbrev Extends (a : A ⟶ K) : Prop := ∃ b : B ⟶ K, i ≫ b = a

def extendsClass : obj A K → Prop := Quot.lift (Extends i) (by
  intro a₀ a₁ h
  obtain ⟨H⟩ := h
  apply propext
  constructor
  · rintro ⟨b, hb⟩
    have H' : SSet.Homotopy (i ≫ b) a₁ := by rw [hb]; exact H
    obtain ⟨g, hg, _⟩ := KanMonoEndpointExtension.exists_from_zero i hK b a₁ H'
    exact ⟨g, hg⟩
  · rintro ⟨b, hb⟩
    have H' : SSet.Homotopy a₀ (i ≫ b) := by rw [hb]; exact H
    obtain ⟨g, hg, _⟩ := KanMonoEndpointExtension.exists_from_one i hK b a₀ H'
    exact ⟨g, hg⟩)

include hK in
lemma extends_of_class_eq {a a' : A ⟶ K} (h : mk a = mk a') (ha : Extends i a) :
    Extends i a' := by
  have hp := congrArg (extendsClass i hK) h
  change Extends i a = Extends i a' at hp
  exact hp ▸ ha

include hK in
lemma exists_extension_of_surjective (hs : Function.Surjective (pre i (K := K)))
    (a : A ⟶ K) : ∃ b : B ⟶ K, i ≫ b = a := by
  obtain ⟨x, hx⟩ := hs (mk a)
  obtain ⟨b, rfl⟩ := Quot.exists_rep x
  exact extends_of_class_eq i hK hx ⟨b, rfl⟩

include hK in
/-- Kan値ホモトピー類のテストから指定写像の厳密な延長を構成する。

Kan条件・右持ち上げ性・単射性は各宣言で指定された範囲で用いる。
指定された境界と基底から可換正方形を作り、その持ち上げ性を使う。
元の指定部分を保つ等式は、対角射の二つの分解等式から確認する。
-/
lemma exists_extension (hi : IsIso (AnodyneHomotopy.anodyneQ.map i)) (a : A ⟶ K) :
    ∃ b : B ⟶ K, i ≫ b = a :=
  exists_extension_of_surjective i hK
    (KanTestDetection.tests_of_anodyneQ_isIso i hi K hK).surjective a

include hK in
lemma terminal_lifting (hi : IsIso (AnodyneHomotopy.anodyneQ.map i)) :
    HasLiftingProperty i (terminal.from K) := by
  constructor
  intro a b sq
  obtain ⟨g, hg⟩ := exists_extension i hK hi a
  exact CommSq.HasLift.mk'
    { l := g, fac_left := hg, fac_right := terminal.hom_ext _ _ }

end SerrePositivity.SimplicialModel.KanMonoStrictExtension
