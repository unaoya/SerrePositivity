module

public import SerrePositivity.CommutativeAlgebra.HilbertSamuel
public import SerrePositivity.CommutativeAlgebra.HilbertSamuel.PolynomialGrowth
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import SerrePositivity.CommutativeAlgebra.HilbertSamuel.Dimension

/-! # パラメータの冪の重複度と長さの上界

## 概要

パラメータ系の各成分を冪にしたときの重複度 `e((z^v)) = v^r e((z))`（`multiplicity_parameter_pow`）と、
冪で割った商の長さの多項式的な上界を示す。

## 方針

冪の Samuel 関数を元の Samuel 関数で挟み、十分先の値の比較から最高次係数を比べる
（`HilbertSamuel/PolynomialGrowth`）。

## 規約

名前空間は `KoszulMultiplicity`。

## 使われ方

重複度の公式（`KoszulMultiplicity/Formula`）と Frobenius 冪の増大（`KoszulMultiplicity/FrobeniusGrowth`）。
-/

@[expose] public noncomputable section

universe u v w

section Multiplicity

namespace SerrePositivity.KoszulMultiplicity

open Polynomial Filter IsLocalRing

variable {R : Type u} [CommRing R]

/-- The sum of integer quotients of monomial exponents controls its total degree,
with an error at most one remainder per generator. -/
theorem sum_div_ge_of_degree_eq {r : ℕ} (d : Fin r →₀ ℕ) (v n : ℕ) (hv : 0 < v)
    (hd : d.degree = v * n + r * (v - 1)) : n ≤ ∑ i, d i / v := by
  have hdecomp : d.degree = (∑ i, d i % v) + v * (∑ i, d i / v) := by
    rw [Finsupp.degree_eq_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i _
    exact (Nat.mod_add_div (d i) v).symm
  have hrem : (∑ i : Fin r, d i % v) ≤ r * (v - 1) := by
    calc
      _ ≤ ∑ _i : Fin r, (v - 1) := Finset.sum_le_sum (fun i _ => by
        have := Nat.mod_lt (d i) hv
        omega)
      _ = _ := by simp
  have hmul : v * n ≤ v * (∑ i, d i / v) := by omega
  exact Nat.le_of_mul_le_mul_left hmul hv

/-- A sufficiently high-degree monomial belongs to the required power of the ideal
generated by the generator powers. -/
theorem monomial_mem_generator_power {r : ℕ} (z : Fin r → R) (d : Fin r →₀ ℕ)
    (v n : ℕ) (hv : 0 < v) (hd : d.degree = v * n + r * (v - 1)) :
    (∏ i, z i ^ d i) ∈ (Ideal.span (Set.range fun i => z i ^ v)) ^ n := by
  classical
  let J : Ideal R := Ideal.span (Set.range fun i => z i ^ v)
  have hprod : (∏ i, (z i ^ v) ^ (d i / v)) ∈ J ^ (∑ i, d i / v) := by
    rw [← Finset.prod_pow_eq_pow_sum]
    exact Ideal.prod_mem_prod (fun i _ => Ideal.pow_mem_pow
      (Ideal.subset_span (Set.mem_range_self i)) (d i / v))
  have hprod' : (∏ i, (z i ^ v) ^ (d i / v)) ∈ J ^ n :=
    (Ideal.pow_le_pow_right (sum_div_ge_of_degree_eq d v n hv hd)) hprod
  have hfactor : (∏ i, z i ^ d i) =
      (∏ i, (z i ^ v) ^ (d i / v)) * (∏ i, z i ^ (d i % v)) := by
    rw [← Finset.prod_mul_distrib]
    apply Finset.prod_congr rfl
    intro i _
    calc
      z i ^ d i = z i ^ (d i % v + v * (d i / v)) :=
        congrArg (fun e => z i ^ e) (Nat.mod_add_div (d i) v).symm
      _ = _ := by rw [pow_add, pow_mul]; ring
  rw [hfactor]
  exact (J ^ n).mul_mem_right _ hprod'

/-- The bounded-excess power inclusion from monomial exponent counting. -/
theorem span_pow_le_generator_power {r : ℕ} (z : Fin r → R) (v n : ℕ) (hv : 0 < v) :
    (Ideal.span (Set.range z)) ^ (v * n + r * (v - 1)) ≤
      (Ideal.span (Set.range fun i => z i ^ v)) ^ n := by
  classical
  intro a ha
  obtain ⟨p, hp, rfl⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous z a).mp ha
  rw [MvPolynomial.as_sum p, MvPolynomial.eval_sum]
  apply Ideal.sum_mem
  intro d hd
  rw [MvPolynomial.eval_monomial, Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
  apply Ideal.mul_mem_left
  exact monomial_mem_generator_power z d v n hv (hp.degree_eq_sum_deg_support hd).symm

/-- The immediate reverse power inclusion. -/
theorem generator_power_le_span_pow {r : ℕ} (z : Fin r → R) (v n : ℕ) :
    (Ideal.span (Set.range fun i => z i ^ v)) ^ n ≤
      (Ideal.span (Set.range z)) ^ (v * n) := by
  rw [pow_mul]
  apply Ideal.pow_right_mono
  rw [Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  exact Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) v

/-- Eventual comparison orders any fixed coefficient above all lower terms. -/
theorem coeff_le_of_eventually_eval_le {P Q : ℚ[X]} (k : ℕ)
    (hP : P.natDegree ≤ k) (hQ : Q.natDegree ≤ k)
    (hPQ : ∀ᶠ n : ℕ in atTop, P.eval (n : ℚ) ≤ Q.eval (n : ℚ)) :
    P.coeff k ≤ Q.coeff k := by
  by_contra! hcoeff
  have hdiff : 0 < (P - Q).coeff k := by rw [coeff_sub]; exact sub_pos.mpr hcoeff
  have hdeg : (P - Q).natDegree = k :=
    natDegree_eq_of_le_of_coeff_ne_zero
      ((natDegree_sub_le P Q).trans (max_le hP hQ)) hdiff.ne'
  have hlc : 0 < (P - Q).leadingCoeff := by simpa only [leadingCoeff, hdeg] using hdiff
  obtain ⟨n, hn, hnpos⟩ := (hPQ.and (eventually_eval_pos hlc)).exists
  rw [eval_sub] at hnpos
  exact (not_lt_of_ge hn) (sub_pos.mp hnpos)

/-- Affine substitution with nonzero slope rescales the highest coefficient. -/
theorem coeff_comp_affine_top {P : ℚ[X]} (k : ℕ) (hP : P.natDegree = k)
    (a b : ℚ) (ha : a ≠ 0) :
    (P.comp (C a * X + C b)).coeff k = a ^ k * P.coeff k := by
  have hd : (P.comp (C a * X + C b)).natDegree = k := by
    rw [natDegree_comp, natDegree_linear ha, mul_one, hP]
  rw [← hd, coeff_natDegree, leadingCoeff_comp (by rw [natDegree_linear ha]; decide),
    leadingCoeff_linear ha, leadingCoeff, hP]
  rw [hd]
  ring

/-- A containment of ideal powers compares the corresponding Samuel lengths. -/
theorem samuelFunction_le_of_pow_le (I J : Ideal R) (a b : ℕ) (h : J ^ a ≤ I ^ b) :
    HilbertSamuel.samuelFunction R I R b ≤ HilbertSamuel.samuelFunction R J R a := by
  have hs := HilbertSamuel.samuelFunction_antitone_ideal R R 1 h
  change HilbertSamuel.samuelFunction R (I ^ b) R 1 ≤
    HilbertSamuel.samuelFunction R (J ^ a) R 1 at hs
  simpa only [HilbertSamuel.samuelFunction_pow, Nat.mul_one] using hs

/-- An eventual assertion remains eventual after a positive affine reindexing. -/
theorem eventually_affine_nat {p : ℕ → Prop} (hp : ∀ᶠ n : ℕ in atTop, p n)
    (v b : ℕ) (hv : 0 < v) : ∀ᶠ n : ℕ in atTop, p (v * n + b) := by
  obtain ⟨N, hN⟩ := eventually_atTop.mp hp
  apply eventually_atTop.mpr
  exact ⟨N, fun n hn => hN _
    ((hn.trans (Nat.le_mul_of_pos_left n hv)).trans (Nat.le_add_right _ _))⟩

/-- Powers of every parameter generator rescale multiplicity by `v^r`.
The proof is independent of the Koszul multiplicity formula. -/
theorem multiplicity_parameter_pow (D : Type u) [CommRing D] [IsLocalRing D]
    [IsNoetherianRing D] {r : ℕ} (z : Fin r → D) (hz : IsSystemOfParameters D z)
    (v : ℕ) (hv : 0 < v) :
    HilbertSamuel.multiplicity D (Ideal.span (Set.range fun i => z i ^ v)) D =
      (v : ℚ) ^ r * HilbertSamuel.multiplicity D (Ideal.span (Set.range z)) D := by
  let I := Ideal.span (Set.range z)
  let J := Ideal.span (Set.range fun i => z i ^ v)
  let b := r * (v - 1)
  let P := HilbertSamuel.poly D I D
  let Q := HilbertSamuel.poly D J D
  have hI : I.radical = maximalIdeal D := hz.2
  have hJ : J.radical = maximalIdeal D := (hz.pow D v hv).2
  have hd : dimToNat (ringKrullDim D) = r := by rw [hz.1]; simp [dimToNat]
  have hPd : P.natDegree = r := (HilbertSamuel.natDegree_poly_eq_dim D I hI).trans hd
  have hQd : Q.natDegree = r := (HilbertSamuel.natDegree_poly_eq_dim D J hJ).trans hd
  have hP := HilbertSamuel.isSamuelPoly_poly_of_radical D I hI D
  have hQ := HilbertSamuel.isSamuelPoly_poly_of_radical D J hJ D
  have hPlow := eventually_affine_nat hP v 0 hv
  have hPhigh := eventually_affine_nat hP v b hv
  have ha : (v : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hv.ne'
  let A := P.comp (C (v : ℚ) * X + C 0)
  let B := P.comp (C (v : ℚ) * X + C (b : ℚ))
  have hAd : A.natDegree ≤ r := (natDegree_comp_affine_le P _ _).trans hPd.le
  have hBd : B.natDegree ≤ r := (natDegree_comp_affine_le P _ _).trans hPd.le
  have hAQ : ∀ᶠ n : ℕ in atTop, A.eval (n : ℚ) ≤ Q.eval (n : ℚ) := by
    filter_upwards [hPlow, hQ] with n hnP hnQ
    simp only [Nat.add_zero] at hnP
    change (P.comp (C (v : ℚ) * X + C 0)).eval (n : ℚ) ≤ Q.eval (n : ℚ)
    simp only [eval_comp, eval_add, eval_mul, eval_C, eval_X, add_zero, ← Nat.cast_mul]
    rw [← hnP.2, ← hnQ.2]
    exact_mod_cast ENat.toNat_le_toNat
      (samuelFunction_le_of_pow_le I J n (v * n) (generator_power_le_span_pow z v n)) hnQ.1
  have hQB : ∀ᶠ n : ℕ in atTop, Q.eval (n : ℚ) ≤ B.eval (n : ℚ) := by
    filter_upwards [hQ, hPhigh] with n hnQ hnP
    change Q.eval (n : ℚ) ≤ (P.comp (C (v : ℚ) * X + C (b : ℚ))).eval (n : ℚ)
    simp only [eval_comp, eval_add, eval_mul, eval_C, eval_X, ← Nat.cast_mul, ← Nat.cast_add]
    rw [← hnQ.2, ← hnP.2]
    exact_mod_cast ENat.toNat_le_toNat
      (samuelFunction_le_of_pow_le J I (v * n + b) n (span_pow_le_generator_power z v n hv)) hnP.1
  have hcoeff : Q.coeff r = (v : ℚ) ^ r * P.coeff r := by
    have hlo := coeff_le_of_eventually_eval_le r hAd hQd.le hAQ
    have hhi := coeff_le_of_eventually_eval_le r hQd.le hBd hQB
    rw [show A.coeff r = _ from coeff_comp_affine_top r hPd (v : ℚ) 0 ha] at hlo
    rw [show B.coeff r = _ from coeff_comp_affine_top r hPd (v : ℚ) (b : ℚ) ha] at hhi
    exact le_antisymm hhi hlo
  dsimp only [HilbertSamuel.multiplicity]
  simp only [Module.supportDim_self_eq_ringKrullDim, hd]
  change (r.factorial : ℚ) * Q.coeff r = (v : ℚ) ^ r * ((r.factorial : ℚ) * P.coeff r)
  rw [hcoeff]
  ring

end SerrePositivity.KoszulMultiplicity

end Multiplicity

section LengthBound

open Polynomial IsLocalRing Filter

namespace SerrePositivity

/-- 次数 `d` 以下の有理係数多項式は、非負の点で `A (x + 1)^d` 以下。係数の絶対値の和を `A` にとる。 -/
lemma Polynomial.exists_eval_le_mul_pow (P : ℚ[X]) (d : ℕ) (hd : P.natDegree ≤ d) :
    ∃ A : ℕ, ∀ x : ℚ, 0 ≤ x → P.eval x ≤ A * (x + 1) ^ d := by
  refine ⟨⌈∑ i ∈ Finset.range (P.natDegree + 1), |P.coeff i|⌉₊, fun x hx ↦ ?_⟩
  rw [Polynomial.eval_eq_sum_range]
  calc
    ∑ i ∈ Finset.range (P.natDegree + 1), P.coeff i * x ^ i
        ≤ ∑ i ∈ Finset.range (P.natDegree + 1), |P.coeff i| * (x + 1) ^ d := by
      apply Finset.sum_le_sum
      intro i hi
      have hi' : i ≤ d := by
        have := Finset.mem_range.mp hi
        omega
      have hpow : x ^ i ≤ (x + 1) ^ d :=
        (pow_le_pow_left₀ hx (by linarith) i).trans (pow_le_pow_right₀ (by linarith) hi')
      calc
        P.coeff i * x ^ i ≤ |P.coeff i| * x ^ i :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (by positivity)
        _ ≤ |P.coeff i| * (x + 1) ^ d := mul_le_mul_of_nonneg_left hpow (abs_nonneg _)
    _ = (∑ i ∈ Finset.range (P.natDegree + 1), |P.coeff i|) * (x + 1) ^ d :=
      (Finset.sum_mul ..).symm
    _ ≤ _ := mul_le_mul_of_nonneg_right (Nat.le_ceil _) (by positivity)

variable (E : Type u) [CommRing E] [IsNoetherianRing E] [IsLocalRing E]

/-- Samuel 関数は全ての `n` で `C (n + 1)^e` 以下（`dim E ≤ e`）。十分先では次数 `dim E` の多項式で、
それ以前は単調性で十分先の値に押し上げる。 -/
theorem HilbertSamuel.exists_samuelFunction_le_pow (I : Ideal E)
    (hI : I.radical = maximalIdeal E) (e : ℕ) (hdim : dimToNat (ringKrullDim E) ≤ e) :
    ∃ C : ℕ, ∀ n : ℕ, HilbertSamuel.samuelFunction E I E n ≤ ((C * (n + 1) ^ e : ℕ) : ℕ∞) := by
  have hP := HilbertSamuel.isSamuelPoly_poly_of_radical E I hI E
  have hdeg : (HilbertSamuel.poly E I E).natDegree ≤ e := by
    rw [HilbertSamuel.natDegree_poly_eq_dim E I hI]
    exact hdim
  obtain ⟨A, hA⟩ := Polynomial.exists_eval_le_mul_pow _ e hdeg
  obtain ⟨N, hN⟩ := eventually_atTop.mp hP
  refine ⟨A * (N + 1) ^ e, fun n ↦ ?_⟩
  set m := max n N
  have hmono := HilbertSamuel.samuelFunction_mono E I (M := E) (le_max_left n N)
  have hm := hN m (le_max_right n N)
  -- 十分先の値は多項式の値
  have hval : (HilbertSamuel.samuelFunction E I E m).toNat ≤ A * (m + 1) ^ e := by
    have h := hA (m : ℚ) (by positivity)
    rw [← hm.2] at h
    exact_mod_cast h
  have hm1 : m + 1 ≤ (N + 1) * (n + 1) := by
    rcases le_total n N with h | h
    · simp only [m, max_eq_right h]
      nlinarith
    · simp only [m, max_eq_left h]
      nlinarith
  have hbound : A * (m + 1) ^ e ≤ A * (N + 1) ^ e * (n + 1) ^ e := by
    rw [mul_assoc, ← mul_pow]
    exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hm1 e)
  calc
    HilbertSamuel.samuelFunction E I E n ≤ HilbertSamuel.samuelFunction E I E m := hmono
    _ = ((HilbertSamuel.samuelFunction E I E m).toNat : ℕ∞) := (ENat.natCast_toNat hm.1).symm
    _ ≤ _ := by exact_mod_cast hval.trans hbound

/-- **パラメータの冪の商の長さ**：`z` が極大イデアル準素なイデアルを生成し `dim E ≤ e` なら、
定数 `C` があって `v ≥ 1` で `ℓ(E / (z^v)) ≤ C v^e`。`(z)^{(r+1)v} ⊆ (z^v)` と Samuel 関数の評価による。 -/
theorem exists_length_quotient_generator_pow_le {r : ℕ} (z : Fin r → E)
    (hz : (Ideal.span (Set.range z)).radical = maximalIdeal E) (e : ℕ)
    (hdim : dimToNat (ringKrullDim E) ≤ e) :
    ∃ C : ℕ, ∀ v : ℕ, 0 < v →
      Module.length E (E ⧸ Ideal.span (Set.range fun i ↦ z i ^ v)) ≤ ((C * v ^ e : ℕ) : ℕ∞) := by
  set I := Ideal.span (Set.range z)
  obtain ⟨C, hC⟩ := HilbertSamuel.exists_samuelFunction_le_pow E I hz e hdim
  refine ⟨C * (r + 2) ^ e, fun v hv ↦ ?_⟩
  -- 冪のイデアルの包含
  have hcont : I ^ ((r + 1) * v) ≤ Ideal.span (Set.range fun i ↦ z i ^ v) := by
    have h := KoszulMultiplicity.span_pow_le_generator_power z v 1 hv
    rw [pow_one, mul_one] at h
    exact (Ideal.pow_le_pow_right (by
      have : r * (v - 1) ≤ r * v := Nat.mul_le_mul_left r (Nat.sub_le v 1)
      nlinarith)).trans h
  have hsub : (I ^ ((r + 1) * v) • ⊤ : Submodule E E) ≤ Ideal.span (Set.range fun i ↦ z i ^ v) := by
    rw [Ideal.smul_eq_mul, Ideal.mul_top]
    exact hcont
  have hlen : Module.length E (E ⧸ Ideal.span (Set.range fun i ↦ z i ^ v)) ≤
      HilbertSamuel.samuelFunction E I E ((r + 1) * v) :=
    Module.length_le_of_surjective (Submodule.factor hsub) (Submodule.factor_surjective hsub)
  refine hlen.trans ((hC _).trans ?_)
  have h1 : (r + 1) * v + 1 ≤ (r + 2) * v := by nlinarith
  have h2 : C * ((r + 1) * v + 1) ^ e ≤ C * (r + 2) ^ e * v ^ e := by
    rw [mul_assoc, ← mul_pow]
    exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_left h1 e)
  exact_mod_cast h2

end SerrePositivity

end LengthBound
