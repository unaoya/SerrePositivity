module

public import Mathlib.RingTheory.Idempotents
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.LinearAlgebra.Span.Basic
public import Mathlib.Algebra.Group.Idempotent

/-! # 冪等元と零化・像・積

## 概要

冪等元による零化、冪等元の像の零化と基底変換、有限積の冪等元による商を与える。

## 方針

冪等元の像は Mathlib の `IsIdempotentElem` の補題（`IsIdempotentElem.map` など）に乗せる。

## 規約

変種の補題は 2 つ（左右）にまとめる。

## 使われ方

CLMST の積の成分への分解、PerfectComplex の冪等元の像。
-/

@[expose] public noncomputable section

universe u v w

section IdempotentAnnihilatorPart

namespace SerrePositivity

/-- The annihilator of 1-e is exactly the principal ideal generated by e. -/
theorem annihilator_span_one_sub_of_idempotent
    (R : Type u) [CommRing R] (e : R) (he : IsIdempotentElem e) :
    (Ideal.span {1 - e}).annihilator = Ideal.span {e} := by
  ext x
  rw [Submodule.mem_annihilator_span_singleton, Ideal.mem_span_singleton]
  change x * (1 - e) = 0 ↔ e ∣ x
  constructor
  · intro h
    refine ⟨x, ?_⟩
    have hx : x = x * e := sub_eq_zero.mp (by simpa only [mul_sub, mul_one] using h)
    exact hx.trans (mul_comm x e)
  · rintro ⟨y, rfl⟩
    calc
      e * y * (1 - e) = (e - e * e) * y := by ring
      _ = 0 := by rw [he.eq, sub_self, zero_mul]

end SerrePositivity

end IdempotentAnnihilatorPart

section IdempotentImageAnnihilatorPart

namespace SerrePositivity
variable {R : Type u} [CommRing R]

/-- R/Jでの像が冪等なら、正の冪IᵉとJはIを含む。 -/
theorem ideal_le_pow_sup_of_quotient_image_idempotent (I J : Ideal R) (e : ℕ) (he : 0 < e)
    (hI : IsIdempotentElem (I.map (Ideal.Quotient.mk J))) : I ≤ I ^ e ⊔ J := by
  have hp : (I ^ e).map (Ideal.Quotient.mk J) = I.map (Ideal.Quotient.mk J) := by
    rw [Ideal.map_pow, hI.pow_eq (by omega)]
  have h : I.map (Ideal.Quotient.mk J) ≤ (I ^ e).map (Ideal.Quotient.mk J) := hp.ge
  have hc := Ideal.map_le_iff_le_comap.mp h
  simpa only [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
    ← RingHom.ker_eq_comap_bot, Ideal.mk_ker] using hc

/-- IᵉとJが一つの元を消すとき、R/Jでの像の冪等性によりIもその元を消す。 -/
theorem smul_eq_zero_of_ideal_pow_and_quotient_image_idempotent
    {M : Type v} [AddCommGroup M] [Module R M] (I J : Ideal R)
    (e : ℕ) (he : 0 < e) (hI : IsIdempotentElem (I.map (Ideal.Quotient.mk J)))
    (x : M) (hpow : ∀ r ∈ I ^ e, r • x = 0) (hJ : ∀ r ∈ J, r • x = 0)
    (r : R) (hr : r ∈ I) : r • x = 0 := by
  let L : Ideal R := (LinearMap.toSpanSingleton R M x).ker
  have hp : I ^ e ≤ L := fun r hr ↦ hpow r hr
  have hJL : J ≤ L := fun r hr ↦ hJ r hr
  exact (ideal_le_pow_sup_of_quotient_image_idempotent I J e he hI).trans
    (sup_le hp hJL) hr

/-- 各mod aⁿで像が冪等なIについて、a冪ねじれ加群上のIᵉ零化をI零化へ戻す。
元ごとのねじれ指数だけを使い、加群全体の一様なa指数は要求しない。 -/
theorem ideal_annihilates_of_pow_annihilates_and_powerTorsion
    {M : Type v} [AddCommGroup M] [Module R M] (I : Ideal R) (a : R)
    (hI : ∀ n : ℕ, 0 < n → IsIdempotentElem (I.map (Ideal.Quotient.mk (Ideal.span {a ^ n}))))
    (e : ℕ) (he : 0 < e) (hpow : ∀ r ∈ I ^ e, ∀ x : M, r • x = 0)
    (htorsion : ∀ x : M, ∃ n : ℕ, a ^ n • x = 0) : ∀ r ∈ I, ∀ x : M, r • x = 0 := by
  intro r hr x
  obtain ⟨n, hn⟩ := htorsion x
  have hn' : a ^ (n + 1) • x = 0 := by rw [pow_succ', mul_smul, hn, smul_zero]
  let L : Ideal R := (LinearMap.toSpanSingleton R M x).ker
  have hJL : Ideal.span {a ^ (n + 1)} ≤ L :=
    (Ideal.span_singleton_le_iff_mem L).mpr hn'
  exact smul_eq_zero_of_ideal_pow_and_quotient_image_idempotent I _ e he
    (hI (n + 1) (by omega)) x (fun s hs ↦ hpow s hs x) (fun s hs ↦ hJL hs) r hr

end SerrePositivity

end IdempotentImageAnnihilatorPart

section IdempotentImageBaseChangePart

namespace SerrePositivity
variable {S : Type u} {C : Type v} [CommRing S] [CommRing C]

/-- Mapping an ideal preserves its idempotence, without a surjectivity assumption. -/
lemma ideal_map_isIdempotent (φ : S →+* C) (I : Ideal S) (hI : IsIdempotentElem I) :
    IsIdempotentElem (I.map φ) := by
  exact hI.map (Ideal.mapHom φ)

/-- Quotient-image idempotence transports along any compatible quotient map. -/
lemma quotient_image_idempotent_baseChange (φ : S →+* C) (I J : Ideal S) (K : Ideal C)
    (hJK : J ≤ K.comap φ)
    (hI : IsIdempotentElem (I.map (Ideal.Quotient.mk J))) :
    IsIdempotentElem ((I.map φ).map (Ideal.Quotient.mk K)) := by
  let ψ := Ideal.quotientMap (I := J) K φ hJK
  have h := ideal_map_isIdempotent ψ (I.map (Ideal.Quotient.mk J)) hI
  have heq : (I.map φ).map (Ideal.Quotient.mk K) =
      (I.map (Ideal.Quotient.mk J)).map ψ := by
    rw [Ideal.map_map, Ideal.map_map]
    congr 1
  rw [heq]
  exact h

/-- In particular, images modulo corresponding scalar powers remain idempotent. -/
lemma quotient_power_image_idempotent_baseChange (φ : S →+* C) (I : Ideal S) (a : S) (n : ℕ)
    (hI : IsIdempotentElem (I.map (Ideal.Quotient.mk (Ideal.span {a ^ n})))) :
    IsIdempotentElem ((I.map φ).map (Ideal.Quotient.mk (Ideal.span {φ a ^ n}))) := by
  apply quotient_image_idempotent_baseChange φ I (Ideal.span {a ^ n}) _ _ hI
  rw [Ideal.span_singleton_le_iff_mem]
  change φ (a ^ n) ∈ Ideal.span {φ a ^ n}
  rw [map_pow]
  exact Ideal.subset_span (Set.mem_singleton _)

/-- The entire positive-power family of idempotence hypotheses transports unchanged. -/
lemma quotient_power_images_idempotent_baseChange (φ : S →+* C) (I : Ideal S) (a : S)
    (hI : ∀ n : ℕ, 0 < n →
      IsIdempotentElem (I.map (Ideal.Quotient.mk (Ideal.span {a ^ n})))) :
    ∀ n : ℕ, 0 < n →
      IsIdempotentElem ((I.map φ).map (Ideal.Quotient.mk (Ideal.span {φ a ^ n}))) :=
  fun n hn => quotient_power_image_idempotent_baseChange φ I a n (hI n hn)

end SerrePositivity

end IdempotentImageBaseChangePart

section ProductIdempotentQuotientPart

namespace SerrePositivity

/-- The mapped kernel is the principal ideal of the original mapped complementary idempotent. -/
theorem map_ker_pi_eval_eq_span
    {ι : Type v} (A : ι → Type u) [∀ i, CommRing (A i)] [DecidableEq ι]
    {C : Type w} [CommRing C] (f : ((i : ι) → A i) →+* C) (i : ι) :
    (RingHom.ker (Pi.evalRingHom A i)).map f = Ideal.span {1 - f (Pi.single i (1 : A i))} := by
  rw [RingHom.ker_evalRingHom, Ideal.map_span, Set.image_singleton, map_sub, map_one]

/-- Every original map from a finite product decomposes its target by the mapped projection kernels.
The original target need not be reduced; the empty product is included. -/
theorem pi_mapped_projection_quotients_bijective
    {ι : Type v} [Finite ι] (A : ι → Type u) [∀ i, CommRing (A i)]
    {C : Type w} [CommRing C] (f : ((i : ι) → A i) →+* C) :
    Function.Bijective (RingHom.pi (fun i =>
      Ideal.Quotient.mk ((RingHom.ker (Pi.evalRingHom A i)).map f))) := by
  classical
  letI := Fintype.ofFinite ι
  let J : ι → Ideal C := fun i => (RingHom.ker (Pi.evalRingHom A i)).map f
  have hJ : J = fun i => Ideal.span {1 - f (Pi.single i (1 : A i))} :=
    funext (fun i => map_ker_pi_eval_eq_span A f i)
  change Function.Bijective (RingHom.pi (fun i => Ideal.Quotient.mk (J i)))
  rw [hJ]
  exact ((CompleteOrthogonalIdempotents.single A).map f).bijective_pi

end SerrePositivity

end ProductIdempotentQuotientPart
