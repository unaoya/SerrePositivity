module

public import SerrePositivity.KTheory.G0.Basic
public import SerrePositivity.CommutativeAlgebra.Length.Basic
public import SerrePositivity.CommutativeAlgebra.SupportDimension
public import SerrePositivity.KTheory.G0.Functoriality
public import SerrePositivity.HomologicalAlgebra.ModuleBaseChangeTensor
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.LinearAlgebra.TensorProduct.Quotient
public import SerrePositivity.KTheory.G0.SemilocalSupport

/-! # 極大イデアルに台を持つ G₀ と長さ

## 概要

閉点（極大イデアル）に台を持つ有限長加群の G₀ を剰余類で表し、長さが G₀ から ℤ への同型を与えること（局所的な長さの評価も含む）、最小の高さでの局所化での長さの座標を与える。

## 方針

有限長加群は剰余体の組成列を持つので、長さで類を測る。

## 規約

Adams の MaximalSupportModules・MaximalLengthEquiv（最小の高さでの局所化）もここに置く（計画の KT1 と KT2 の表の両方に挙がっていた）。

## 使われ方

KTheory/Adams の純粋な重みの議論、交点重複度。
-/

@[expose] public noncomputable section

universe u

section MaximalSupportModulesPart

set_option backward.isDefEq.respectTransparency false
namespace SerrePositivity
open CategoryTheory
namespace Adams
variable {R : Type u} [CommRing R]
variable (W : TopologicalSpace.Closeds (PrimeSpectrum R))

/-- The simple residue module at a maximal point of the chosen support. -/
def supportedResidueModule (p : PrimeSpectrum R) (hm : p.asIdeal.IsMaximal) (hp : p ∈ W) :
    SupportedFGModuleOn W :=
  ⟨ModuleCat.of R (R ⧸ p.asIdeal), by
    refine ⟨inferInstance, ?_⟩
    intro q hq
    have hle : p.asIdeal ≤ q.asIdeal := by
      simpa only [Ideal.annihilator_quotient] using Module.annihilator_le_of_mem_support hq
    have he : p = q := PrimeSpectrum.ext (hm.eq_of_le q.isPrime.ne_top hle)
    rw [← he]
    exact hp⟩

/-- Every simple supported module is one of the residue modules in the support. -/
lemma simple_supported_iso_residue (M : SupportedFGModuleOn W) [IsSimpleModule R M.obj] :
    ∃ (p : PrimeSpectrum R) (hm : p.asIdeal.IsMaximal) (hp : p ∈ W),
      Nonempty (M.obj ≅ (supportedResidueModule W p hm hp).obj) := by
  obtain ⟨I, hm, ⟨e⟩⟩ := isSimpleModule_iff_quot_maximal.mp
    (inferInstance : IsSimpleModule R M.obj)
  let p : PrimeSpectrum R := ⟨I, hm.isPrime⟩
  have hann : Module.annihilator R M.obj = I := by
    rw [e.annihilator_eq, Ideal.annihilator_quotient]
  have hps : p ∈ Module.support R M.obj :=
    Module.mem_support_iff_of_finite.mpr hann.le
  exact ⟨p, hm, M.property.2 hps, ⟨e.toModuleIso⟩⟩

variable [IsNoetherianRing R]

lemma finiteLength_of_maximal_support
    (hw : ∀ p ∈ W, p.asIdeal.IsMaximal) (M : SupportedFGModuleOn W) :
    IsFiniteLength R M.obj :=
  isFiniteLength_of_support_isMaximal M.obj (fun p hp => hw p (M.property.2 hp))

/-- The subgroup generated by the residue classes in a closed support. -/
def residueClassSubgroup : AddSubgroup (G0WithSupport W) :=
  AddSubgroup.closure {x | ∃ (p : PrimeSpectrum R) (hm : p.asIdeal.IsMaximal) (hp : p ∈ W),
    x = G0WithSupport.mk (supportedResidueModule W p hm hp)}

omit [IsNoetherianRing R] in
lemma simple_mk_mem_residueClassSubgroup (M : SupportedFGModuleOn W)
    [IsSimpleModule R M.obj] : G0WithSupport.mk M ∈ residueClassSubgroup W := by
  obtain ⟨p, hm, hp, ⟨e⟩⟩ := simple_supported_iso_residue W M
  exact AddSubgroup.subset_closure ⟨p, hm, hp, G0WithSupport.mk_iso e⟩

/-- Composition-length induction expresses every finite-length class in the residue subgroup. -/
lemma finiteLength_mk_mem_residueClassSubgroup (M : Type u) [AddCommGroup M] [Module R M]
    (hM : finiteModuleSupportedOn W (ModuleCat.of R M)) (hl : IsFiniteLength R M) :
    G0WithSupport.mk (⟨ModuleCat.of R M, hM⟩ : SupportedFGModuleOn W) ∈
      residueClassSubgroup W := by
  induction hl with
  | of_subsingleton =>
    rw [G0WithSupport.mk_of_subsingleton]
    exact (residueClassSubgroup W).zero_mem
  | @of_simple_quotient M _ _ N hs hN ih =>
    let T : SupportedModuleShortExact W :=
      { left := ⟨ModuleCat.of R N, hM.submodule N⟩
        middle := ⟨ModuleCat.of R M, hM⟩
        right := ⟨ModuleCat.of R (M ⧸ N), hM.quotient N⟩
        f := N.subtype
        g := N.mkQ
        injective := N.subtype_injective
        exact := LinearMap.exact_subtype_mkQ N
        surjective := N.mkQ_surjective }
    change G0WithSupport.mk T.middle ∈ residueClassSubgroup W
    rw [G0WithSupport.mk_shortExact T]
    exact (residueClassSubgroup W).add_mem (ih (hM.submodule N))
      (simple_mk_mem_residueClassSubgroup W T.right)

lemma mk_mem_residueClassSubgroup (hw : ∀ p ∈ W, p.asIdeal.IsMaximal)
    (M : SupportedFGModuleOn W) : G0WithSupport.mk M ∈ residueClassSubgroup W :=
  finiteLength_mk_mem_residueClassSubgroup W M.obj M.property
    (finiteLength_of_maximal_support W hw M)

/-- Additive evaluations on maximal support are determined by residue classes. -/
lemma residue_hom_ext (hw : ∀ p ∈ W, p.asIdeal.IsMaximal)
    {A : Type*} [AddCommGroup A] {f g : G0WithSupport W →+ A}
    (h : ∀ (p : PrimeSpectrum R) (hm : p.asIdeal.IsMaximal) (hp : p ∈ W),
      f (G0WithSupport.mk (supportedResidueModule W p hm hp)) =
        g (G0WithSupport.mk (supportedResidueModule W p hm hp))) : f = g := by
  have hk : residueClassSubgroup W ≤ (f - g).ker := by
    rw [residueClassSubgroup, AddSubgroup.closure_le]
    rintro _ ⟨p, hm, hp, rfl⟩
    exact sub_eq_zero.mpr (h p hm hp)
  apply G0WithSupport.hom_ext
  intro M
  exact sub_eq_zero.mp (hk (mk_mem_residueClassSubgroup W hw M))

end Adams
end SerrePositivity

end MaximalSupportModulesPart

section MaximalSupportLengthPart

set_option backward.isDefEq.respectTransparency false
namespace SerrePositivity
open CategoryTheory Limits IsLocalRing
variable (R : Type u) [CommRing R] [IsNoetherianRing R] [IsLocalRing R]

/-- A finite module supported at the maximal ideal has finite length. -/
lemma maximalSupportedModule_finiteLength
    (M : SupportedFGModuleOn (supportZeroLocus (maximalIdeal R))) : IsFiniteLength R M.obj := by
  have := M.property.1
  have hs := M.property.2
  change Module.support R M.obj ⊆ PrimeSpectrum.zeroLocus (maximalIdeal R) at hs
  rw [Module.support_eq_zeroLocus, PrimeSpectrum.zeroLocus_subset_zeroLocus_iff] at hs
  let := Ideal.Quotient.field (maximalIdeal R)
  exact isFiniteLength_of_le_radical_annihilator (maximalIdeal R) M.obj hs

/-- Length, as a group homomorphism on modules supported at the maximal ideal. -/
def maximalSupportLengthMap : G0WithSupport (supportZeroLocus (maximalIdeal R)) →+ ℤ :=
  G0WithSupport.lift (fun M => ((Module.length R M.obj).toNat : ℤ))
    (fun e => congrArg (fun n : ℕ∞ => (n.toNat : ℤ)) e.toLinearEquiv.length_eq)
    (fun E => by
      exact_mod_cast lengthNat_add_of_exact E.f E.g E.injective E.surjective E.exact
        (maximalSupportedModule_finiteLength R E.middle))

@[simp] lemma maximalSupportLengthMap_mk
    (M : SupportedFGModuleOn (supportZeroLocus (maximalIdeal R))) :
    maximalSupportLengthMap R (G0WithSupport.mk M) = ((Module.length R M.obj).toNat : ℤ) := by
  simp [maximalSupportLengthMap]

end SerrePositivity

end MaximalSupportLengthPart

section MaximalSupportLocalLengthPart

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
namespace SerrePositivity
open CategoryTheory IsLocalRing TensorProduct
namespace Adams
variable {R : Type u} [CommRing R]
variable (W : TopologicalSpace.Closeds (PrimeSpectrum R))
variable (hw : ∀ p ∈ W, p.asIdeal.IsMaximal)

include hw in
/-- Localization of maximal support is supported at the maximal ideal of the local ring. -/
lemma maximalSupport_pullback_le (p : PrimeSpectrum R) :
    supportPullback (algebraMap R (Localization.AtPrime p.asIdeal)) W ≤
      supportZeroLocus (maximalIdeal (Localization.AtPrime p.asIdeal)) := by
  let T := Localization.AtPrime p.asIdeal
  intro q hq
  let r := PrimeSpectrum.comap (algebraMap R T) q
  have hle : r.asIdeal ≤ p.asIdeal := by
    calc
      _ ≤ (maximalIdeal T).under R := Ideal.comap_mono (le_maximalIdeal q.isPrime.ne_top)
      _ = _ := IsLocalization.AtPrime.under_maximalIdeal T p.asIdeal
  have he : r.asIdeal = p.asIdeal := (hw r hq).eq_of_le p.isPrime.ne_top hle
  have hc : (maximalIdeal T).under R = q.asIdeal.under R :=
    (IsLocalization.AtPrime.under_maximalIdeal T p.asIdeal).trans he.symm
  have heq : maximalIdeal T = q.asIdeal :=
    (IsLocalization.orderEmbedding p.asIdeal.primeCompl T).injective hc
  exact heq.le

variable [IsNoetherianRing R]

/-- The integer length at one prime, defined by flat localization and the existing length map. -/
def localLengthMap (p : PrimeSpectrum R) : G0WithSupport W →+ ℤ :=
  (maximalSupportLengthMap (Localization.AtPrime p.asIdeal)).comp
    (G0WithSupport.map (algebraMap R (Localization.AtPrime p.asIdeal))
      (by rw [RingHom.flat_algebraMap_iff]; exact IsLocalization.flat _ p.asIdeal.primeCompl)
      W (supportZeroLocus (maximalIdeal (Localization.AtPrime p.asIdeal)))
      (maximalSupport_pullback_le W hw p))

lemma localLengthMap_mk (p : PrimeSpectrum R) (M : SupportedFGModuleOn W) :
    localLengthMap W hw p (G0WithSupport.mk M) =
      ((Module.length (Localization.AtPrime p.asIdeal)
        ((ModuleCat.extendScalars
          (algebraMap R (Localization.AtPrime p.asIdeal))).obj M.obj)).toNat :
        ℤ) := by
  simp only [localLengthMap, AddMonoidHom.comp_apply, G0WithSupport.map_mk,
    maximalSupportLengthMap_mk]

lemma localLengthMap_residue_self (p : PrimeSpectrum R) (hm : p.asIdeal.IsMaximal)
    (hp : p ∈ W) :
    localLengthMap W hw p (G0WithSupport.mk (supportedResidueModule W p hm hp)) = 1 := by
  rw [localLengthMap_mk]
  let T := Localization.AtPrime p.asIdeal
  have : IsSimpleModule T (T ⧸ maximalIdeal T) :=
    isSimpleModule_iff_isCoatom.mpr (maximalIdeal.isMaximal T).out
  rw [(moduleCatBaseChangeTensorEquiv (R := R) (B := T)
    (supportedResidueModule W p hm hp).obj).length_eq]
  change ((Module.length T (T ⊗[R] (R ⧸ p.asIdeal))).toNat : ℤ) = 1
  rw [← (p.asIdeal.quotMapEquivTensorQuot T).length_eq,
    IsLocalization.AtPrime.map_eq_maximalIdeal p.asIdeal T, Module.length_eq_one]
  rfl

lemma localLengthMap_residue_ne (p q : PrimeSpectrum R) (hm : q.asIdeal.IsMaximal)
    (hq : q ∈ W) (hne : p ≠ q) :
    localLengthMap W hw p (G0WithSupport.mk (supportedResidueModule W q hm hq)) = 0 := by
  rw [localLengthMap_mk]
  let T := Localization.AtPrime p.asIdeal
  have hnot : ¬ q.asIdeal ≤ p.asIdeal := by
    intro hle
    exact hne (PrimeSpectrum.ext (hm.eq_of_le p.isPrime.ne_top hle)).symm
  obtain ⟨s, hs, hsp⟩ := Set.not_subset.mp hnot
  have ht : q.asIdeal.map (algebraMap R T) = ⊤ :=
    Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ hs)
      (IsLocalization.map_units (M := p.asIdeal.primeCompl) T ⟨s, hsp⟩)
  rw [(moduleCatBaseChangeTensorEquiv (R := R) (B := T)
    (supportedResidueModule W q hm hq).obj).length_eq]
  change ((Module.length T (T ⊗[R] (R ⧸ q.asIdeal))).toNat : ℤ) = 0
  rw [← (q.asIdeal.quotMapEquivTensorQuot T).length_eq, ht]
  simp only [Module.length_eq_zero, ENat.toNat_zero, Nat.cast_zero]

open Classical in
lemma localLengthMap_residue (p q : PrimeSpectrum R) (hm : q.asIdeal.IsMaximal)
    (hq : q ∈ W) :
    localLengthMap W hw p (G0WithSupport.mk (supportedResidueModule W q hm hq)) =
      if p = q then 1 else 0 := by
  classical
  by_cases he : p = q
  · subst q
    rw [localLengthMap_residue_self, ite_eq_left rfl]
  · rw [localLengthMap_residue_ne W hw p q hm hq he, ite_eq_right he]

/-- Simultaneous local length evaluation at all points of the maximal support. -/
def maximalLengthEvaluation : G0WithSupport W →+ ({p : PrimeSpectrum R // p ∈ W} → ℤ) where
  toFun x p := localLengthMap W hw p.val x
  map_zero' := by funext p; exact (localLengthMap W hw p.val).map_zero
  map_add' x y := by funext p; exact (localLengthMap W hw p.val).map_add x y

@[simp]
lemma maximalLengthEvaluation_apply (x : G0WithSupport W) (p : {p : PrimeSpectrum R // p ∈ W}) :
    maximalLengthEvaluation W hw x p = localLengthMap W hw p.val x := rfl

end Adams
end SerrePositivity

end MaximalSupportLocalLengthPart

section MaximalSupportLengthEquivPart

set_option backward.isDefEq.respectTransparency false
namespace SerrePositivity
namespace Adams
variable {R : Type u} [CommRing R] [IsNoetherianRing R]
variable (W : TopologicalSpace.Closeds (PrimeSpectrum R))
variable (hw : ∀ p ∈ W, p.asIdeal.IsMaximal)
variable [Fintype {p : PrimeSpectrum R // p ∈ W}]

def residueLinearCombination : ({p : PrimeSpectrum R // p ∈ W} → ℤ) →+ G0WithSupport W where
  toFun z := ∑ p, z p •
    G0WithSupport.mk (supportedResidueModule W p.val (hw p.val p.property) p.property)
  map_zero' := by simp
  map_add' z z' := by simp only [Pi.add_apply, add_zsmul, Finset.sum_add_distrib]

omit [Fintype {p : PrimeSpectrum R // p ∈ W}] in
open Classical in
lemma maximalLengthEvaluation_residue (p : {p : PrimeSpectrum R // p ∈ W}) :
    maximalLengthEvaluation W hw
        (G0WithSupport.mk (supportedResidueModule W p.val (hw p.val p.property) p.property)) =
      Pi.single p 1 := by
  funext q
  rw [maximalLengthEvaluation_apply, localLengthMap_residue]
  simp only [Pi.single_apply]
  by_cases he : p = q
  · subst q
    simp
  · have hv : q.val ≠ p.val := fun h => he (Subtype.ext h.symm)
    simp [hv, Ne.symm he]

omit [IsNoetherianRing R] in
open Classical in
@[simp]
lemma residueLinearCombination_single (p : {p : PrimeSpectrum R // p ∈ W}) :
    residueLinearCombination W hw (Pi.single p 1) =
      G0WithSupport.mk (supportedResidueModule W p.val (hw p.val p.property) p.property) := by
  simp [residueLinearCombination, Pi.single_apply]

lemma residueLinearCombination_evaluation (x : G0WithSupport W) :
    residueLinearCombination W hw (maximalLengthEvaluation W hw x) = x := by
  classical
  have he : (residueLinearCombination W hw).comp (maximalLengthEvaluation W hw) =
      AddMonoidHom.id (G0WithSupport W) := by
    apply residue_hom_ext W hw
    intro p hm hp
    change residueLinearCombination W hw
      (maximalLengthEvaluation W hw (G0WithSupport.mk (supportedResidueModule W p hm hp))) = _
    rw [maximalLengthEvaluation_residue W hw ⟨p, hp⟩, residueLinearCombination_single]
    rfl
  exact DFunLike.congr_fun he x

lemma maximalLengthEvaluation_combination (z : {p : PrimeSpectrum R // p ∈ W} → ℤ) :
    maximalLengthEvaluation W hw (residueLinearCombination W hw z) = z := by
  classical
  funext q
  change localLengthMap W hw q.val
    (∑ p, z p • G0WithSupport.mk
      (supportedResidueModule W p.val (hw p.val p.property) p.property)) = z q
  rw [map_sum]
  simp only [map_zsmul, localLengthMap_residue]
  simp

/-- A supported module's local lengths give the coordinates in the residue basis. -/
def maximalLengthEquiv : G0WithSupport W ≃+ ({p : PrimeSpectrum R // p ∈ W} → ℤ) where
  toFun := maximalLengthEvaluation W hw
  invFun := residueLinearCombination W hw
  left_inv := residueLinearCombination_evaluation W hw
  right_inv := maximalLengthEvaluation_combination W hw
  map_add' := (maximalLengthEvaluation W hw).map_add

lemma eq_sum_localLengthMap (x : G0WithSupport W) :
    x = ∑ p : {p : PrimeSpectrum R // p ∈ W}, localLengthMap W hw p.val x •
      G0WithSupport.mk (supportedResidueModule W p.val (hw p.val p.property) p.property) :=
  (residueLinearCombination_evaluation W hw x).symm

end Adams
end SerrePositivity

end MaximalSupportLengthEquivPart

section MaximalSupportModulesPart

set_option backward.isDefEq.respectTransparency false
namespace SerrePositivity
namespace Adams
variable {R : Type u} [CommRing R] [IsNoetherianRing R]
variable {B : Type u} [CommRing B] [Algebra R B]
variable {Z : TopologicalSpace.Closeds (PrimeSpectrum R)} {c : ℕ}
variable [IsLocalization (heightStratumComplement Z c) B]

/-- The support identified by least-height localization consists of finite-length modules. -/
lemma HeightAtLeast.localized_module_finiteLength (h : HeightAtLeast Z c)
    (M : SupportedFGModuleOn (supportPullback (algebraMap R B) Z)) :
    IsFiniteLength B M.obj := by
  let := IsLocalization.isNoetherianRing (heightStratumComplement Z c) B
    (inferInstance : IsNoetherianRing R)
  exact finiteLength_of_maximal_support _
    (fun p hp => (h.mem_pullback_iff_isMaximal p).mp hp) M

end Adams
end SerrePositivity

end MaximalSupportModulesPart

section MaximalLengthEquivPart

set_option backward.isDefEq.respectTransparency false
namespace SerrePositivity
namespace Adams
variable {R : Type u} [CommRing R] [IsNoetherianRing R]
variable {B : Type u} [CommRing B] [Algebra R B]
variable {Z : TopologicalSpace.Closeds (PrimeSpectrum R)} {c : ℕ}
variable [IsLocalization (heightStratumComplement Z c) B]

/-- The least-height localization admits the local-length coordinate isomorphism. -/
def HeightAtLeast.semilocalLengthEquiv (h : HeightAtLeast Z c) :
    G0WithSupport (supportPullback (algebraMap R B) Z) ≃+
      ({q : PrimeSpectrum B // q ∈ supportPullback (algebraMap R B) Z} → ℤ) := by
  let := IsLocalization.isNoetherianRing (heightStratumComplement Z c) B
    (inferInstance : IsNoetherianRing R)
  have hf : (supportPullback (algebraMap R B) Z : Set (PrimeSpectrum B)).Finite :=
    h.finite_localized_maximal_points.subset
      (fun q hq => (h.mem_pullback_iff_isMax q).mp hq)
  letI := hf.fintype
  exact maximalLengthEquiv _ (fun q hq => (h.mem_pullback_iff_isMaximal q).mp hq)

end Adams
end SerrePositivity

end MaximalLengthEquivPart
