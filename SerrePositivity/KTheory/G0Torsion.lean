module
public import SerrePositivity.KTheory.G0Functoriality

/-! # The subgroup generated by localization-torsion modules

The reverse containment in the localization kernel is the lattice theorem S3.
-/
@[expose] public section
noncomputable section
set_option backward.isDefEq.respectTransparency false
universe u
namespace SerrePositivity
open scoped TensorProduct
variable {R : Type u} [CommRing R]

/-- Every element is killed by an element of the multiplicative set. -/
def IsModuleSTorsion (P : Submonoid R) (M : Type u) [AddCommGroup M] [Module R M] : Prop :=
  ∀ m : M, ∃ r ∈ P, r • m = 0

namespace IsModuleSTorsion
variable {P : Submonoid R} {M N L : Type u}
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  [AddCommGroup L] [Module R L]

lemma iff_localized_zero : IsModuleSTorsion P M ↔ Subsingleton (LocalizedModule P M) :=
  LocalizedModule.subsingleton_iff.symm

lemma of_injective (f : M →ₗ[R] N) (hf : Function.Injective f)
    (h : IsModuleSTorsion P N) : IsModuleSTorsion P M := by
  intro m
  obtain ⟨r, hr, he⟩ := h (f m)
  exact ⟨r, hr, hf (by simpa using he)⟩

lemma of_surjective (g : M →ₗ[R] N) (hg : Function.Surjective g)
    (h : IsModuleSTorsion P M) : IsModuleSTorsion P N := by
  intro n
  obtain ⟨m, rfl⟩ := hg n
  obtain ⟨r, hr, he⟩ := h m
  exact ⟨r, hr, by simpa using congrArg g he⟩

lemma of_exact (f : M →ₗ[R] N) (g : N →ₗ[R] L) (he : Function.Exact f g)
    (hM : IsModuleSTorsion P M) (hL : IsModuleSTorsion P L) :
    IsModuleSTorsion P N := by
  intro n
  obtain ⟨r, hr, er⟩ := hL (g n)
  have hk : g (r • n) = 0 := by simpa using er
  obtain ⟨m, hm⟩ := (he (r • n)).mp hk
  obtain ⟨s, hs, es⟩ := hM m
  refine ⟨s * r, P.mul_mem hs hr, ?_⟩
  rw [mul_smul, ← hm, ← map_smul, es, map_zero]

lemma submodule (h : IsModuleSTorsion P M) (U : Submodule R M) :
    IsModuleSTorsion P U := of_injective U.subtype U.subtype_injective h

lemma quotient (h : IsModuleSTorsion P M) (U : Submodule R M) :
    IsModuleSTorsion P (M ⧸ U) := of_surjective U.mkQ U.mkQ_surjective h

lemma of_subsingleton [Subsingleton M] : IsModuleSTorsion P M :=
  fun _ => ⟨1, P.one_mem, Subsingleton.elim _ _⟩

lemma of_zero_mem (h : (0 : R) ∈ P) : IsModuleSTorsion P M :=
  fun m => ⟨0, h, zero_smul R m⟩

/-- Torsion is equivalent to the tensor model of localization being zero. -/
lemma iff_tensor_zero (B : Type u) [CommRing B] [Algebra R B] [IsLocalization P B] :
    IsModuleSTorsion P M ↔ Subsingleton (B ⊗[R] M) :=
  (IsLocalizedModule.subsingleton_iff P (TensorProduct.mk R B M 1)).symm
end IsModuleSTorsion

variable (P : Submonoid R) (Z : TopologicalSpace.Closeds (PrimeSpectrum R))
/-- Classes of finite supported torsion modules generate the localization-torsion subgroup. -/
def localizationTorsionSubgroup : AddSubgroup (G0WithSupport Z) :=
  AddSubgroup.closure {x | ∃ M : SupportedFGModuleOn Z,
    IsModuleSTorsion P M.obj ∧ x = G0WithSupport.mk M}

lemma mk_mem_localizationTorsionSubgroup (M : SupportedFGModuleOn Z)
    (h : IsModuleSTorsion P M.obj) :
    G0WithSupport.mk M ∈ localizationTorsionSubgroup P Z :=
  AddSubgroup.subset_closure ⟨M, h, rfl⟩

namespace G0WithSupport
variable {P Z} {B : Type u} [CommRing B] [Algebra R B] [IsLocalization P B]

lemma localize_mk_eq_zero (W : TopologicalSpace.Closeds (PrimeSpectrum B))
    (hW : supportPullback (algebraMap R B) Z ≤ W)
    (M : SupportedFGModuleOn Z) (hM : IsModuleSTorsion P M.obj) :
    localize P Z W hW (mk M) = 0 := by
  rw [localize_mk]
  have ht : Subsingleton (B ⊗[R] M.obj) := (IsModuleSTorsion.iff_tensor_zero B).mp hM
  have : Subsingleton (M.baseChange (algebraMap R B) Z W hW).obj := by
    have he : Module.compHom B (algebraMap R B) = (inferInstance : Module R B) := by
      apply Module.ext'
      intro r b
      exact algebraMap_smul B r b
    simpa +instances only [SupportedFGModuleOn.baseChange, ModuleCat.extendScalars,
      ModuleCat.ExtendScalars.obj', ModuleCat.restrictScalars,
      ModuleCat.RestrictScalars.obj', ModuleCat.of, he] using ht
  exact mk_of_subsingleton _

/-- All torsion relations vanish after localization; S3 will prove equality. -/
lemma localizationTorsionSubgroup_le_ker
    (W : TopologicalSpace.Closeds (PrimeSpectrum B))
    (hW : supportPullback (algebraMap R B) Z ≤ W) :
    localizationTorsionSubgroup P Z ≤ (localize P Z W hW).ker := by
  rw [localizationTorsionSubgroup, AddSubgroup.closure_le]
  rintro x ⟨M, hM, rfl⟩
  exact localize_mk_eq_zero W hW M hM
end G0WithSupport
end SerrePositivity
