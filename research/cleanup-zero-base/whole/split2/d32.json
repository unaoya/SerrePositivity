{
 "key": "d32",
 "concept": "C 単体集合と ∞ 圏/ファイブレーションと straightening",
 "subconcepts": [
  {
   "name": "cartesian・cocartesian 辺とファイブレーション",
   "description": "p-(co)cartesian 辺（外側ホーンの充填）と (co)cartesian ファイブレーションの類。cocartesian な辺のなす coslice、cocartesian 辺を保つ射、可逆辺の終点指定の持ち上げ条件も含む",
   "reference": "Kerodon §5.1.4（Tag 01U9）"
  },
  {
   "name": "cocartesian ファイブレーションの分類（Cat∞ 値）",
   "description": "cocartesian ファイブレーションの ∞ 圏、底変換の ∞ 関手、strict transport 図式（準圏値の strict な図式）の圏と ∞ 圏、Cat∞ 値の straightening 写像とその Hom への作用",
   "reference": ""
  },
  {
   "name": "straightening（空間値）",
   "description": "左（右）ファイブレーションから空間値の coherent 図式を作る分類写像：通常の圏の神経の上の候補（strict transport との比較 span）、任意の底への降下（全単体の切断の添字圏を含む）、復元と底変換",
   "reference": "Kerodon 5.6（Tag 027M）"
  },
  {
   "name": "strict な Kan 値図式の ∞ 圏",
   "description": "通常の圏の上の strict な Kan 値（準圏値）図式の単体的圏と coherent 神経、対象での評価・対角評価の豊穣関手、Kan 複体の反転",
   "reference": "Kerodon Corollary 5.6.0.6（Tag 028T）、§5.6（Tag 027M）"
  },
  {
   "name": "unstraightening",
   "description": "空間値図式の unstraightening（普遍左ファイブレーションの引き戻し）、小さい模型、ファイバーの同型、底の射と変換による全空間の射、写像空間への作用、定値図式の場合",
   "reference": "Kerodon Corollary 5.6.0.6（Tag 028T）、Remark 5.6.2.18（Tag 0271）、Example 5.6.2.19"
  },
  {
   "name": "ファイバーと共変輸送",
   "description": "頂点上のファイバー、ファイバーの間の誘導射、引き戻しのファイバーの同型、辺に沿う輸送関手とそのパラメーター付きの形",
   "reference": "Kerodon Definition 5.2.2.4、Theorem 5.2.4.1（Tag 024N）、5.2（Tag 019A）"
  },
  {
   "name": "左ファイブレーションの ∞ 圏",
   "description": "固定した底の上の小さい左ファイブレーションの単体的圏とその coherent 神経（頂点・辺・底変換）、底の上の対象全体への包含、右ファイブレーションの反転",
   "reference": "Kerodon Corollary 5.6.0.6（Tag 028T）"
  },
  {
   "name": "左・右ファイブレーションと anodyne 射",
   "description": "左・右ファイブレーション、自明 Kan ファイブレーション、左・右 anodyne 射の類。始対象を持つ左ファイブレーションのファイバーと底の写像空間の比較（共変表現可能関手）も含む",
   "reference": ""
  },
  {
   "name": "相対関手空間と cocartesian 切断",
   "description": "底の上の相対関手空間 Fun_{/B} の評価・引き戻し・底変換、cocartesian 辺（指定した辺）を保つ部分複体、cocartesian 切断とその包含",
   "reference": "Kerodon §5.3.1（Tag 035D）、§5.6.2（Tag 026H）"
  },
  {
   "name": "輸送表現（witness と prism）",
   "description": "左ファイブレーションの輸送表現：可換四角形の空間とその射影・制限、表現である条件、表現の制限、境界制限のための prism 持ち上げ空間",
   "reference": "Kerodon §5.6.8（Tag 02S9）、Lemma 5.6.8.10（Tag 02SK）"
  },
  {
   "name": "通常の圏の上のファイブレーション（weighted nerve と strict transport）",
