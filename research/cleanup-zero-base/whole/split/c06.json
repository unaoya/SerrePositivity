{
 "key": "c06",
 "concept": "C 単体集合と ∞ 圏/極限と余極限",
 "subconcepts": [
  {
   "name": "錐・余錐と極限・余極限",
   "description": "join による錐・余錐、その頂点・脚・制限、極限錐（slice の終対象）・余極限余錐、極限の存在、有限極限・小余積・sifted 余極限の保存",
   "reference": "HTT §1.2.13、Kerodon §7.1（Tag 02H1）"
  },
  {
   "name": "始対象・終対象と相対余極限",
   "description": "境界充填による始対象・終対象、射に関する相対始対象と U 余極限余錐",
   "reference": "HTT 1.2.12.3、Kerodon 4.6.7・§7.1.5–7.1.6（Tag 02WE）"
  },
  {
   "name": "引き戻し・押し出しの四角形",
   "description": "正方形 Δ¹×Δ¹ の辺・三角形、span/cospan への制限、錐・余錐としての表示、引き戻し・押し出し四角形",
   "reference": "HTT §1.2.13、Kerodon §7.6.2"
  },
  {
   "name": "Kan 拡張",
   "description": "点ごとの左・右 Kan 拡張（slice の引き戻し上の極限・余極限）、指定自然変換に沿う輸送、相対 join による表示、h Fun での普遍性、相対左 Kan 拡張",
   "reference": "Kerodon §7.3（Tag 02Y9、02YC）"
  },
  {
   "name": "余錐の空間と余極限の関手性",
   "description": "終点固定の余錐の空間（coslice の fiber）、余錐の族、部分図式への制限と付加、選んだ余極限の関手、定値関手、関手 ∞ 圏の点ごとの極限",
   "reference": "Kerodon §7.1.4・§7.1.8（Tag 02X8）"
  },
  {
   "name": "重み付き切断と Bousfield–Kan のホモトピー極限",
   "description": "重み付きの end（単体的自然変換の空間）と coend、Bousfield–Kan の重み N(I/i)、strict な錐・極限からの比較、weighted nerve の切断",
   "reference": "Kerodon §7.5.1・7.5.4（Tag 03A0、03B6）"
  },
  {
   "name": "strict な図式・通常の圏の極限との比較",
   "description": "通常の圏の錐と nerve の錐の対応、strict な図式から coherent nerve の図式・錐、表現可能な図式の比較射、比較射のホモトピーファイバー",
   "reference": "HTT 4.2.4.1、Kerodon 7.5.4.6（Tag 03BB）"
  },
  {
   "name": "ホモトピー引き戻し・押し出しと塔の極限（単体集合）",
   "description": "単体集合の四角形のホモトピー引き戻し性、二重写像円筒、ファイブレーションの塔の極限",
   "reference": "Segal 1974 Prop. 1.6・Lemma 1.7、Kerodon §3.4"
  },
  {
   "name": "空間値の図式の極限と切断空間",
   "description": "射の切断の単体集合、coherent な錐の切断模型（coslice の引き戻し）、right fibration の fiber と写像空間の比較、底上の図式の切断の coherent な実現",
   "reference": "Kerodon §7.4.1（Tag 05QS）"
  },
  {
   "name": "simplicial replacement と strict な自然変換の空間",
   "description": "通常の圏上の単体集合値図式の simplicial replacement（ホモトピー余極限の模型）と、strict な自然変換の単体集合",
   "reference": "Kerodon 5.3.2.1（Tag 035V）、5.6.0.6（Tag 028T）"
  },
  {
   "name": "複体の strict な図式とその ∞ 局所化",
   "description": "Δ・Δᵒᵖ で添字づけた複体の strict 図式、objectwise 擬同型による ∞ 局所化、Reedy の解像による写像空間、dg 加群の strict 図式から dg 神経の図式",
   "reference": "HTT 4.2.4.4（加群版）、Hovey §5.2・5.4"
  },
  {
   "name": "（補助）極限・Kan 拡張の証明の足場",
   "description": "次数を区切った錐のデータ、h Fun の Hom の輸送、二単体の path の同定、pushout-product の角、単体の反転",
   "reference": ""
  }
 ],
