{
 "key": "c09",
 "concept": "H K 理論/局所化不変量：Postnikov と平方零拡大",
 "subconcepts": [
  {
   "name": "dg 代数の胞体分解",
   "description": "dg 代数の胞体的な解消（cell 源の End 代数）、その増大射・関手性・有限段・反復",
   "reference": ""
  },
  {
   "name": "path 対象と dg 代数のホモトピー",
   "description": "dg 代数の path 代数（矢印圏の End）、端点、ホモトピーの証人、mapping path、相対 path、非正次数版、path に沿う底変更",
   "reference": ""
  },
  {
   "name": "ホモトピー引き戻しの模型",
   "description": "mapping path を使った dg 代数のホモトピー引き戻しの模型とその射影・塔、相対版、拡大の底変更（通常の引き戻し）",
   "reference": ""
  },
  {
   "name": "Postnikov 塔と層",
   "description": "非正次数 dg 代数、切断 τ≥-n による Postnikov 段と商・遷移・関手性、核と層、層の双加群構造、連結性、ホモロジー群",
   "reference": "LT §2（Postnikov 塔）"
  },
  {
   "name": "平方零拡大と導分",
   "description": "分裂平方零拡大 A ⊕ M の dg 代数、射影・零切断・導分、導分で捻った cone 代数、相対的な証人（path の持ち上げ）、類による拡大の模型と係数の変更",
   "reference": "LT §2"
  },
  {
   "name": "Postnikov 段の平方零拡大としての表示（類）",
   "description": "Postnikov の隣接段を層の双加群による平方零拡大として表す類（cell 解消からの導分）、その自然性・因子分解、像拡大を通る因子分解",
   "reference": "LT Lemma 2.30"
  },
  {
   "name": "dg 代数の写像空間と準同型の局所化",
   "description": "余モノイドとの畳み込み代数、AW による乗法的な単体的 frame と写像の単体集合、準同型を反転した dg 代数の ∞ 圏と関手的 frame",
   "reference": ""
  },
  {
   "name": "dg 代数上の局所化不変量の値と k 連結性",
   "description": "dg 代数に Perf を経て不変量のスペクトルを対応させる関手、塔への適用、k-connective な局所化不変量の条件",
   "reference": "LT Def. 2.5"
  },
  {
   "name": "塔の pro 同値と逆 roof",
   "description": "dg 代数の塔の射を pro の意味で逆にする roof（次数全射準同型を分母とする span）、その細分、有限切断の対角や零底の塔での pro 逆",
   "reference": "LT §2（pro 同値の議論）"
  },
  {
   "name": "（補助）Postnikov 帰納の共通核",
   "description": "任意の切断次数の下段 roof 上で、層の制限・右係数・類の遷移・零の貼り合わせを組む足場（PostnikovCommonCore とその二切断版）",
   "reference": ""
  },
  {
   "name": "（補助）後続段の類の逆データ",
   "description": "下段の逆から次の段の類の模型（源・標的・像・相対模型）とその逆を選ぶデータ（Successor と n=1 の Two）",
   "reference": ""
  }
 ],
