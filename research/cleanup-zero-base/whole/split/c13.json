{
 "key": "c13",
 "concept": "E モデル圏/ホモトピー関数複体と分解",
 "subconcepts": [
  {
   "name": "余単体的分解と frame",
   "description": "モデル圏の対象の余単体的分解（cofibrant resolution）、外側の frame つきの分解、それらの圏、frame の族と対角",
   "reference": "Hirschhorn 16.1・16.6；Hovey 5.2"
  },
  {
   "name": "ホモトピー関数複体（導来写像空間）",
   "description": "分解・置換から作る写像の単体集合、源と標的を同時に分解した写像空間、置換の取り方によらないこと、局所化の Hom との比較",
   "reference": "Hirschhorn 17.1–17.4；Dwyer–Kan Function complexes §4"
  },
  {
   "name": "実現と単体集合によるテンソル",
   "description": "余単体対象の実現（Hom の左随伴）、有限・非特異な単体集合や部分複体によるテンソル、標準単体の表示による Hom",
   "reference": "Hirschhorn 16.3；Hovey 5.4"
  },
  {
   "name": "持ち上げの空間",
   "description": "分解の間の射の持ち上げ全体の単体集合（自明 fibration の fiber）、厳密な持ち上げの組、Kan 標的への作用、全ての底の射を添字とする小さい図式",
   "reference": "Hirschhorn 16.1.5・17.5 に対応"
  },
  {
   "name": "（補助）持ち上げの選択の整合化",
   "description": "持ち上げの選択を前合成・後合成・混合の正方形や立方体で比べ、区間族で整合させる構成（証明の足場、中断した一般化の分類 B）",
   "reference": ""
  },
  {
   "name": "分解の bar 構成",
   "description": "分解の圏上の bar 構成で写像空間を両変数の関手にする構成、その評価・錐・行の図式、小さい Kan 値への商と retract",
   "reference": ""
  },
  {
   "name": "（補助）bar の厳密化：選択の圏と自由図式の延長",
   "description": "bar の作用を厳密な図式にするための選択の圏、自由な図式の延長、語による対角の Hom と augmentation（証明の足場、中断した一般化の分類 B）",
   "reference": ""
  },
  {
   "name": "余モナドの分解と自由な道の圏",
   "description": "余モナドの反復冪による単体的分解と augmentation、自由な道の圏の余モナド、生成元の各次数の圏と面・退化",
   "reference": "Dwyer–Kan Simplicial localizations §2（自由単体的分解）"
  },
  {
   "name": "frame の Hom と hammock 局所化の比較",
   "description": "frame による Hom と hammock 局所化の Hom を結ぶ中間図式、屋根の標的と slice、Thomason 比較、Ex∞ による Kan 値化",
   "reference": "Dwyer–Kan Function complexes §4；Thomason（Grothendieck 構成のホモトピー余極限）"
  }
 ],
