{
 "key": "c20",
 "concept": "C 単体集合と ∞ 圏/写像空間",
 "subconcepts": [
  {
   "name": "右 pinched 写像空間",
   "description": "先頭面が x に定値で最終頂点が y の単体による写像空間 Hom^R、添字の延長、関手性、slice の fiber との同型、頂点と辺の対応、hX の射による前合成・後合成",
   "reference": "Kerodon §4.6.5（Tag 01KW）、HTT §1.2.2"
  },
  {
   "name": "左 pinched 写像空間と coslice の fiber",
   "description": "反転による左 pinched 模型 Hom^L と、coslice 射影の fiber としての座標表示",
   "reference": "Kerodon §4.6.5"
  },
  {
   "name": "両端固定の区間模型",
   "description": "Fun(Δ¹,X) の境界上の fiber としての写像空間 Hom_X(x,y)、curry/uncurry、頂点と辺の対応、後合成、関手 ∞ 圏の区間 Hom の底に沿う制限",
   "reference": "Kerodon §4.6.1（Tag 01J3）"
  },
  {
   "name": "写像空間の模型の比較",
   "description": "pinched 模型・coslice fiber から区間模型への比較射と、そのための prism から join への射",
   "reference": "Kerodon §4.6.5（Tag 01KW）"
  },
  {
   "name": "dg 神経の写像空間（線形模型）",
   "description": "dg 圏の二対象間の右 pinched 写像空間、線形削除方程式の解としての単体、Hom 複体の鎖写像からの写像、加群構造、合成",
   "reference": "HA Construction 1.3.1.6、Kerodon §4.6.5"
  },
  {
   "name": "coherent 神経の写像空間（豊穣 Hom との比較）",
   "description": "単体的圏の豊穣 Hom から coherent 神経の pinched 写像空間・coslice fiber への比較射と、そのための path・ホーンの解像の組合せ論",
   "reference": "HA 1.3.1.17、Kerodon §4.6.7–4.6.8（Tag 01LW）"
  },
  {
   "name": "合成（合成三角形の空間）",
   "description": "第二辺を固定した合成三角形全体の空間、第一辺・対角への射影、Kan 複体での合成の証人",
   "reference": "Kerodon §4.6.9"
  },
  {
   "name": "錐の関手空間と太い slice",
   "description": "関手単体集合の fiber で表した錐の空間、頂点固定・両端固定の版、fat join による太い slice、join の slice との比較",
   "reference": "Kerodon §4.6.4（Tag 01KW 付近）、HTT §4.2.1"
  },
  {
   "name": "矢印の空間と lax 引き戻し",
   "description": "Fun(Δ¹,C) の両端評価、lax 引き戻し（oriented fiber product）と射影、同値部分、F(x)→y の矢印の空間と随伴の比較",
   "reference": "Tamme（lax pullback）、Kerodon §4.6.4"
  },
  {
   "name": "（補助）写像空間の比較の足場",
   "description": "内部 Hom の二変数の交換、円柱上の四角形の空間、ULift と反転の交換、join の頂点区間の包含",
   "reference": ""
  }
 ],
