{
 "key": "c14",
 "concept": "C 単体集合と ∞ 圏/dg 神経",
 "subconcepts": [
  {
   "name": "dg 神経の単体と単体的構造",
   "description": "dg 圏の dg 神経の定義：頂点と斉次射の族、符号付きの方程式、単調写像による引き戻し",
   "reference": "HA Construction 1.3.1.6（Kerodon 2.5.3）"
  },
  {
   "name": "（補助）単体の方程式の分解",
   "description": "方程式の右辺を線形部分（内部点の削除）と二次部分（切断での合成）に分ける補助、残差",
   "reference": "HA Construction 1.3.1.6"
  },
  {
   "name": "低次元の単体（頂点・辺・三角形）",
   "description": "0・1・2 単体の記述（対象、閉次数零射、ホモトピー）、二次切断、通常の神経からの包含、複体の場合の辺と chain map",
   "reference": "HA Example 1.3.1.8"
  },
  {
   "name": "dg 関手と dg 自然変換の作用",
   "description": "dg 関手が誘導する dg 神経の写像、厳密 dg 自然変換が与える単体的ホモトピー、dg 神経への図式の頂点",
   "reference": "HA Construction 1.3.1.6・Proposition 1.3.1.20 周辺"
  },
  {
   "name": "ホーンの充填（dg 神経は ∞ 圏）",
   "description": "ホーンから既知成分を回収し未知の二成分を解いて充填する構成、選んだ面の和",
   "reference": "HA Proposition 1.3.1.10"
  },
  {
   "name": "複体の標準 fiber と引き戻し四角形",
   "description": "複体の dg 神経での射の標準 fiber（mapping cone の −1 シフト）、cospan の標準引き戻し四角形と錐",
   "reference": "HTT §1.2.13、HA Example 1.3.1.8"
  },
  {
   "name": "（補助）fiber 四角形の普遍性の境界充填",
   "description": "標準 fiber 四角形が極限であることの証明で使う cospan セルの添字、零データ、未知成分の候補と残差",
   "reference": "HTT §1.2.13、HA Proposition 1.3.1.10"
  },
  {
   "name": "Dold–Kan の Hom 空間（標準模型）",
   "description": "Hom 複体の非正切断の Dold–Kan 単体的加群とその明示的な標準模型（方程式の解、正規化、Moore 核）",
   "reference": "HA Construction 1.3.1.13・Remark 1.3.1.12、KST Appendix A"
  },
  {
   "name": "Alexander–Whitney 合成",
   "description": "標準模型の上の Alexander–Whitney 合成・単位・定数単体、シャッフルの面、対の普遍単体集合",
   "reference": "KST Construction A.5"
  },
  {
   "name": "coherent 神経との比較",
   "description": "Dold–Kan で単体的に豊穣化した dg 圏の coherent 神経から dg 神経への比較写像、pinched Hom との同型",
   "reference": "HA Proposition 1.3.1.17"
  },
  {
   "name": "（補助）立方体・旗・Path の評価",
   "description": "比較写像の構成に使う立方体の最大旗、座標面、Path の内部点、最上位成分の評価",
   "reference": "HA Proposition 1.3.1.17 の証明"
  },
  {
   "name": "dg 圏のテンソルと dg 神経",
   "description": "二つの dg 神経の単体からテンソル dg 圏の単体データを作る構成と、その切断項・符号・切断積、宇宙を揃えた関手性",
   "reference": ""
  }
 ],
