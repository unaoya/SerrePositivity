{
 "key": "c21",
 "concept": "D 安定 ∞ 圏と導来 ∞ 圏/安定 ∞ 圏",
 "subconcepts": [
  {
   "name": "零対象と零角の四角形（点付き ∞ 圏）",
   "description": "零対象、零角を持つ四角形（HA の三角形）、fiber／cofiber 四角形と fiber／cofiber 列、零始点の辺",
   "reference": "HA §1.1.1（Definition 1.1.1.1–1.1.1.6）"
  },
  {
   "name": "安定 ∞ 圏の定義と安定 ∞ 圏の ∞ 圏",
   "description": "安定性の条件、小さい安定 quasicategory、安定 ∞ 圏と完全関手のなす ∞ 圏、零の安定圏",
   "reference": "HA Definition 1.1.1.9、§1.1.4"
  },
  {
   "name": "完全関手",
   "description": "零対象と cofiber を保つ関手、完全関手の ∞ 圏とその頂点",
   "reference": "HA §1.1.4"
  },
  {
   "name": "suspension と loop",
   "description": "suspension／loop 四角形、loop 図式の ∞ 圏と評価、ホモトピー圏上の Σ、シフトとの交換同型",
   "reference": "HA §1.1.2"
  },
  {
   "name": "cofiber 列とホモトピー圏の三角構造",
   "description": "cofiber 関手（cofiber 四角形の族）、接続射、三角形、回転・合成・八面体の長方形",
   "reference": "HA §1.1.2（Theorem 1.1.2.14）"
  },
  {
   "name": "安定性の判定（excision の比較格子）",
   "description": "pullback と pushout の一致から安定性を導く証明：比較格子の添字、穿孔 core の錐、押し出しの貼り合わせ、余錐空間の loop 模型",
   "reference": "HA 1.4.2.15 と記載（Proposition 1.1.3.4 周辺）"
  },
  {
   "name": "安定部分圏の閉包と半直交分解",
   "description": "零・同型・cofiber／fiber で生成される安定な頂点条件、ホモトピー圏での閉包、二項半直交分解",
   "reference": "HA §1.1.3、Lemma 1.1.3.3 周辺"
  },
  {
   "name": "複体の dg 神経での cofiber 四角形",
   "description": "鎖写像の標準 cofiber 列を与える零角付き四角形と、その普遍性の境界充填の候補・残差（c14 の標準 fiber の双対）",
   "reference": "HA §1.3.2（Proposition 1.3.2.10）"
  },
  {
   "name": "（補助）四角形の辺・対角とホモトピー圏への読み替え",
   "description": "四角形の角と四辺の取り出し、ホモトピー類、短複体、枠のホモトピー、対角、列として一定な四角形",
   "reference": ""
  }
 ],
