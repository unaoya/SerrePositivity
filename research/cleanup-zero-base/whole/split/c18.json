{
 "key": "c18",
 "concept": "D 安定 ∞ 圏と導来 ∞ 圏/dg の貼り合わせ",
 "subconcepts": [
  {
   "name": "dg 貼り合わせ圏（対象と Hom 複体）",
   "description": "双加群に沿う dg 圏の貼り合わせ：対象（二成分と閉元）、比較ホモトピーを含む Hom 複体、左右の射影と作用、後合成",
   "reference": "Kuznetsov–Lunts の gluing、Land–Tamme の lax 引き戻しの dg 模型"
  },
  {
   "name": "comma 表示と代表加群",
   "description": "貼り合わせを加群の comma（代表加群と augmentation、kernel 表示、恒等 comma）として読む dg 関手と Hom の鎖同型",
   "reference": ""
  },
  {
   "name": "貼り合わせの cone とシフト",
   "description": "貼り合わせの中の cone・シフト対象の構成、正方形からの cone／cocone の写像、鎖の円柱（前三角性のため）",
   "reference": ""
  },
  {
   "name": "因子の部分圏と引き戻し部分圏",
   "description": "片方の成分が H⁰ で零の充満 dg 部分圏（C 因子・D 因子）、augmentation が可逆な対象の充満部分圏（引き戻し）",
   "reference": "半直交分解"
  },
  {
   "name": "Milnor 四角形",
   "description": "dg 代数の四角形の Milnor 条件、自由対象の End と fiber の同定、分解後の商",
   "reference": ""
  },
  {
   "name": "安定 ∞ 圏としての貼り合わせと lax 引き戻しとの比較",
   "description": "dg 神経を取った貼り合わせを安定圏に束ね、導来加群 ∞ 圏への二脚と ∞ 圏の lax 引き戻しへの比較を作る（宇宙の調整を含む）",
   "reference": "Land–Tamme（lax pullback）"
  },
  {
   "name": "（補助）lax 写像空間の比較：合成対応と入力 fiber",
   "description": "Hom 複体と lax 引き戻しの写像空間の比較に使う合成対応、入力付き fiber、対角 path、係数の作用の三角形",
   "reference": ""
  },
  {
   "name": "（補助）単位補正・正規化の三角形と cube の族",
   "description": "比較の証明で使う単位 cap・collar の再添字、六三角形図式、正規化 cube、prism の単体族、宇宙持ち上げの族",
   "reference": ""
  }
 ],
