{
 "key": "c00",
 "concept": "C 単体集合と ∞ 圏/ファイブレーションと straightening",
 "subconcepts": [
  {
   "name": "左・右ファイブレーションと anodyne 射",
   "description": "左・右ファイブレーション、自明 Kan ファイブレーション、左・右 anodyne 射の類。始対象を持つ左ファイブレーションのファイバーと共変表現可能関手も含む",
   "reference": "HTT §2.1.2, §2.1.4；Kerodon §4.2, §5.6.6"
  },
  {
   "name": "ファイバーと共変輸送",
   "description": "頂点上のファイバー、ファイバーの間の誘導射、辺に沿う輸送関手とそのパラメーター付きの形",
   "reference": "Kerodon §4.6.5 (Tag 01KX), §5.2.2 (Tag 01VC)"
  },
  {
   "name": "cartesian・cocartesian 辺とファイブレーション",
   "description": "p-(co)cartesian 辺（外側ホーンの充填）と (co)cartesian ファイブレーションの類",
   "reference": "Kerodon §5.1.1, Def 5.1.4.1 (Tag 01UA)；HTT §2.4"
  },
  {
   "name": "相対関手空間と cocartesian 切断",
   "description": "底の上の相対関手空間 Fun_{/B} の前合成・後合成・合成、cocartesian 辺を保つ部分、cocartesian 切断",
   "reference": "Kerodon §5.3.1 (Tag 035J)"
  },
  {
   "name": "通常の圏の上のファイブレーション（weighted nerve と strict transport）",
   "description": "圏 C の神経の上で、単体集合値関手の weighted nerve と、ファイブレーションの strict transport 図式（taut scaffold を含む）",
   "reference": "Kerodon §5.3.1, §5.3.3 (Def 5.3.3.1, Tag 025X), §5.3.5"
  },
  {
   "name": "左ファイブレーションの ∞ 圏",
   "description": "固定した底の上の小さい左ファイブレーションの単体的圏とその coherent 神経、相対 Hom による評価・ファイバー評価",
   "reference": "Kerodon Cor 5.6.0.6 (Tag 028T)"
  },
  {
   "name": "straightening（空間値）",
   "description": "左（右）ファイブレーションから空間値の coherent 図式を作る分類写像：通常の圏の神経の上の候補、任意の底への降下（全単体の切断の添字圏を含む）、復元と底変換",
   "reference": "Kerodon §5.6, Cor 5.6.0.6 (Tag 028T)；HTT §2.2, §3.2"
  },
  {
   "name": "unstraightening",
   "description": "空間値図式の unstraightening（普遍左ファイブレーションの引き戻し）、小さい模型、写像空間への作用、右版（前層）",
   "reference": "Kerodon Ex 5.6.2.9 (Tag 026S), Cor 5.6.0.6；§8.3（前層）"
  },
  {
   "name": "輸送表現（witness と prism）",
   "description": "左ファイブレーションの輸送表現：可換四角形の空間、witness の空間とその底変換、境界制限のための prism 持ち上げ空間",
   "reference": "Kerodon §5.6.5, §5.6.8 (Tag 02S9)"
  },
  {
   "name": "strict な Kan 値図式の ∞ 圏",
   "description": "通常の圏の上の strict な Kan 値（準圏値）図式の単体的圏と coherent 図式としての実現、edgewise 解像による Hom の置き換え",
   "reference": "Kerodon Cor 5.6.0.6 (Tag 028T), §8.1.1 (Tag 03JF)"
  },
  {
   "name": "cocartesian ファイブレーションの分類（Cat∞ 値）",
   "description": "cocartesian ファイブレーションの ∞ 圏、底変換の ∞ 関手、strict transport 図式の ∞ 圏、Cat∞ 値の straightening 写像",
   "reference": "Kerodon §5.6, §5.7；HTT §3.2"
  },
  {
   "name": "（補助）cocartesian 分類の Hom 比較",
   "description": "Cat∞ 値 straightening の充満忠実性の証明の足場：底変換した native な Hom の core、境界・scaffold・二単体への制限の比較、Hom の輸送と自然性同型",
   "reference": ""
  }
