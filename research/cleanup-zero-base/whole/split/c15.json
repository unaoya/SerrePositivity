{
 "key": "c15",
 "concept": "C 単体集合と ∞ 圏/Kan 複体とホモトピー群",
 "subconcepts": [
  {
   "name": "ホモトピー群と基本亜群",
   "description": "Kan 複体の π_n（境界定数単体のホモトピー類）、誘導写像、π₀ との比較、同型不変性、π_* 同型の条件、基本亜群",
   "reference": "Kerodon §3.2（Goerss–Jardine I §7）"
  },
  {
   "name": "Kan ファイブレーションの長完全列と lim¹",
   "description": "射の fiber、連結写像、境界の持ち上げ、球面的な境界と交代和、群の塔の lim¹",
   "reference": "Kerodon §3.2.5–3.2.6、Goerss–Jardine I §7・VI §2"
  },
  {
   "name": "弱ホモトピー同値と可縮 Kan 複体",
   "description": "弱ホモトピー同値、弱可縮性、可縮 Kan 複体（境界充填）、単体的ホモトピー同値",
   "reference": "Kerodon §3.1.6・§3.2.7"
  },
  {
   "name": "単体的ホモトピーと prism",
   "description": "単体的ホモトピー、prism Δⁿ×Δ¹ の端点、正方形 Δ¹×Δ¹ の二つの三角形、関手単体集合の辺とホモトピー",
   "reference": "Kerodon §3.1.5"
  },
  {
   "name": "Ex∞ と Kan 置換",
   "description": "Ex の反復の余極限 Ex∞、単位、Moss の pairing と複雑度、ホーンセル付加の可算反復による Kan 置換",
   "reference": "Kerodon §3.3、Moss 2020 §3"
  },
  {
   "name": "Kan 値の図式と空間の ∞ 圏への写像",
   "description": "Kan 複体の圏の忘却、Kan 値（豊穣）図式とその比較・実現、coherent 神経を通した 𝒮 への写像、離散空間",
   "reference": "Kerodon §5.5（𝒮 の定義）"
  },
  {
   "name": "単体集合のホモトピー圏（Mathlib）",
   "description": "Mathlib の SSet.HomotopyCategory・2 切断・hoFunctor についての補題（本体の定義なし）",
   "reference": ""
  },
  {
   "name": "（補助）Kan 複体の中の合成三角形と四面体",
   "description": "合成の菱形、合成三重の四面体、三辺の輸送、直積の交換菱形、三角形の本、合成列とその精密化",
   "reference": "BF 1978 の比較の足場"
  },
  {
   "name": "（補助）単体的豊穣圏の円柱",
   "description": "順序付きの段を持つ豊穣円柱、パラメータ付き円柱の Hom、一点豊穣圏",
   "reference": ""
  },
  {
   "name": "（補助）単体集合の図式と充填の道具",
   "description": "離散族の直和、図式の商とテンソル、関数複体、ホーン制限、底つきの内ホーンの pushout など特定の証明の足場",
   "reference": "Goerss–Jardine I §7・VIII §2（関数複体）"
  }
 ],
