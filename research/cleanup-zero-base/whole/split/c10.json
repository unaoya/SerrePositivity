{
 "key": "c10",
 "concept": "C 単体集合と ∞ 圏/結とスライス",
 "subconcepts": [
  {
   "name": "結の構成",
   "description": "単体集合の join の直接構成（切断ごとの直和、空単体を補った単体、単体作用）、左右の包含、射への作用",
   "reference": "HTT §1.2.8；Kerodon §4.3.3 (Tag 016K)"
  },
  {
   "name": "結の計算（標準単体・部分複体・結合・反転）",
   "description": "標準単体の join、部分複体の join とその和、結合同型、反転、区間への射影、対角、直積との比較、錐の頂点と脚",
   "reference": "HTT §1.2.8, Lemma 2.1.2.3；Kerodon §4.3.3, §4.3.6"
  },
  {
   "name": "スライスと余スライス",
   "description": "図式 p の slice X_{/p}・coslice X_{p/}、射影、join との随伴（curry／uncurry）、前合成の制限と後合成",
   "reference": "HTT §1.2.9, §2.1.2；Kerodon §4.3.5 (Tag 016Y)"
  },
  {
   "name": "相対 coslice と coslice の辺の族",
   "description": "相対 coslice 制限の標的（引き戻しの角）、slice の corner、辺に沿う coslice の切断・前合成・比較の円柱、twisted arrow や外ホーンへの比較",
   "reference": "HTT Prop 2.1.2.1；Kerodon §4.3.6, Prop 5.1.1.14 (Tag 01TF)"
  },
  {
   "name": "fat join と結の比較",
   "description": "fat join（二段の pushout）、包含と関手性、通常の join への比較射、両端図式",
   "reference": "Kerodon §4.6.2 (Tag 01HM), §4.6.6 (Tag 04HY)；HTT §4.2.1"
  },
  {
   "name": "relative join",
   "description": "共通の底を持つ二つの単体集合の relative join、包含と射影、写像円柱との比較、prism の最大単体によるフィルター",
   "reference": "Kerodon §5.2.3–5.2.4 (Tag 0241 付近), Lemma 3.1.2.1"
  },
  {
   "name": "（補助）頂点と順序写像",
   "description": "標準単体・境界の頂点の包含、始点を加える順序写像、空単体を補った神経の評価（join と神経の錐の計算の足場）",
   "reference": "HTT §1.2.8"
  }
 ],
