{
 "key": "c16",
 "concept": "C 単体集合と ∞ 圏/関手単体集合と同値",
 "subconcepts": [
  {
   "name": "関手単体集合の頂点・評価・転置",
   "description": "射と関手単体集合 Fun(X,Y) の頂点の対応、頂点での評価、二変数の内部 Hom の交換・転置",
   "reference": "Kerodon §1.5.3、§4.5"
  },
  {
   "name": "自然変換と可逆二胞体（h Fun）",
   "description": "関手単体集合のホモトピー圏の射 FunctorHom と同型 FunctorIso、前合成・後合成・成分・curry、単体的ホモトピーとの対応、関手正方形",
   "reference": "Kerodon §4.5.1"
  },
  {
   "name": "同型と ∞ 圏の同値",
   "description": "頂点の同型、辺の可逆性、quasicategory の同値（逆データつき・性質）、前合成による同値の判定",
   "reference": "HTT §1.2.4、Kerodon §4.5.1（Tag 01DE）"
  },
  {
   "name": "充満忠実と本質的全射",
   "description": "写像空間による充満忠実性、頂点の同型による本質的全射性",
   "reference": "Kerodon §4.6.2"
  },
  {
   "name": "core（最大部分 Kan 複体）",
   "description": "全ての辺が可逆な単体のなす部分複体とその関手性",
   "reference": "Kerodon §4.4.3"
  },
  {
   "name": "可逆 path の空間と path 置換",
   "description": "可逆な辺のなす path の単体集合 Isom(Y)、端点評価、定値 path、関手の path 置換（isofibration への置換）、相対 path、可逆三角形",
   "reference": "Kerodon §4.5.3"
  },
  {
   "name": "∞ 圏のホモトピー引き戻し",
   "description": "path 置換を使った二関手の引き戻し（Cat∞ の引き戻しの模型）と射影",
   "reference": "Kerodon §4.5.2"
  },
  {
   "name": "相対関手空間と延長の空間",
   "description": "底の図式に厳密に重なる関手の単体集合 Fun_{/B}(A,E)、その curry/uncurry、部分図式を固定した延長の空間",
   "reference": "Kerodon §4.1.4・§4.5"
  },
  {
   "name": "fiber ごとの関手の全空間",
   "description": "底の単体ごとに逆像上の図式を並べた全空間（fiberwise Hom）、射影、curry、前合成",
   "reference": ""
  },
  {
   "name": "可逆な区間と円柱",
   "description": "codiscrete な二点圏の nerve（可逆区間）、その円柱と写像円柱、区間の境界上の図式、prism の反転",
   "reference": "Kerodon §4.5.3・§4.6.2"
  }
