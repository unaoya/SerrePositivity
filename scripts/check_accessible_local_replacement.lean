import SerrePositivity.HomotopicalAlgebra.Localization.AccessibleLocalReplacement
import Lean.Util.CollectAxioms

noncomputable section
universe w v u vJ uJ
open CategoryTheory CategoryTheory.Limits HomotopicalAlgebra
open SerrePositivity.Bousfield SerrePositivity.Reedy

-- The closed-class Reedy theorem does not assume a model structure with W or accessibility of W.
example {J₀ : Type uJ} [Category.{vJ} J₀] {inv dir : MorphismProperty J₀}
    [inv.IsMultiplicative] [dir.IsMultiplicative] (r : ReedyStructure inv dir ℕ)
    {C₀ : Type u} [Category.{v} C₀] [HasFiniteLimits C₀] [HasFiniteColimits C₀]
    [IsLocallyPresentable.{w} C₀]
    [∀ j, HasColimitsOfShape (LatchingIndex r j) C₀] [∀ j, Small.{w} (LatchingIndex r j)]
    {F G : J₀ ⥤ C₀} (a : F ⟶ G) (L W : MorphismProperty C₀)
    [W.HasTwoOutOfThreeProperty] [(L ⊓ W).IsMultiplicative]
    [(L ⊓ W).IsStableUnderRetracts] [(L ⊓ W).IsStableUnderCoproducts.{w}]
    [(L ⊓ W).IsStableUnderCobaseChange] [(L ⊓ W).IsStableUnderTransfiniteComposition.{w}] :
    reedyLeft r (L ⊓ W) a ↔ reedyLeft r L a ∧ ∀ j, W (a.app j) :=
  reedyLeft_inf_iff r a L W

variable {C : Type u} [Category.{v} C] [ModelCategory C] [IsLocallyPresentable.{w} C]
  (cof : MorphismProperty.FunctorialFactorizationData (cofibrations C) (trivialFibrations C))
  (fib : MorphismProperty.FunctorialFactorizationData (trivialCofibrations C) (fibrations C))
  (I J : MorphismProperty C) [SerrePositivity.InfinityCategories.HA.ModelCategoryComparison.CofibrantlyGenerated.{w} I J]
  [ModelCategory SSet.{w}]
  (IS JS : MorphismProperty SSet.{w}) [SerrePositivity.InfinityCategories.HA.ModelCategoryComparison.CofibrantlyGenerated.{w} IS JS]
  (hcof : cofibrations SSet.{w} = MorphismProperty.monomorphisms _)
  (hfib : fibrations SSet.{w} = SSet.modelCategoryQuillen.J.{w}.rlp)
  (hw : weakEquivalences SSet.{w} = SerrePositivity.SimplicialHomotopy.weakEquivalences)
  [ModelCategory SSet.{v}] [ModelCategory SSet.{max v w}]
  (hcofV : cofibrations SSet.{v} = MorphismProperty.monomorphisms _)
  (hfibV : fibrations SSet.{v} = SSet.modelCategoryQuillen.J.{v}.rlp)
  (hcofB : cofibrations SSet.{max v w} = MorphismProperty.monomorphisms _)
  (hfibB : fibrations SSet.{max v w} = SSet.modelCategoryQuillen.J.{max v w}.rlp)
  [(weakEquivalences C).IsStableUnderCobaseChangeAgainst (cofibrations C)]



-- Original S may have arbitrary arrows: no cofibrancy assumption on their endpoints or tractability.
example (S : MorphismProperty C) : LocalBoundaryGenerators.generators cof S ≤
    cofibrations C ⊓ localEquivalences.{v, u} (C := C) cof fib S :=
  localBoundaryGenerators_le_cof_local cof fib I J IS JS hcof hfib hw
    hcofV hfibV hcofB hfibB S

-- Any factorization generated by the constructed small class has a genuinely local-equivalent unit.
example (S : MorphismProperty C) [S.IsSmall.{w}]
    (d : MorphismProperty.FunctorialFactorizationData
      (LocalFibrantApproximation.generators J cof S).rlp.llp
      (LocalFibrantApproximation.generators J cof S).rlp) (X : C) :
    localEquivalences.{v, u} (C := C) cof fib S
      ((SerrePositivity.Smith.AccessibleFactorization.terminalComparison d).app X) :=
  localFibrant_approximation_unit_localEquivalence cof fib I J IS JS hcof hfib hw
    hcofV hfibV hcofB hfibB S d X

-- Actual R and η are outputs; local-equivalence of η is not an input or an oracle.
example (S : MorphismProperty C) [S.IsSmall.{w}] :
    ∃ (κ : Cardinal.{w}) (_ : Fact κ.IsRegular) (R : C ⥤ C) (η : 𝟭 C ⟶ R),
      R.IsCardinalAccessible κ ∧
      ∀ X, cofibrations C (η.app X) ∧
        localEquivalences.{v, u} (C := C) cof fib S (η.app X) ∧
        localFibrantObjects.{v, u} (C := C) cof fib S (R.obj X) :=
  exists_accessible_localReplacement cof fib I J IS JS hcof hfib hw hcofV hfibV hcofB hfibB S

example (S : MorphismProperty C) [S.IsSmall.{w}] :
    ∃ (κ : Cardinal.{w}) (_ : Fact κ.IsRegular),
      IsCardinalAccessibleCategory
        (SerrePositivity.Smith.arrowProperty
          (localEquivalences.{v, u} (C := C) cof fib S)).FullSubcategory κ ∧
      Functor.IsCardinalAccessible
        (SerrePositivity.Smith.arrowInclusion
          (localEquivalences.{v, u} (C := C) cof fib S)) κ :=
  exists_accessible_localEquivalences cof fib I J IS JS hcof hfib hw
    hcofV hfibV hcofB hfibB S

open Lean in
run_cmd do
  let env ← getEnv
  let expected := #[
    `SerrePositivity.HomotopicalAlgebra.Smith.ClosedGeneratedClass,
    `SerrePositivity.HomotopicalAlgebra.HomotopyFunctionComplex.Reedy.ClosedBoundaryClass,
    `SerrePositivity.HomotopicalAlgebra.HomotopyFunctionComplex.Reedy.ClosedObjectwise,
    `SerrePositivity.HomotopicalAlgebra.Localization.LocalBoundaryEquivalences,
    `SerrePositivity.HomotopicalAlgebra.Localization.AccessibleLocalReplacement]
  let mut count : Nat := 0
  let mut seen : Array Name := #[]
  for (name, _) in env.constants.toList do
    let some idx := env.getModuleIdxFor? name | continue
    let mod := env.header.modules[idx.toNat]!.module
    unless expected.contains mod do continue
    let axioms ← collectAxioms name
    unless axioms.all (#[``propext, ``Classical.choice, ``Quot.sound].contains ·) do
      throwError "Unexpected axioms in {name}: {axioms}"
    count := count + 1
    unless seen.contains mod do seen := seen.push mod
  for mod in expected do
    unless seen.contains mod do throwError "Module not audited: {mod}"
  logInfo m!"Accessible local replacement audit passed: {count} declarations in {seen.size} modules."
