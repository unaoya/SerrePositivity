-- 本レーンの各宣言（生成された宣言も含む）の推移的な公理依存を検査する。
open Lean in
set_option maxHeartbeats 0 in
run_cmd do
  let env ← getEnv
  let expected := #[`SerrePositivity.BhattScholze.Andre.OrdinaryMonicRoot,
    `SerrePositivity.BhattScholze.Andre.MonicRelation,
    `SerrePositivity.BhattScholze.Andre.DivisionPerfectoidCandidate,
    `SerrePositivity.BhattScholze.Andre.PolynomialPerfectoidCandidate,
    `SerrePositivity.BhattScholze.Andre.PerfectPrismMonicCandidate,
    `SerrePositivity.BhattScholze.Andre.PrincipalDPFree,
    `SerrePositivity.BhattScholze.Andre.MonicPDFlat,
    `SerrePositivity.BhattScholze.Andre.MonicRelationResidue,
    `SerrePositivity.BhattScholze.Andre.MonicRawPDivision,
    `SerrePositivity.BhattScholze.Andre.MonicFamilyPartialQuotient,
    `SerrePositivity.BhattScholze.Andre.MonicFamilySubsetRegular,
    `SerrePositivity.BhattScholze.Andre.MonicFamilyPowerResidue,
    `SerrePositivity.BhattScholze.Andre.MonicFamilyRawRegular,
    `SerrePositivity.BhattScholze.Andre.MonicFamilyQuotientUniversal,
    `SerrePositivity.BhattScholze.Andre.MonicFamilyOptionQuotient,
    `SerrePositivity.BhattScholze.Andre.MonicFamilyQuotientReindex,
    `SerrePositivity.BhattScholze.Andre.MonicFiniteFamilyFlat,
    `SerrePositivity.BhattScholze.Andre.MonicFamilyFiniteSystem,
    `SerrePositivity.BhattScholze.Andre.MonicFamilyColimit,
    `SerrePositivity.BhattScholze.Andre.MonicFamilyFaithfullyFlat,
    `SerrePositivity.BhattScholze.Andre.MonicFamilyCoefficientQuotient,
    `SerrePositivity.BhattScholze.Andre.MonicFrobeniusCoefficient,
    `SerrePositivity.BhattScholze.Andre.MonicRawModPFlat,
    `SerrePositivity.BhattScholze.Andre.MonicRawCompletelyFlat,
    `SerrePositivity.BhattScholze.Andre.MonicRawDerivedReduction,
    `SerrePositivity.BhattScholze.Andre.MonicRawPerfectionFlat,
    `SerrePositivity.BhattScholze.Andre.MonicRawPCompletionFlat,
    `SerrePositivity.BhattScholze.Andre.MonicPrismaticCoefficient,
    `SerrePositivity.BhattScholze.Andre.MonicPrismaticRawResidue]
  let mut seen : Array Name := #[]
  let mut count : Nat := 0
  for (name, _) in env.constants.toList do
    let some idx := env.getModuleIdxFor? name | continue
    let mod := env.header.modules[idx.toNat]!.module
    unless expected.contains mod do continue
    let axioms ← collectAxioms name
    unless axioms.all (#[``propext, ``Classical.choice, ``Quot.sound].contains ·) do
      throwError "Unexpected axioms in {name}: {axioms}"
    count := count + 1
    unless seen.contains mod do seen := seen.push mod
  unless seen.size == expected.size do
    throwError "Missing André monic root modules"
  logInfo m!"André monic root audit passed: {count} declarations, standard axioms only."
