import SerrePositivity.InfinityCategories.Project.Entrypoints.F2PresentableDualityAll
import Lean.Util.CollectAxioms

/-!
概要：P-d の所有する全宣言の再帰的公理依存を監査する。
方針：Duality 名前空間のモジュールから導入された宣言を列挙する。
規約：propext・Classical.choice・Quot.sound だけを許す。
使われ方：Duality.All のビルド後の独立監査。
-/

open Lean in
run_cmd do
  let oldAuditPrefix1 := `SerrePositivity.InfinityCategories.F2.Presentable.Duality
  let klw1AuditLayout1 ← IO.ofExcept <| Lean.Json.parse (← IO.FS.readFile "scripts/refactor/targets/kl-module-map.json")
  let klw1AuditLayout1 ← IO.ofExcept klw1AuditLayout1.getObj?
  let klw1AuditOwners1 := Std.HashSet.ofList (klw1AuditLayout1.toList.filterMap fun (source, dest) =>
    if oldAuditPrefix1.isPrefixOf source.toName then dest.getStr?.toOption.map String.toName else none)
  let env ← getEnv
  let mut count : Nat := 0
  for (name, _) in env.constants.toList do
    let some idx := env.getModuleIdxFor? name | continue
    let mod := env.header.modules[idx.toNat]!.module
    unless (oldAuditPrefix1.isPrefixOf mod || klw1AuditOwners1.contains mod || #[`SerrePositivity.InfinityCategories.Kerodon.TheHomotopyTheoryOfInfinityCategories.TruncatedObjectsAndHigherHomotopyCategories.InitialVerticesContractible].contains mod) do
      continue
    let axioms ← collectAxioms name
    unless axioms.all (#[``propext, ``Classical.choice, ``Quot.sound].contains ·) do
      throwError "Presentable duality: unexpected axioms in {name}: {axioms}"
    count := count + 1
  if count == 0 then throwError "Presentable duality: no declarations audited"
  logInfo m!"Presentable duality audit passed: {count} declarations, standard three axioms only."

