noncomputable section
universe u
open CategoryTheory CategoryTheory.Limits SerrePositivity SerrePositivity.DerivedCompletion
attribute [local instance] HasDerivedCategory.standard
variable {R : Type u} [CommRing R] (a : R) (C M : ModuleCat.{u} R)

-- The zero-power stage is the actual zero module, for every ring and test module.
example : IsZero (modulePowerReduction a M 0) := by
  apply ModuleCat.isZero_iff_subsingleton.mpr
  exact subsingleton_of_forall_eq 0 (fun x => by
    simpa only [pow_zero, one_smul] using modulePowerReduction_pow_smul_zero a M 0 x)

-- Even a non-finite, non-flat, non-complete module has the standard derived stage.
example (n : ℕ) :
    DerivedCategory.Q.obj (powerCokernelComplex a
      ((moduleTensorCochainFunctor (extRes (projectiveResolution C))).obj M) n) ≅
        (boundedAboveDerivedTensorModuleFunctor C).obj (modulePowerReduction a M n) :=
  modulePowerDerivedTensorIso a C M n

-- KL-A2d: standard Tor actions and the full power-torsion input at actual stages.
assert_no_sorry SerrePositivity.boundedAboveDerivedTensorModuleTorIso_naturality_left
assert_no_sorry SerrePositivity.DerivedCompletion.modulePowerCokernelTorIso
assert_no_sorry SerrePositivity.DerivedCompletion.modulePowerCokernelTorIso_transition
assert_no_sorry SerrePositivity.DerivedCompletion.modulePowerCokernelTorIso_naturality
assert_no_sorry SerrePositivity.DerivedCompletion.modulePowerCokernelTorIso_scalar_zero_iff
assert_no_sorry SerrePositivity.DerivedCompletion.modulePowerCokernel_scalar_zero_of_power_torsion_tests
