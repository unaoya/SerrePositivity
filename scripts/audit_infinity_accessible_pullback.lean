import SerrePositivity.InfinityCategories.Project.Entrypoints.F2PresentableAccessiblePullbackAll
import Lean.Util.CollectAxioms

/-!
概要：P-d の accessible 引き戻し所有宣言を再帰的に公理監査する。
方針：所有モジュールの宣言を列挙し、その全公理依存を検査する。
規約：propext・Classical.choice・Quot.sound だけを許す。
使われ方：AccessiblePullback.All のビルド後の専用監査。
-/

open Lean in
run_cmd do
  let oldAuditPrefix1 := `SerrePositivity.InfinityCategories.F2.Presentable.AccessiblePullback
  let klw1AuditLayout1 ← IO.ofExcept <| Lean.Json.parse (← IO.FS.readFile "scripts/refactor/targets/kl-module-map.json")
  let klw1AuditLayout1 ← IO.ofExcept klw1AuditLayout1.getObj?
  let klw1AuditOwners1 := Std.HashSet.ofList (klw1AuditLayout1.toList.filterMap fun (source, dest) =>
    if oldAuditPrefix1.isPrefixOf source.toName then dest.getStr?.toOption.map String.toName else none)
  let env ← getEnv
  let mut count : Nat := 0
  for (name, _) in env.constants.toList do
    let some idx := env.getModuleIdxFor? name | continue
    let mod := env.header.modules[idx.toNat]!.module
    unless (oldAuditPrefix1.isPrefixOf mod || klw1AuditOwners1.contains mod) do
      continue
    let axioms ← collectAxioms name
    unless axioms.all (#[``propext, ``Classical.choice, ``Quot.sound].contains ·) do
      throwError "Accessible pullback: unexpected axioms in {name}: {axioms}"
    count := count + 1
  if count == 0 then throwError "Accessible pullback: no declarations audited"
  logInfo m!"Accessible pullback audit passed: {count} declarations, standard three axioms only."

