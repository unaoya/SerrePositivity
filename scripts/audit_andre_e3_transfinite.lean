open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let expected := #[
    `SerrePositivity.BhattScholze.Andre.Transfinite.RootClosure,
    `SerrePositivity.BhattScholze.Andre.Transfinite.ResidueFrobenius,
    `SerrePositivity.BhattScholze.Andre.Transfinite.CountableDescent,
    `SerrePositivity.BhattScholze.Andre.Transfinite.CountableCompletion,
    `SerrePositivity.BhattScholze.Andre.Transfinite.PerfectoidLimitCompleteness,
    `SerrePositivity.BhattScholze.Andre.Transfinite.OmegaOne,
    `SerrePositivity.BhattScholze.Andre.Transfinite.CompleteFlatColimit,
    `SerrePositivity.BhattScholze.Andre.Transfinite.FaithfullyFlatColimit,
    `SerrePositivity.BhattScholze.Andre.Transfinite.ResidueTensorColimit,
    `SerrePositivity.BhattScholze.Andre.Transfinite.Composition,
    `SerrePositivity.BhattScholze.Andre.Transfinite.TorsionBound,
    `SerrePositivity.BhattScholze.Andre.Transfinite.FrobeniusKernelColimit,
    `SerrePositivity.BhattScholze.Andre.Transfinite.PrismaticCompletion,
    `SerrePositivity.BhattScholze.Andre.Transfinite.PerfectDeltaColimit,
    `SerrePositivity.BhattScholze.Andre.Transfinite.PresentationColimit,
    `SerrePositivity.BhattScholze.Andre.Transfinite.PerfectoidCompletionColimit,
    `SerrePositivity.BhattScholze.Andre.Transfinite.BoundedCompletion,
    `SerrePositivity.BhattScholze.Andre.Transfinite.CompletedMaps,
    `SerrePositivity.BhattScholze.Andre.Transfinite.Terminal,
    `SerrePositivity.BhattScholze.Andre.Transfinite.CountableRelations,
    `SerrePositivity.BhattScholze.Andre.Transfinite.AlgebraColimit,
    `SerrePositivity.BhattScholze.Andre.Transfinite.CompletionUniversal]
  let mut count : Nat := 0
  let mut modules : Array Name := #[]
  for (name, _) in env.constants.toList do
    let some idx := env.getModuleIdxFor? name | continue
    let mod := env.header.modules[idx.toNat]!.module
    unless expected.contains mod do continue
    let axioms ← collectAxioms name
    unless axioms.all (#[``propext, ``Classical.choice, ``Quot.sound].contains ·) do
      throwError "Unexpected axioms in {name}: {axioms}"
    count := count + 1
    unless modules.contains mod do modules := modules.push mod
  unless modules.size == expected.size do
    throwError "Missing André E3 modules"
  logInfo m!"André E3: {count} declarations audited; standard axioms only."

