-- 基準行が変わっても最初の非指定列の元の番号を保持する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n m : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (h : ∃ j, UnmarkedGenerators.column W (τ.obj 0) j ≠ [])
    (θ : n ⟶ m)
    (hθ : ∃ j, UnmarkedGenerators.column W (((graph W.paths w X Y).map θ τ).obj 0) j ≠ []) :
    UnmarkedGenerators.firstColumn W (((graph W.paths w X Y).map θ τ).obj 0) hθ =
      UnmarkedGenerators.firstColumn W (τ.obj 0) h :=
  UnmarkedGenerators.firstColumn_simplex W τ h θ hθ

-- 接続自然変換全体を元の再添字へ照合する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n m : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (i : Fin w.length)
    (h : UnmarkedGenerators.column W (τ.obj 0) i ≠ []) (θ : n ⟶ m)
    (hθ : UnmarkedGenerators.column W (((graph W.paths w X Y).map θ τ).obj 0) i ≠ []) :
    HEq (UnmarkedGenerators.Attachments.leftAttachment W ((graph W.paths w X Y).map θ τ) i hθ)
      (Functor.whiskerLeft (UnmarkedGenerators.rowIndex θ)
        (UnmarkedGenerators.Attachments.leftAttachment W τ i h)) :=
  UnmarkedGenerators.Attachments.leftAttachment_simplex W τ i h θ hθ

-- 選んだ prefix の全行・全縦射・動く端点を再添字へ照合する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n m : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (h : ∃ j, UnmarkedGenerators.column W (τ.obj 0) j ≠ [])
    (θ : n ⟶ m)
    (hθ : ∃ j, UnmarkedGenerators.column W (((graph W.paths w X Y).map θ τ).obj 0) j ≠ []) :
    HEq (UnmarkedGenerators.AttachedPrefix.diagram W ((graph W.paths w X Y).map θ τ) hθ)
      ((UnmarkedGenerators.AttachedPrefix.diagram W τ h).precomp (UnmarkedGenerators.rowIndex θ)) :=
  UnmarkedGenerators.AttachedPrefix.diagram_simplex W τ h θ hθ

-- refined 単体は元の nerve の同じ全作用素を厳密に保持する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n m : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (i : Fin w.length)
    (h : UnmarkedGenerators.column W (τ.obj 0) i ≠ []) (θ : n ⟶ m)
    (hθ : UnmarkedGenerators.column W (((graph W.paths w X Y).map θ τ).obj 0) i ≠ []) :
    (graph W.paths (UnmarkedGenerators.Attachments.refinedWord w i) X Y).map θ
      (UnmarkedGenerators.Attachments.refinedSimplex W τ i h) =
        UnmarkedGenerators.Attachments.refinedSimplex W ((graph W.paths w X Y).map θ τ) i hθ :=
  UnmarkedGenerators.Attachments.refinedSimplex_simplex W τ i h θ hθ

-- 実際の指定部分圏の全関手を同じ単体作用素に沿って保持する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n m : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (h : ∃ j, UnmarkedGenerators.column W (τ.obj 0) j ≠ [])
    (θ : n ⟶ m)
    (hθ : ∃ j, UnmarkedGenerators.column W (((graph W.paths w X Y).map θ τ).obj 0) j ≠ []) :
    HEq (UnmarkedGenerators.AttachedPrefix.markedFunctor W ((graph W.paths w X Y).map θ τ) hθ)
      (UnmarkedGenerators.rowIndex θ ⋙ UnmarkedGenerators.AttachedPrefix.markedFunctor W τ h) :=
  UnmarkedGenerators.AttachedPrefix.markedFunctor_simplex W τ h θ hθ

-- 任意可換環の実際の全自由次数で、同じ指定部分圏の単体的整合を検証する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n m l : SimplexCategoryᵒᵖ)
    {w : Hammock.Word}
    {X Y : ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category}
    (τ : (Hammock.graph ((freeResolution
      (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).weakEquivalences w X Y).obj m)
    (h : ∃ j, Hammock.UnmarkedGenerators.column
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        (τ.obj 0) j ≠ []) (θ : m ⟶ l)
    (hθ : ∃ j, Hammock.UnmarkedGenerators.column
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        (((Hammock.graph ((freeResolution
          (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).weakEquivalences
            w X Y).map θ τ).obj 0) j ≠ []) :
    let W := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    HEq (Hammock.UnmarkedGenerators.AttachedPrefix.markedFunctor W
      ((Hammock.graph W.paths w X Y).map θ τ) hθ)
      (Hammock.UnmarkedGenerators.rowIndex θ ⋙
        Hammock.UnmarkedGenerators.AttachedPrefix.markedFunctor W τ h) :=
  Hammock.UnmarkedGenerators.AttachedPrefix.markedFunctor_simplex
    (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences τ h θ hθ


-- 空 fiber の恒等列を含む元の各 fiber の指定性を判定する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Word} {X Y : Paths C} (f : a ⟶ b)
    (S : Zigzag W.paths a X Y) (j : Fin b.length) :
    UnmarkedGenerators.column W (WordAction.obj f S) j = [] ↔
      ∀ i, f.orderHom i = j → UnmarkedGenerators.column W S i = [] :=
  UnmarkedGenerators.column_wordAction_eq_nil_iff W f S j

-- 元の最小列の像は圧縮後の最小列自身である。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Word} {X Y : Paths C} (f : a ⟶ b)
    (S : Zigzag W.paths a X Y) (hS : ∃ i, UnmarkedGenerators.column W S i ≠ [])
    (hT : ∃ j, UnmarkedGenerators.column W (WordAction.obj f S) j ≠ []) :
    UnmarkedGenerators.firstColumn W (WordAction.obj f S) hT =
      f.orderHom (UnmarkedGenerators.firstColumn W S hS) :=
  UnmarkedGenerators.firstColumn_wordAction W f S hS hT

-- 元の最初の非指定列の文字列は像の列の接頭列として残る。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Word} {X Y : Paths C} (f : a ⟶ b)
    (S : Zigzag W.paths a X Y) (hS : ∃ i, UnmarkedGenerators.column W S i ≠ []) :
    ∃ tail : List (Quiver.Total C),
      UnmarkedGenerators.column W (WordAction.obj f S)
        (f.orderHom (UnmarkedGenerators.firstColumn W S hS)) =
      UnmarkedGenerators.column W S (UnmarkedGenerators.firstColumn W S hS) ++ tail :=
  UnmarkedGenerators.firstFiber_erasure_prefix W f S hS

-- 指定前置射列と任意の後置射列は元の生成矢を保持する。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization.GeneratorWord in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {X Y X' Y' : C} {p : Quiver.Path X Y}
    (P : FirstCut W p) (u : Quiver.Path X' X) (v : Quiver.Path Y Y') (hu : W.paths u)
    (Q : FirstCut W (u.comp (p.comp v))) :
    (⟨Q.source, Q.target, Q.arrow⟩ : Quiver.Total C) = ⟨P.source, P.target, P.arrow⟩ :=
  FirstCut.generator_of_sandwich W P u v hu Q

-- 元の全語の図式で選んだ実際の行の生成矢を厳密に回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Word} {X Y : Paths C} (f : a ⟶ b)
    {n : SimplexCategoryᵒᵖ} (τ : (graph W.paths a X Y).obj n)
    (hS : ∃ i, UnmarkedGenerators.column W (τ.obj 0) i ≠ [])
    (hT : ∃ j, UnmarkedGenerators.column W
      ((((graphDiagram W.paths X Y).map f).app n τ).obj 0) j ≠ []) :
    UnmarkedGenerators.rowGenerator W (((graphDiagram W.paths X Y).map f).app n τ)
      (UnmarkedGenerators.firstColumn W
        ((((graphDiagram W.paths X Y).map f).app n τ).obj 0) hT)
      (UnmarkedGenerators.firstColumn_nonempty W _ hT) =
    UnmarkedGenerators.rowGenerator W τ (UnmarkedGenerators.firstColumn W (τ.obj 0) hS)
      (UnmarkedGenerators.firstColumn_nonempty W _ hS) :=
  UnmarkedGenerators.rowGenerator_wordAction W f τ hS hT

-- 任意可換環の実際の全自由次数にも元の最小列の像の回収を適用する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    {a b : Hammock.Word} (f : a ⟶ b)
    {X Y : ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category}
    (S : Hammock.Zigzag ((freeResolution
      (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).weakEquivalences a X Y)
    (hS : ∃ i, Hammock.UnmarkedGenerators.column
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        S i ≠ []) :
    let W := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    ∃ j, Hammock.UnmarkedGenerators.column W (Hammock.WordAction.obj f S) j ≠ [] :=
  Hammock.UnmarkedGenerators.nonemptyColumns_wordAction
    (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences f S hS


-- 元の射列の因子化は、固定切断の接頭射と残りを共に厳密に回収する。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization.GeneratorWord in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a : Quiver.Total C} {X Y X' Y' : C} {p : Quiver.Path X Y}
    (P : FixedCut W a p) (u : Quiver.Path X' X) (v : Quiver.Path Y Y') (hu : W.paths u)
    {r : Quiver.Path X' Y'} (hr : r = u.comp (p.comp v)) (Q : FixedCut W a r) :
    Q.left = u.comp P.left ∧ Q.right = P.right.comp v :=
  ⟨FixedCut.factorization_left W P u v hu hr Q,
    FixedCut.factorization_right W P u v hu hr Q⟩

-- 内部の元の列を保持した区間の三分割は元の合成射自身に一致する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : C} (S : Zigzag W w X Y)
    (p q : Fin (w.length + 1)) (hpq : p ≤ q)
    (hd : ∀ j : Fin w.length, p.val ≤ j.val → j.val < q.val → w.direction j = .forward)
    (i : Fin w.length) (hp : p.val ≤ i.val) (hq : i.val < q.val) :
    Segment.map .forward S p q hpq hd =
      Segment.toColumn S p q hd i hp hq ≫ S.arrow i ≫ Segment.fromColumn S p q hd i hp hq :=
  Segment.map_column_factorization S p q hpq hd i hp hq

-- 圧縮後の生の列を元の内部の列と前後の同じ射列で回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Word} {X Y : Paths C} (f : a ⟶ b)
    (S : Zigzag W.paths a X Y) (j : Fin b.length) (i : Fin a.length)
    (hi : f.orderHom i = j) (hj : b.direction j = .forward) :
    HEq ((WordAction.obj f S).arrow j)
      ((WordActionCut.prefixMap W f S j i hi hj).comp
        ((S.arrow i).comp (WordActionCut.residual W f S j i hi hj))) :=
  WordActionCut.factorization W f S j i hi hj

-- 最小非指定列の圧縮後の切断の接頭射を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.SimplicialLocalization.GeneratorWord in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Word} {X Y : Paths C} (f : a ⟶ b)
    (S : Zigzag W.paths a X Y) (h : ∃ i, UnmarkedGenerators.column W S i ≠ [])
    {g : Quiver.Total C} (P : FixedCut W g (S.arrow (UnmarkedGenerators.firstColumn W S h)))
    (Q : FixedCut W g ((WordAction.obj f S).arrow
      (f.orderHom (UnmarkedGenerators.firstColumn W S h)))) :
    HEq Q.left ((UnmarkedGenerators.FirstFiber.prefixMap W f S h).comp P.left) :=
  UnmarkedGenerators.FirstFiber.cut_left W f S h P Q

-- 後置区間の指定性を仮定せず、同じ切断の残りを回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.SimplicialLocalization.GeneratorWord in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Word} {X Y : Paths C} (f : a ⟶ b)
    (S : Zigzag W.paths a X Y) (h : ∃ i, UnmarkedGenerators.column W S i ≠ [])
    {g : Quiver.Total C} (P : FixedCut W g (S.arrow (UnmarkedGenerators.firstColumn W S h)))
    (Q : FixedCut W g ((WordAction.obj f S).arrow
      (f.orderHom (UnmarkedGenerators.firstColumn W S h)))) :
    HEq Q.right (P.right.comp (UnmarkedGenerators.FirstFiber.residualMap W f S h)) :=
  UnmarkedGenerators.FirstFiber.cut_right W f S h P Q

-- 任意可換環の実際の全自由次数で同じ前置区間の指定性を検証する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    {a b : Hammock.Word} (f : a ⟶ b)
    {X Y : ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category}
    (S : Hammock.Zigzag ((freeResolution
      (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).weakEquivalences a X Y)
    (hS : ∃ i, Hammock.UnmarkedGenerators.column
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        S i ≠ []) :
    let W := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    W.paths (Hammock.UnmarkedGenerators.FirstFiber.prefixMap W f S hS) :=
  Hammock.UnmarkedGenerators.FirstFiber.prefixMap_mem
    (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences f S hS


-- 元の制限射は prefix と残りの双方で合成を厳密に保持する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {a b c : Word} (f : a ⟶ b) (g : b ⟶ c) (i : Fin a.length)
    (hi : a.direction i = .forward) :
    Word.CutFactor.prefixMap (f ≫ g) i hi = Word.CutFactor.prefixMap f i hi ≫
      Word.CutFactor.prefixMap g (f.orderHom i) ((f.direction_eq i).trans hi) ∧
    Word.CutFactor.residualMap (f ≫ g) i hi = Word.CutFactor.residualMap f i hi ≫
      Word.CutFactor.residualMap g (f.orderHom i) ((f.direction_eq i).trans hi) :=
  ⟨Word.CutFactor.prefixMap_comp f i hi g, Word.CutFactor.residualMap_comp f i hi g⟩

-- prefix の前の全頂点では制限射の cut が元の cut 自身へ戻る。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {a b : Word} (f : a ⟶ b) (i : Fin a.length) (hi : a.direction i = .forward)
    (k : Fin ((Word.ColumnSplit.before b (f.orderHom i)).length + 1)) :
    ((Word.CutFactor.prefixMap f i hi).cut
      (Word.leftVertex (Word.ColumnSplit.before b (f.orderHom i)) (Word.single .forward) k)).val =
      (f.cut (Word.CutFactor.prefixVertex b (f.orderHom i) k)).val :=
  Word.CutFactor.prefix_cut f i hi k

-- 残りの後の全頂点では元の番号を足すと同じ元の cut に戻る。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {a b : Word} (f : a ⟶ b) (i : Fin a.length) (hi : a.direction i = .forward)
    (k : Fin ((Word.ColumnSplit.after b (f.orderHom i)).length + 1)) :
    i.val + ((Word.CutFactor.residualMap f i hi).cut
      (Word.rightVertex (Word.single .forward) (Word.ColumnSplit.after b (f.orderHom i)) k)).val =
      (f.cut (Word.CutFactor.residualVertex b (f.orderHom i) k)).val :=
  Word.CutFactor.residual_cut f i hi k

-- 内部切断端点を含む prefix の全頂点を元の語の図式へ回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (f : a ⟶ b) (τ : (graph W.paths a X Y).obj n)
    (h : ∃ i, UnmarkedGenerators.column W (τ.obj 0) i ≠ [])
    (hT : UnmarkedGenerators.column W ((τ ⋙ WordAction.functor f).obj 0)
      (f.orderHom (UnmarkedGenerators.firstColumn W (τ.obj 0) h)) ≠ [])
    (d : Fin (n.unop.len + 1))
    (k : Fin ((Word.CutFactor.prefixWord b
      (f.orderHom (UnmarkedGenerators.firstColumn W (τ.obj 0) h))).length + 1)) :
    (WordAction.obj (Word.CutFactor.prefixMap f (UnmarkedGenerators.firstColumn W (τ.obj 0) h)
      (UnmarkedGenerators.firstColumn_forward W (τ.obj 0) h))
      ((UnmarkedGenerators.Attachments.prefixDiagram W τ
        (UnmarkedGenerators.firstColumn W (τ.obj 0) h)
        (UnmarkedGenerators.firstColumn_nonempty W (τ.obj 0) h)).obj d)).vertex k =
    ((UnmarkedGenerators.Attachments.prefixDiagram W (τ ⋙ WordAction.functor f)
      (f.orderHom (UnmarkedGenerators.firstColumn W (τ.obj 0) h)) hT).obj d).vertex k :=
  UnmarkedGenerators.FirstFactorAction.prefix_vertices W f τ h hT d k

-- 残りの内部切断端点を含む全縦成分は同じ元の射へ戻る。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (f : a ⟶ b) (τ : (graph W.paths a X Y).obj n)
    (h : ∃ i, UnmarkedGenerators.column W (τ.obj 0) i ≠ [])
    (hT : UnmarkedGenerators.column W ((τ ⋙ WordAction.functor f).obj 0)
      (f.orderHom (UnmarkedGenerators.firstColumn W (τ.obj 0) h)) ≠ [])
    {d e : Fin (n.unop.len + 1)} (g : d ⟶ e)
    (k : Fin ((Word.CutFactor.residualWord b
      (f.orderHom (UnmarkedGenerators.firstColumn W (τ.obj 0) h))).length + 1)) :
    HEq ((WordAction.movingMap
      (Word.CutFactor.residualMap f (UnmarkedGenerators.firstColumn W (τ.obj 0) h)
        (UnmarkedGenerators.firstColumn_forward W (τ.obj 0) h))
      ((UnmarkedGenerators.Attachments.residualDiagram W τ
        (UnmarkedGenerators.firstColumn W (τ.obj 0) h)
        (UnmarkedGenerators.firstColumn_nonempty W (τ.obj 0) h)).map g)).app k)
      (((UnmarkedGenerators.Attachments.residualDiagram W (τ ⋙ WordAction.functor f)
        (f.orderHom (UnmarkedGenerators.firstColumn W (τ.obj 0) h)) hT).map g).app k) :=
  UnmarkedGenerators.FirstFactorAction.residual_apps W f τ h hT g k

-- 任意可換環の実際の全自由次数の切断端点にも同じ生成矢の回収を適用する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n m : SimplexCategoryᵒᵖ)
    {a b : Hammock.Word} (f : a ⟶ b)
    {X Y : ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category}
    (τ : (Hammock.graph ((freeResolution
      (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).weakEquivalences a X Y).obj m)
    (h : ∃ i, Hammock.UnmarkedGenerators.column
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        (τ.obj 0) i ≠ [])
    (hT : let W := (freeResolutionGeneratorBase
        (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
      Hammock.UnmarkedGenerators.column W ((τ ⋙ Hammock.WordAction.functor f).obj 0)
        (f.orderHom (Hammock.UnmarkedGenerators.firstColumn W (τ.obj 0) h)) ≠ []) :
    let W := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    Hammock.UnmarkedGenerators.rowGenerator W (τ ⋙ Hammock.WordAction.functor f)
      (f.orderHom (Hammock.UnmarkedGenerators.firstColumn W (τ.obj 0) h)) hT =
    Hammock.UnmarkedGenerators.rowGenerator W τ
      (Hammock.UnmarkedGenerators.firstColumn W (τ.obj 0) h)
      (Hammock.UnmarkedGenerators.firstColumn_nonempty W (τ.obj 0) h) :=
  Hammock.UnmarkedGenerators.FirstFactorAction.generator_eq
    (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences f τ h hT


-- 元の前後の連続部分の包含は同じ元の頂点を保持する。
open SerrePositivity.EInfinity.Hammock in
example (w : Word) (p : Fin w.length)
    (k : Fin ((Word.ColumnSplit.before w p).length + 1))
    (l : Fin ((Word.ColumnSplit.after w p).length + 1)) :
    (Word.ColumnSplit.beforeBlock w p).vertex k = Word.ColumnSplit.beforeVertex w p k ∧
    (Word.ColumnSplit.afterBlock w p).vertex l = Word.ColumnSplit.afterVertex w p l :=
  ⟨Word.ColumnSplit.beforeBlock_vertex w p k, Word.ColumnSplit.afterBlock_vertex w p l⟩

-- 抽出した前の全区間合成を、元の同じ区間へ回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] (W : MorphismProperty C) [W.IsMultiplicative]
    {w : Word} {A B : D ⥤ C} (p : Fin w.length) (F : Zigzag.MovingDiagram D C W w A B)
    (d : D) (δ : Direction) (u v : Fin ((Word.ColumnSplit.before w p).length + 1)) (huv : u ≤ v)
    (hd : ∀ j : Fin (Word.ColumnSplit.before w p).length,
      u.val ≤ j.val → j.val < v.val → (Word.ColumnSplit.before w p).direction j = δ) :
    HEq (Segment.map δ ((Zigzag.MovingDiagram.ColumnSplit.before p F).obj d) u v huv hd)
      (Segment.map δ (F.obj d) ((Word.ColumnSplit.beforeBlock w p).vertex u)
        ((Word.ColumnSplit.beforeBlock w p).vertex v)
        ((Word.ColumnSplit.beforeBlock w p).vertex_monotone huv)
        ((Word.ColumnSplit.beforeBlock w p).interval_direction δ u v hd)) :=
  Zigzag.MovingDiagram.ColumnSplit.before_segment p F d δ u v huv hd

-- 同じ回収を後の全区間と全方向でも検証する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] (W : MorphismProperty C) [W.IsMultiplicative]
    {w : Word} {A B : D ⥤ C} (p : Fin w.length) (F : Zigzag.MovingDiagram D C W w A B)
    (d : D) (δ : Direction) (u v : Fin ((Word.ColumnSplit.after w p).length + 1)) (huv : u ≤ v)
    (hd : ∀ j : Fin (Word.ColumnSplit.after w p).length,
      u.val ≤ j.val → j.val < v.val → (Word.ColumnSplit.after w p).direction j = δ) :
    HEq (Segment.map δ ((Zigzag.MovingDiagram.ColumnSplit.after p F).obj d) u v huv hd)
      (Segment.map δ (F.obj d) ((Word.ColumnSplit.afterBlock w p).vertex u)
        ((Word.ColumnSplit.afterBlock w p).vertex v)
        ((Word.ColumnSplit.afterBlock w p).vertex_monotone huv)
        ((Word.ColumnSplit.afterBlock w p).interval_direction δ u v hd)) :=
  Zigzag.MovingDiagram.ColumnSplit.after_segment p F d δ u v huv hd

-- prefix の内部切断列以外の全横列は元の制限射と一致する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (f : a ⟶ b) (τ : (graph W.paths a X Y).obj n) (i : Fin a.length)
    (h : UnmarkedGenerators.column W (τ.obj 0) i ≠ []) (hi : a.direction i = .forward)
    (hT : UnmarkedGenerators.column W ((τ ⋙ WordAction.functor f).obj 0) (f.orderHom i) ≠ [])
    (d : Fin (n.unop.len + 1)) (k : Fin (Word.ColumnSplit.before b (f.orderHom i)).length) :
    HEq ((WordAction.obj (Word.CutFactor.prefixMap f i hi)
      ((UnmarkedGenerators.Attachments.prefixDiagram W τ i h).obj d)).arrow (k.castAdd 1))
      (((UnmarkedGenerators.Attachments.prefixDiagram W (τ ⋙ WordAction.functor f)
        (f.orderHom i) hT).obj d).arrow (k.castAdd 1)) :=
  UnmarkedGenerators.Attachments.prefix_outer_arrow W f τ i h hi hT d k

-- 残りの内部切断列以外も、元の全方向の横列を保持する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (f : a ⟶ b) (τ : (graph W.paths a X Y).obj n) (i : Fin a.length)
    (h : UnmarkedGenerators.column W (τ.obj 0) i ≠ []) (hi : a.direction i = .forward)
    (hT : UnmarkedGenerators.column W ((τ ⋙ WordAction.functor f).obj 0) (f.orderHom i) ≠ [])
    (d : Fin (n.unop.len + 1)) (k : Fin (Word.ColumnSplit.after b (f.orderHom i)).length) :
    HEq ((WordAction.obj (Word.CutFactor.residualMap f i hi)
      ((UnmarkedGenerators.Attachments.residualDiagram W τ i h).obj d)).arrow (k.natAdd 1))
      (((UnmarkedGenerators.Attachments.residualDiagram W (τ ⋙ WordAction.functor f)
        (f.orderHom i) hT).obj d).arrow (k.natAdd 1)) :=
  UnmarkedGenerators.Attachments.residual_outer_arrow W f τ i h hi hT d k

-- 任意可換環の実際の全自由次数でも同じ元の横列を検証する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n m : SimplexCategoryᵒᵖ)
    {a b : Hammock.Word} (f : a ⟶ b)
    {X Y : ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category}
    (τ : (Hammock.graph ((freeResolution
      (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).weakEquivalences a X Y).obj m)
    (i : Fin a.length)
    (h : Hammock.UnmarkedGenerators.column
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        (τ.obj 0) i ≠ []) (hi : a.direction i = .forward)
    (hT : let W := (freeResolutionGeneratorBase
        (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
      Hammock.UnmarkedGenerators.column W ((τ ⋙ Hammock.WordAction.functor f).obj 0)
        (f.orderHom i) ≠ [])
    (d : Fin (m.unop.len + 1)) (k : Fin (Hammock.Word.ColumnSplit.before b (f.orderHom i)).length) :
    let W := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    HEq ((Hammock.WordAction.obj (Hammock.Word.CutFactor.prefixMap f i hi)
      ((Hammock.UnmarkedGenerators.Attachments.prefixDiagram W τ i h).obj d)).arrow (k.castAdd 1))
      (((Hammock.UnmarkedGenerators.Attachments.prefixDiagram W (τ ⋙ Hammock.WordAction.functor f)
        (f.orderHom i) hT).obj d).arrow (k.castAdd 1)) :=
