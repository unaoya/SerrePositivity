    (W : MorphismProperty C) (X Y : Paths C) :
    (FirstFactor.nonemptyIso W X Y).hom ≫ NonemptyValue.inclusion W X Y =
      FirstFactor.ambientMap W X Y := FirstFactor.nonemptyIso_hom_inclusion W X Y

-- 元の非空部分上の切断射は各語の同じ切断を回収する。
