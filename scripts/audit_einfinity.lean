-- 局所分解は元の全語そのものの等式であり、方向と中央列を保持する。
open SerrePositivity.EInfinity.Hammock in
example {w : Word} {p : Fin w.length} (h : Word.BackwardBounds w p) : h.wholeWord = w :=
  h.whole_eq

-- 元の一列の削除語を padding した写像自身の graph 比較。
open CategoryTheory HomotopicalAlgebra SerrePositivity.InfinityCategories
    SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [SmallCategory C] [ModelCategory C]
    (X Y : C) (cof : MorphismProperty.FunctorialFactorizationData
      (cofibrations C) (trivialFibrations C)) (w : Word) (p : Fin w.length)
    (hp : w.direction p = .backward) :
    IsWeakHomotopyEquivalence ((graphDiagram (weakEquivalences C) X Y).map
      (Word.paddingFunctor.map (Word.eraseInclusion w p))) :=
  paddedBackwardInsertion_isWeakHomotopyEquivalence X Y cof w p hp

-- 元の自然変換は空の forward 部分語でも、各語の実際の成分で弱同値となる。
open CategoryTheory HomotopicalAlgebra SerrePositivity.InfinityCategories
    SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [SmallCategory C] [ModelCategory C]
    (X Y : C) (cof : MorphismProperty.FunctorialFactorizationData
      (cofibrations C) (trivialFibrations C)) (w : Word) :
    IsWeakHomotopyEquivalence
      ((paddedForwardDiagramMap (graphDiagram (weakEquivalences C) X Y)).app w) :=
  paddedForwardDiagramMap_isWeakHomotopyEquivalence X Y cof w

-- 元の語が空でも、同じ元の自然変換の成分を扱う。
open CategoryTheory HomotopicalAlgebra SerrePositivity.InfinityCategories
    SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [SmallCategory C] [ModelCategory C]
    (X Y : C) (cof : MorphismProperty.FunctorialFactorizationData
      (cofibrations C) (trivialFibrations C)) :
    IsWeakHomotopyEquivalence
      ((paddedForwardDiagramMap (graphDiagram (weakEquivalences C) X Y)).app Word.empty) :=
  paddedForwardDiagramMap_isWeakHomotopyEquivalence X Y cof Word.empty

-- 元の三列から元の全語の余極限への標準射自身は弱同値となる。
open CategoryTheory HomotopicalAlgebra SerrePositivity.InfinityCategories
    SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [SmallCategory C] [ModelCategory C]
    (X Y : C) (cof : MorphismProperty.FunctorialFactorizationData
      (cofibrations C) (trivialFibrations C)) :
    IsWeakHomotopyEquivalence (graphInclusion (weakEquivalences C) X Y Word.threeArrow) :=
  threeArrowGraphInclusion_isWeakHomotopyEquivalence X Y cof

-- 任意可換環の元の Map^h の共通始域からの全語の余極限への右射も弱同値。
open SerrePositivity.InfinityCategories SerrePositivity.EInfinity in
example (R : Type e2ComplexLimitUniverse) [CommRing R]
    (X Y : (BarrattEccles.operad R).Algebra) :
    IsWeakHomotopyEquivalence (BarrattEccles.mappingSpaceHammockColimitNerveMap R X Y) :=
  BarrattEccles.mappingSpaceHammockColimitNerveMap_isWeakHomotopyEquivalence R X Y

-- 元の相対関手と元の全語の作用は、元の対象で厳密に可換。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [SmallCategory C] [SmallCategory D]
    {W : MorphismProperty C} [W.IsMultiplicative] {V : MorphismProperty D} [V.IsMultiplicative]
    (F : LocalizerMorphism W V) {a b : Word} {X Y : C} (f : a ⟶ b) (S : Zigzag W a X Y) :
    WordAction.obj f (Zigzag.Relative.obj F S) = Zigzag.Relative.obj F (WordAction.obj f S) :=
  Zigzag.Relative.wordAction_obj_eq F f S

-- 相対関手の合成は元の reduced hammock の全単体作用素で厳密に保たれる。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D E : Type e2ComplexLimitUniverse} [SmallCategory C] [SmallCategory D] [SmallCategory E]
    {W : MorphismProperty C} [W.IsMultiplicative] {V : MorphismProperty D} [V.IsMultiplicative]
    {U : MorphismProperty E} [U.IsMultiplicative]
    (F : LocalizerMorphism W V) (G : LocalizerMorphism V U) (X Y : C) :
    Relative.reducedMap (F.comp G) X Y = Relative.reducedMap F X Y ≫
      Relative.reducedMap G (F.functor.obj X) (F.functor.obj Y) :=
  Relative.reducedMap_comp F G X Y

-- 元の各固定語の正規化との自然性を、同じ相対関手で保持する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [SmallCategory C] [SmallCategory D]
    {W : MorphismProperty C} [W.IsMultiplicative] {V : MorphismProperty D} [V.IsMultiplicative]
    (F : LocalizerMorphism W V) (X Y : C) (w : Word) :
    graphNormalization W X Y w ≫ Relative.reducedMap F X Y =
      (Relative.graphDiagramMap F X Y).app w ≫
        graphNormalization V (F.functor.obj X) (F.functor.obj Y) w :=
  Relative.graphNormalization_reducedMap F X Y w

-- 元の三列の正規化自体はモデル圏の元の分解から弱同値となる。
open CategoryTheory HomotopicalAlgebra SerrePositivity.InfinityCategories
    SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [SmallCategory C] [ModelCategory C]
    (X Y : C) (cof : MorphismProperty.FunctorialFactorizationData
      (cofibrations C) (trivialFibrations C)) :
    IsWeakHomotopyEquivalence (graphNormalization (weakEquivalences C) X Y Word.threeArrow) :=
  threeArrowNormalization_isWeakHomotopyEquivalence X Y cof

-- 任意可換環の元の Map^h の共通始域から reduced hammock への右射は弱同値。
open SerrePositivity.InfinityCategories SerrePositivity.EInfinity in
example (R : Type e2ComplexLimitUniverse) [CommRing R]
    (X Y : (BarrattEccles.operad R).Algebra) :
    IsWeakHomotopyEquivalence (BarrattEccles.mappingSpaceReducedHammockNerveMap R X Y) :=
  BarrattEccles.mappingSpaceReducedHammockNerveMap_isWeakHomotopyEquivalence R X Y

-- 右射は元の縮約 augmentation を合成すると元の余極限への右射に厳密に戻る。
open CategoryTheory SerrePositivity.EInfinity in
example (R : Type e2ComplexLimitUniverse) [CommRing R]
    (X Y : (BarrattEccles.operad R).Algebra) :
    BarrattEccles.mappingSpaceReducedHammockNerveMap R X Y ≫
      (BarrattEccles.algebraHammockReductionIso R X Y).inv =
        BarrattEccles.mappingSpaceHammockColimitNerveMap R X Y :=
  BarrattEccles.mappingSpaceReducedHammockNerveMap_augmentation R X Y

-- 元の自由相対解像の全作用素は、選んだ対象を元の等式で保存する。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example (C : RelativeCategory.{e2ComplexLimitUniverse}) {n m : SimplexCategoryᵒᵖ}
    (θ : n ⟶ m) (X : C.category) :
    ((freeResolution C).map θ).functor.obj (freeResolutionObject C n X) =
      freeResolutionObject C m X := freeResolutionObject_naturality C θ X

-- 局所化前の標準生成対象と同じ元の対象を全自由次数で回収する。
open CategoryTheory Opposite SerrePositivity.EInfinity.SimplicialLocalization in
example (C : RelativeCategory.{e2ComplexLimitUniverse}) (n : ℕ) (X : C.category) :
    freeResolutionObject C (op (SimplexCategory.mk n)) X =
      freeResolutionGeneratorObject C (n + 1) X := freeResolutionObject_generator C n X

-- 元の全語の図式は空語の graph も各自由次数でそのまま保持する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (C : RelativeCategory.{e2ComplexLimitUniverse}) (X Y : C.category)
    (n : SimplexCategoryᵒᵖ) :
    ((freeHammockWordDiagram C X Y).obj Hammock.Word.empty).obj n =
      Hammock.graph ((freeResolution C).obj n).weakEquivalences Hammock.Word.empty
        (freeResolutionObject C n X) (freeResolutionObject C n Y) := rfl

-- 対角の左射の各成分は、元の二重単体的 augmentation の同じ対角成分。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example (C : RelativeCategory.{e2ComplexLimitUniverse}) (X Y : C.category)
    (n : SimplexCategoryᵒᵖ) :
    (freeHammockDiagonalAugmentation C X Y).app n =
      ((freeHammockAugmentation C X Y).app n).app n :=
  freeHammockDiagonalAugmentation_app C X Y n

-- augmentation は元の任意の単体作用素に自然な、元の hammock への比較。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (C : RelativeCategory.{e2ComplexLimitUniverse}) (X Y : C.category)
    {n m : SimplexCategoryᵒᵖ} (θ : n ⟶ m) :
    (freeHammockResolution C X Y).map θ ≫ (freeHammockAugmentation C X Y).app m =
      (freeHammockAugmentation C X Y).app n ≫
        ((Functor.const SimplexCategoryᵒᵖ).obj (Hammock.colimitGraph C.weakEquivalences X Y)).map θ :=
  (freeHammockAugmentation C X Y).naturality θ

-- 任意可換環の実際の既存の DK 入力に、同じ対角と reduced hammock への左射を代入。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R]
    (X Y : (BarrattEccles.cofibrantAlgebraRelativeCategory R).category) :
    freeHammockDiagonal (BarrattEccles.cofibrantAlgebraRelativeCategory R) X Y ⟶
      Hammock.reducedSimplicialSet
        (BarrattEccles.cofibrantAlgebraRelativeCategory R).weakEquivalences X Y :=
  freeHammockDiagonalReduction (BarrattEccles.cofibrantAlgebraRelativeCategory R) X Y

-- 全自由次数で、元の自由対象の局所化像は既存 DK Hom の対象と一致する。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example (C : RelativeCategory.{e2ComplexLimitUniverse}) (n : SimplexCategoryᵒᵖ)
    (X : C.category) :
    ((freeResolution C).obj n).weakEquivalences.Q.obj (freeResolutionObject C n X) =
      localizedFreeResolutionObject C n X := freeResolutionObject_localized C n X

-- 右比較は空語を含む全語の元の余極限の標準射で同じ評価を回収する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (C : RelativeCategory.{e2ComplexLimitUniverse}) (X Y : C.category)
    (n : SimplexCategoryᵒᵖ) (w : Hammock.Word) :
    Hammock.graphInclusion ((freeResolution C).obj n).weakEquivalences
      (freeResolutionObject C n X) (freeResolutionObject C n Y) w ≫
        (freeHammockHomComparison C X Y).app n =
          (freeHammockLocalizationObjects C).graphValue n w X Y :=
  freeHammockHomComparison_fac C X Y n w

-- 元の全単体作用素に対し、局所化 Hom への評価が厳密に自然である。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example (C : RelativeCategory.{e2ComplexLimitUniverse}) (X Y : C.category)
    {n m : SimplexCategoryᵒᵖ} (θ : n ⟶ m) :
    (freeHammockResolution C X Y).map θ ≫ (freeHammockHomComparison C X Y).app m =
      (freeHammockHomComparison C X Y).app n ≫
        (localizationHom C X Y ⋙ Functor.const SimplexCategoryᵒᵖ).map θ :=
  (freeHammockHomComparison C X Y).naturality θ

-- 右比較の対角成分は元の各次数の評価そのもの。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example (C : RelativeCategory.{e2ComplexLimitUniverse}) (X Y : C.category)
    (n : SimplexCategoryᵒᵖ) :
    (freeHammockDiagonalComparison C X Y).app n =
      ((freeHammockHomComparison C X Y).app n).app n :=
  freeHammockDiagonalComparison_app C X Y n

-- 任意可換環の既存の cofibrant 代数の DK 入力に、元の右比較を代入する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R]
    (X Y : (BarrattEccles.cofibrantAlgebraRelativeCategory R).category) :
    freeHammockDiagonal (BarrattEccles.cofibrantAlgebraRelativeCategory R) X Y ⟶
      localizationHom (BarrattEccles.cofibrantAlgebraRelativeCategory R) X Y :=
  freeHammockDiagonalComparison (BarrattEccles.cofibrantAlgebraRelativeCategory R) X Y

-- 同じ入力の左比較と右比較は、同じ元の自由 hammock の対角を共通始域に持つ。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R]
    (X Y : (BarrattEccles.cofibrantAlgebraRelativeCategory R).category) :
    (freeHammockDiagonal (BarrattEccles.cofibrantAlgebraRelativeCategory R) X Y ⟶
      Hammock.reducedSimplicialSet
        (BarrattEccles.cofibrantAlgebraRelativeCategory R).weakEquivalences X Y) ×
    (freeHammockDiagonal (BarrattEccles.cofibrantAlgebraRelativeCategory R) X Y ⟶
      localizationHom (BarrattEccles.cofibrantAlgebraRelativeCategory R) X Y) :=
  ⟨freeHammockDiagonalReduction _ X Y, freeHammockDiagonalComparison _ X Y⟩

-- 元の指定射列は、指定生成矢の自由射列に移して戻すと同じ射列になる。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {X Y : C} (p : Quiver.Path X Y) (hp : W.paths p) :
    (MarkedGenerators.inclusion W).map (MarkedGenerators.lift W p hp) = p :=
  MarkedGenerators.inclusion_lift W p hp

-- 元の恒等射も指定生成矢の一文字として残り、空列には潰れない。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) [W.IsMultiplicative] (X : C) :
    ((MarkedGenerators.inclusion W).map (Quiver.Hom.toPath
      (show @Quiver.Hom (MarkedGenerators.quiver W) _ X X from
        ⟨𝟙 X, W.id_mem X⟩))).length = 1 := rfl

-- 元の自由次数の指定部分圏との圏同値は、元の包含の同じ因子化を持つ。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example (C : RelativeCategory.{e2ComplexLimitUniverse}) (n : SimplexCategoryᵒᵖ) :
    (freeResolutionMarkedEquivalence C n).functor ⋙
      wideSubcategoryInclusion ((freeResolution C).obj n).weakEquivalences =
        MarkedGenerators.inclusion (freeResolutionGeneratorBase C n).weakEquivalences :=
  freeResolutionMarkedEquivalence_inclusion C n

-- 自由解像の全次数で、共通対象表示を持つ二つの生成部分から一意に貼り合わせる。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example (C : RelativeCategory.{e2ComplexLimitUniverse}) (n : SimplexCategoryᵒᵖ)
    {D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} D]
    (F : Paths (MarkedGenerators.quiver (freeResolutionGeneratorBase C n).weakEquivalences) ⥤ D)
    (G : Paths (MarkedGenerators.quiver
      (GeneratorPartition.unmarked (freeResolutionGeneratorBase C n).weakEquivalences)) ⥤ D)
    (h : ∀ X : (freeResolutionGeneratorBase C n).category, F.obj X = G.obj X) :
    ∃! H : ((freeResolution C).obj n).category ⥤ D,
      MarkedGenerators.inclusion (freeResolutionGeneratorBase C n).weakEquivalences ⋙ H = F ∧
        MarkedGenerators.inclusion
          (GeneratorPartition.unmarked (freeResolutionGeneratorBase C n).weakEquivalences) ⋙ H =
            G := freeResolution_existsUnique_extension C n F G h

-- 局所化への入力の全指定射列の反転は、指定生成部分の全射の反転と同値。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] (W : MorphismProperty C) (L : Paths C ⥤ D) :
    W.paths.IsInvertedBy L ↔
      (⊤ : MorphismProperty (Paths (MarkedGenerators.quiver W))).IsInvertedBy
        (MarkedGenerators.inclusion W ⋙ L) :=
  GeneratorPartition.inverts_iff_markedRestriction W L

-- 任意可換環の実際の DK 入力の全自由次数に、指定部分圏との圏同値を代入する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ) :
    Paths (MarkedGenerators.quiver (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences) ≌
        WideSubcategory ((freeResolution
          (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).weakEquivalences :=
  freeResolutionMarkedEquivalence (BarrattEccles.cofibrantAlgebraRelativeCategory R) n

-- 元の射列には、元の端点と全生成文字を保つ交互標準形が一意に存在する。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {X Y : C} (p : Quiver.Path X Y) :
    ∃! N : GeneratorBlocks.Normal W X Y, GeneratorBlocks.flattenNormal W N = p :=
  GeneratorBlocks.existsUnique_normal W p

-- 圏としても元の自由圏を回収し、元の連結に同じ flatten を与える。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {X Y Z : GeneratorBlocks.BlockCategory W}
    (f : X ⟶ Y) (g : Y ⟶ Z) :
    (GeneratorBlocks.categoryEquivalence W).functor.map (f ≫ g) =
      (GeneratorBlocks.categoryEquivalence W).functor.map f ≫
        (GeneratorBlocks.categoryEquivalence W).functor.map g :=
  (GeneratorBlocks.categoryEquivalence W).functor.map_comp f g

-- 元の恒等射の一文字を空射列に潰すことはしない。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (X : C) :
    GeneratorBlocks.normalize W (𝟙 X).toPath ≠ GeneratorBlocks.empty W X :=
  GeneratorBlocks.normalize_letter_ne_empty W (𝟙 X)

-- 各単色ブロックは同じ指定・非指定の自由因子の射となり、包含で元の列に戻る。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {X Y : C} (c : Bool) (p : Quiver.Path X Y)
    (hp : (GeneratorBlocks.monochrome W c).paths p) :
    (MarkedGenerators.inclusion (GeneratorBlocks.part W c)).map
      (GeneratorBlocks.typedBlock W c p hp) = p :=
  GeneratorBlocks.inclusion_typedBlock W c p hp

-- 元の全自由次数の合成が同じ交互標準形の合成に対応する。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example (C : RelativeCategory.{e2ComplexLimitUniverse}) (n : SimplexCategoryᵒᵖ)
    {X Y Z : ((freeResolution C).obj n).category} (f : X ⟶ Y) (g : Y ⟶ Z) :
    freeResolutionBlockEquiv C n X Z (f ≫ g) =
      GeneratorBlocks.comp (freeResolutionGeneratorBase C n).weakEquivalences
        (freeResolutionBlockEquiv C n X Y f) (freeResolutionBlockEquiv C n Y Z g) :=
  freeResolutionBlockEquiv_comp C n f g

-- 任意可換環の実際の DK 入力と既存の固定端点で、元の射自身を回収する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (X Y : (BarrattEccles.cofibrantAlgebraRelativeCategory R).category)
    (f : freeResolutionObject (BarrattEccles.cofibrantAlgebraRelativeCategory R) n X ⟶
      freeResolutionObject (BarrattEccles.cofibrantAlgebraRelativeCategory R) n Y) :
    (freeResolutionBlockEquiv (BarrattEccles.cofibrantAlgebraRelativeCategory R) n _ _).symm
      (freeResolutionBlockEquiv (BarrattEccles.cofibrantAlgebraRelativeCategory R) n _ _ f) = f :=
  (freeResolutionBlockEquiv (BarrattEccles.cofibrantAlgebraRelativeCategory R) n _ _).symm_apply_apply f

-- 元の指定縦射の可換正方形は、非指定生成矢の同じ文字列を保つ。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {X Y X' Y' : C}
    (p : Quiver.Path X Y) (q : Quiver.Path X' Y')
    (u : Quiver.Path X X') (v : Quiver.Path Y Y')
    (hu : W.paths u) (hv : W.paths v) (h : p.comp v = u.comp q) :
    GeneratorWord.erase W p = GeneratorWord.erase W q := GeneratorWord.erase_square W p q u v hu hv h

-- 元の全行・全列の非指定生成文字列は、元の全縦射に沿って一定。
open CategoryTheory SerrePositivity.EInfinity in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Hammock.Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (τ : (Hammock.graph W.paths w X Y).obj n) (k : Fin (n.unop.len + 1)) (i : Fin w.length) :
    Hammock.UnmarkedGenerators.column W (τ.obj k) i =
      Hammock.UnmarkedGenerators.column W (τ.obj 0) i :=
  Hammock.UnmarkedGenerators.column_row W τ k i

-- 後ろ向き列の評価は空文字列であり、逆射も空文字列。
open CategoryTheory SerrePositivity.EInfinity in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Hammock.Word} {X Y : Paths C}
    (S : Hammock.Zigzag W.paths w X Y) (i : Fin w.length)
    (hi : w.direction i = .backward) :
    Hammock.Zigzag.Value.edge (SimplicialLocalization.GeneratorWord.functor W)
      (SimplicialLocalization.GeneratorWord.inverts W) S i = [] :=
  Hammock.UnmarkedGenerators.edge_backward W S i hi

-- 同じ全語の作用で列を合成・挿入しても、非指定文字列の評価は変わらない。
open CategoryTheory SerrePositivity.EInfinity in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Hammock.Word} {X Y : Paths C} (f : a ⟶ b)
    (S : Hammock.Zigzag W.paths a X Y) :
    Hammock.UnmarkedGenerators.value W (Hammock.WordAction.obj f S) =
      Hammock.UnmarkedGenerators.value W S := Hammock.UnmarkedGenerators.value_wordAction W f S

-- 非空の非指定文字列は、元の指定接頭列・最初の非指定矢・残りに切れる。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {X Y : C} (p : Quiver.Path X Y)
    (hp : GeneratorWord.erase W p ≠ []) :
    ∃ (A B : C) (e : A ⟶ B) (left : Quiver.Path X A) (right : Quiver.Path B Y),
      W.paths left ∧ ¬ W e ∧ p = left.comp (e.toPath.comp right) :=
  GeneratorWord.exists_first_of_erase_ne_nil W p hp

-- 任意可換環の既存 DK 入力の各次数で、元の全語の余極限から評価できる。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (X Y : (BarrattEccles.cofibrantAlgebraRelativeCategory R).category) :
    (freeHammockResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R) X Y).obj n ⟶
      (Functor.const SimplexCategoryᵒᵖ).obj (List (Quiver.Total
        (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category)) :=
  freeHammockGeneratorWordValue (BarrattEccles.cofibrantAlgebraRelativeCategory R) X Y n

-- 最初の切断の全データは元の射列だけから一意に決まる。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {X Y : C} {p : Quiver.Path X Y}
    (P Q : GeneratorWord.FirstCut W p) : P = Q := GeneratorWord.firstCut_ext W P Q

-- 同じ非指定矢で両表示を揃えると、元の正方形から通常の等式で両側を回収する。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {X Y X' Y' A B : C}
    (p : Quiver.Path X Y) (q : Quiver.Path X' Y')
    (u : Quiver.Path X X') (v : Quiver.Path Y Y') (hu : W.paths u)
    (e : A ⟶ B) (left : Quiver.Path X A) (right : Quiver.Path B Y)
    (left' : Quiver.Path X' A) (right' : Quiver.Path B Y')
    (hl : W.paths left) (hl' : W.paths left') (he : ¬ W e)
    (hp : p = left.comp (e.toPath.comp right))
    (hq : q = left'.comp (e.toPath.comp right')) (h : p.comp v = u.comp q) :
    left = u.comp left' ∧ right.comp v = right' :=
  GeneratorWord.first_split_square_same_arrow W p q u v hu e left right left' right'
    hl hl' he hp hq h

-- 基準行の非空文字列だけから、全行に最初の切断が得られる。
open CategoryTheory SerrePositivity.EInfinity in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Hammock.Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (τ : (Hammock.graph W.paths w X Y).obj n) (i : Fin w.length)
    (h : Hammock.UnmarkedGenerators.column W (τ.obj 0) i ≠ []) (k : Fin (n.unop.len + 1)) :
    SimplicialLocalization.GeneratorWord.FirstCut W ((τ.obj k).arrow i) :=
  Hammock.UnmarkedGenerators.rowFirstCut W τ i h k

-- 元の全縦射は、同じ非指定矢と両側の射列の正方形を同時に保持する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Hammock.Word} {X Y : Paths C}
    {S T : Hammock.Zigzag W.paths w X Y} (f : S ⟶ T) (i : Fin w.length)
    (P : GeneratorWord.FirstCut W (S.arrow i)) (Q : GeneratorWord.FirstCut W (T.arrow i)) :
    (⟨P.source, P.target, P.arrow⟩ : Quiver.Total C) = ⟨Q.source, Q.target, Q.arrow⟩ ∧
      HEq P.left ((f.app (w.source i)).comp Q.left) ∧
        HEq (P.right.comp (f.app (w.target i))) Q.right :=
  Hammock.UnmarkedGenerators.column_firstCut_square W f i P Q

-- 選んだ切断でも、元の消去文字列の先頭と残りをそのまま回収する。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {X Y : C} (p : Quiver.Path X Y)
    (hp : GeneratorWord.erase W p ≠ []) :
    GeneratorWord.erase W p =
      ⟨(GeneratorWord.firstCut W p hp).source, (GeneratorWord.firstCut W p hp).target,
        (GeneratorWord.firstCut W p hp).arrow⟩ ::
          GeneratorWord.erase W (GeneratorWord.firstCut W p hp).right :=
  GeneratorWord.firstCut_erasure W (GeneratorWord.firstCut W p hp)

-- 任意可換環の実際の DK 入力の元の全自由次数で、切断を構成できる。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    {X Y : ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category}
    (p : X ⟶ Y) (hp : GeneratorWord.erase
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        p ≠ []) :
    GeneratorWord.FirstCut
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        p := GeneratorWord.firstCut _ p hp

-- Total 等式だけから固定生成矢での表示へ戻し、元の射列の因子化を保持する。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {X Y : C} {p : Quiver.Path X Y} (P : GeneratorWord.FirstCut W p)
    {a : Quiver.Total C} (h : (⟨P.source, P.target, P.arrow⟩ : Quiver.Total C) = a) :
    p = (GeneratorWord.FixedCut.ofFirstCut W P h).left.comp
      (a.hom.toPath.comp (GeneratorWord.FixedCut.ofFirstCut W P h).right) :=
  (GeneratorWord.FixedCut.ofFirstCut W P h).factorization

-- 固定列の圏は元の縦射をすべてそのまま保持する。
open CategoryTheory SerrePositivity.EInfinity in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (w : Hammock.Word) (X Y : Paths C) (i : Fin w.length)
    (a : Quiver.Total C) (P Q : Hammock.UnmarkedGenerators.ColumnCut W w X Y i a)
    (f : P.row ⟶ Q.row) :
    (Hammock.UnmarkedGenerators.ColumnCut.forget W w X Y i a).map
      (show P ⟶ Q from f) = f := rfl

-- 自然変換として元の列を同じ生成矢を挟む三段の合成で回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (w : Word) (X Y : Paths C) (i : Fin w.length) (a : Quiver.Total C) :
    UnmarkedGenerators.ColumnCut.prefixMap W w X Y i a ≫
      UnmarkedGenerators.ColumnCut.generatorMap W w X Y i a ≫
        UnmarkedGenerators.ColumnCut.residualMap W w X Y i a =
          UnmarkedGenerators.ColumnCut.columnMap W w X Y i a :=
  UnmarkedGenerators.ColumnCut.columnMap_factorization W w X Y i a

-- 元の全行・全縦射は、固定生成矢で切った圏から忘却すると同じ関手に戻る。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (i : Fin w.length)
    (h : UnmarkedGenerators.column W (τ.obj 0) i ≠ []) :
    UnmarkedGenerators.rowCutDiagram W τ i h ⋙
      UnmarkedGenerators.ColumnCut.forget W w X Y i (UnmarkedGenerators.rowGenerator W τ i h) = τ :=
  UnmarkedGenerators.rowCutDiagram_forget W τ i h

-- 接頭列と元の全縦射の指定性を保持する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (i : Fin w.length)
    (h : UnmarkedGenerators.column W (τ.obj 0) i ≠ [])
    {j k : Fin (n.unop.len + 1)} (f : j ⟶ k) :
    W.paths ((UnmarkedGenerators.rowPrefix W τ i h).app k) ∧
      W.paths ((UnmarkedGenerators.rowSource W τ i h).map f) ∧
        W.paths ((UnmarkedGenerators.rowTarget W τ i h).map f) :=
  ⟨UnmarkedGenerators.rowPrefix_mem W τ i h k,
    UnmarkedGenerators.rowSource_map_mem W τ i h f,
      UnmarkedGenerators.rowTarget_map_mem W τ i h f⟩

-- 任意可換環の元の全自由次数で、全行の元の列を同じ自然変換で回収する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n m : SimplexCategoryᵒᵖ)
    {w : Hammock.Word}
    {X Y : ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category}
    (τ : (Hammock.graph ((freeResolution
      (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).weakEquivalences w X Y).obj m)
    (i : Fin w.length) (h : Hammock.UnmarkedGenerators.column
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        (τ.obj 0) i ≠ []) :
    Hammock.UnmarkedGenerators.rowPrefix
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        τ i h ≫
    Hammock.UnmarkedGenerators.rowGeneratorMap
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        τ i h ≫
    Hammock.UnmarkedGenerators.rowResidual
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        τ i h =
    Hammock.UnmarkedGenerators.rowColumn
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        τ i h := Hammock.UnmarkedGenerators.rowColumn_factorization
          (freeResolutionGeneratorBase
            (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences τ i h

-- 任意の添字圏の持ち上げは元の全射を保って前合成に両立する。
open CategoryTheory SerrePositivity.EInfinity.Hammock SerrePositivity.EInfinity.SimplicialLocalization in
example {C I J : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} I] [Category.{e2ComplexLimitUniverse} J]
    (W : MorphismProperty C) (w : Word) (X Y : Paths C) (i : Fin w.length) (a : Quiver.Total C)
    (K : J ⥤ I) (F : I ⥤ Zigzag W.paths w X Y)
    (P : ∀ j, GeneratorWord.FixedCut W a ((F.obj j).arrow i)) :
    UnmarkedGenerators.ColumnCut.lift W w X Y i a (K ⋙ F) (fun j => P (K.obj j)) =
      K ⋙ UnmarkedGenerators.ColumnCut.lift W w X Y i a F P :=
  UnmarkedGenerators.ColumnCut.lift_precomp W w X Y i a K F P

-- 各対象で選んだ切断が違っても同じ持ち上げの関手になる。
open CategoryTheory SerrePositivity.EInfinity.Hammock SerrePositivity.EInfinity.SimplicialLocalization in
example {C I : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} I] (W : MorphismProperty C) (w : Word) (X Y : Paths C)
    (i : Fin w.length) (a : Quiver.Total C) (F : I ⥤ Zigzag W.paths w X Y)
    (P Q : ∀ j, GeneratorWord.FixedCut W a ((F.obj j).arrow i)) :
    UnmarkedGenerators.ColumnCut.lift W w X Y i a F P =
      UnmarkedGenerators.ColumnCut.lift W w X Y i a F Q :=
  UnmarkedGenerators.ColumnCut.lift_ext W w X Y i a F P Q

-- 再添字後の非空性も証明から供給し、元の単体作用素の前合成を厳密に回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n m : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (i : Fin w.length)
    (h : UnmarkedGenerators.column W (τ.obj 0) i ≠ []) (θ : n ⟶ m) :
    UnmarkedGenerators.rowCutDiagram W ((graph W.paths w X Y).map θ τ) i
        (UnmarkedGenerators.simplexColumn_ne_nil W τ i h θ) ⋙
      UnmarkedGenerators.ColumnCut.changeGenerator W w X Y i
        (UnmarkedGenerators.rowGenerator_simplex W τ i h θ
          (UnmarkedGenerators.simplexColumn_ne_nil W τ i h θ)) =
      UnmarkedGenerators.rowIndex θ ⋙ UnmarkedGenerators.rowCutDiagram W τ i h :=
  UnmarkedGenerators.rowCutDiagram_simplex W τ i h θ _

-- 接頭列の自然変換全体が元の全単体作用素に両立する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n m : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (i : Fin w.length)
    (h : UnmarkedGenerators.column W (τ.obj 0) i ≠ []) (θ : n ⟶ m)
    (hθ : UnmarkedGenerators.column W (((graph W.paths w X Y).map θ τ).obj 0) i ≠ []) :
    HEq (UnmarkedGenerators.rowPrefix W ((graph W.paths w X Y).map θ τ) i hθ)
      (Functor.whiskerLeft (UnmarkedGenerators.rowIndex θ) (UnmarkedGenerators.rowPrefix W τ i h)) :=
  UnmarkedGenerators.rowPrefix_simplex W τ i h θ hθ

-- 同じ単体作用素で生成矢・残り・元の列の自然変換も同時に保持する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n m : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (i : Fin w.length)
    (h : UnmarkedGenerators.column W (τ.obj 0) i ≠ []) (θ : n ⟶ m)
    (hθ : UnmarkedGenerators.column W (((graph W.paths w X Y).map θ τ).obj 0) i ≠ []) :
    HEq (UnmarkedGenerators.rowGeneratorMap W ((graph W.paths w X Y).map θ τ) i hθ)
      (Functor.whiskerLeft (UnmarkedGenerators.rowIndex θ)
        (UnmarkedGenerators.rowGeneratorMap W τ i h)) ∧
    HEq (UnmarkedGenerators.rowResidual W ((graph W.paths w X Y).map θ τ) i hθ)
      (Functor.whiskerLeft (UnmarkedGenerators.rowIndex θ)
        (UnmarkedGenerators.rowResidual W τ i h)) ∧
    HEq (UnmarkedGenerators.rowColumn W ((graph W.paths w X Y).map θ τ) i hθ)
      (Functor.whiskerLeft (UnmarkedGenerators.rowIndex θ)
        (UnmarkedGenerators.rowColumn W τ i h)) :=
  ⟨UnmarkedGenerators.rowGeneratorMap_simplex W τ i h θ hθ,
    UnmarkedGenerators.rowResidual_simplex W τ i h θ hθ,
      UnmarkedGenerators.rowColumn_simplex W τ i h θ hθ⟩

-- 任意可換環の元の各自由次数に、全単体作用素への同じ自然性を代入する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n m k : SimplexCategoryᵒᵖ)
    {w : Hammock.Word}
    {X Y : ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category}
    (τ : (Hammock.graph ((freeResolution
      (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).weakEquivalences w X Y).obj m)
    (i : Fin w.length) (h : Hammock.UnmarkedGenerators.column
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        (τ.obj 0) i ≠ []) (θ : m ⟶ k)
    (hθ : Hammock.UnmarkedGenerators.column
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        (((Hammock.graph ((freeResolution
          (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).weakEquivalences w X Y).map θ τ).obj 0)
            i ≠ []) :
    HEq (Hammock.UnmarkedGenerators.rowColumn
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        ((Hammock.graph ((freeResolution
          (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).weakEquivalences w X Y).map θ τ) i hθ)
      (Functor.whiskerLeft (Hammock.UnmarkedGenerators.rowIndex θ)
        (Hammock.UnmarkedGenerators.rowColumn
          (freeResolutionGeneratorBase
            (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences τ i h)) :=
  Hammock.UnmarkedGenerators.rowColumn_simplex
    (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
      τ i h θ hθ

-- 任意の列の元の番号と向きを保持して、元の語そのものに貼り戻す。
open SerrePositivity.EInfinity.Hammock in
example (w : Word) (p : Fin w.length) :
    Word.ColumnSplit.whole w p = w ∧
      Fin.cast (Word.ColumnSplit.whole_length w p)
        (((0 : Fin 1).natAdd (Word.ColumnSplit.before w p).length).castAdd
          (Word.ColumnSplit.after w p).length) = p :=
  ⟨Word.ColumnSplit.whole_eq w p, Word.ColumnSplit.middle_column_cast w p⟩

-- 一列だけの場合、向きによらず前後の語はともに空である。
open SerrePositivity.EInfinity.Hammock in
example (d : Direction) :
    Word.ColumnSplit.before (Word.single d) (0 : Fin 1) = Word.empty ∧
      Word.ColumnSplit.after (Word.single d) (0 : Fin 1) = Word.empty :=
  ⟨Word.ColumnSplit.before_first_empty _ _ rfl, Word.ColumnSplit.after_last_empty _ _ rfl⟩

-- 両端も動く任意の元の図式を切って貼り戻し、元の全対象と全縦射の図式を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] {W : MorphismProperty C} [W.IsMultiplicative]
    {w : Word} {A B : D ⥤ C} (p : Fin w.length) (F : Zigzag.MovingDiagram D C W w A B) :
    Zigzag.MovingDiagram.ColumnSplit.recombine p F = F :=
  Zigzag.MovingDiagram.ColumnSplit.recombine_eq p F

-- 元の固定端点の関手も同じ全射の関手に戻る。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] {W : MorphismProperty C} [W.IsMultiplicative]
    {w : Word} {X Y : C} (p : Fin w.length) (F : D ⥤ Zigzag W w X Y) :
    Zigzag.MovingDiagram.ColumnSplit.recombinedFunctor p F = F :=
  Zigzag.MovingDiagram.ColumnSplit.recombinedFunctor_eq p F

-- 最初の非指定列より前の全語は、全行・全縦射で指定射列を保つ。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (h : ∃ j, UnmarkedGenerators.column W (τ.obj 0) j ≠ [])
    {k l : Fin (n.unop.len + 1)} (f : k ⟶ l)
    (j : Fin (Word.ColumnSplit.before w (UnmarkedGenerators.firstColumn W (τ.obj 0) h)).length) :
    W.paths (((UnmarkedGenerators.beforeFirstColumn W τ h).obj k).arrow j) ∧
      W.paths (((UnmarkedGenerators.beforeFirstColumn W τ h).map f).app j.castSucc) :=
  ⟨UnmarkedGenerators.beforeFirstColumn_arrow_mem W τ h k j,
    UnmarkedGenerators.beforeFirstColumn_map_mem W τ h f j.castSucc⟩

-- 任意可換環の元の全自由次数で、元の全行の関手を任意の列で切って回収する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n m : SimplexCategoryᵒᵖ)
    {w : Hammock.Word}
    {X Y : ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category}
    (τ : (Hammock.graph ((freeResolution
      (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).weakEquivalences w X Y).obj m)
    (p : Fin w.length) : Hammock.Zigzag.MovingDiagram.ColumnSplit.recombinedFunctor p τ = τ :=
  Hammock.Zigzag.MovingDiagram.ColumnSplit.recombinedFunctor_eq p τ

-- 前後の接合点は元の列の両端の評価関手に、全射まで含めて一致する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] {W : MorphismProperty C} [W.IsMultiplicative]
    {w : Word} {A B : D ⥤ C} (p : Fin w.length) (F : Zigzag.MovingDiagram D C W w A B) :
    Zigzag.MovingDiagram.ColumnSplit.sourceJoint p F = F.evaluation p.castSucc ∧
      Zigzag.MovingDiagram.ColumnSplit.targetJoint p F = F.evaluation p.succ :=
  ⟨Zigzag.MovingDiagram.ColumnSplit.sourceJoint_eq p F,
    Zigzag.MovingDiagram.ColumnSplit.targetJoint_eq p F⟩

-- 前後へ接続した内部の三射は、元の列の同じ自然変換を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (i : Fin w.length)
    (h : UnmarkedGenerators.column W (τ.obj 0) i ≠ []) :
    UnmarkedGenerators.Attachments.leftAttachment W τ i h ≫
      UnmarkedGenerators.rowGeneratorMap W τ i h ≫
        UnmarkedGenerators.Attachments.rightAttachment W τ i h =
    eqToHom (UnmarkedGenerators.Attachments.sourceJoint_eq_rowSource W τ i h) ≫
      UnmarkedGenerators.rowColumn W τ i h ≫
        eqToHom (UnmarkedGenerators.Attachments.targetJoint_eq_rowTarget W τ i h).symm :=
  UnmarkedGenerators.Attachments.attachment_factorization W τ i h

-- 指定部分圏の実際の hammock 単体を元の包含で戻すと元の prefix の全行に一致する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (h : ∃ j, UnmarkedGenerators.column W (τ.obj 0) j ≠ []) :
    (nerveMap (Zigzag.Relative.functor (MarkedZigzag.inclusion W.paths))).app n
      (UnmarkedGenerators.AttachedPrefix.markedSimplex W τ h) =
        UnmarkedGenerators.AttachedPrefix.functor W τ h :=
  UnmarkedGenerators.AttachedPrefix.markedSimplex_inclusion W τ h

-- 列内部の接頭射を接続した prefix の全列と全縦射も指定射列である。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (h : ∃ j, UnmarkedGenerators.column W (τ.obj 0) j ≠ [])
    {k l : Fin (n.unop.len + 1)} (f : k ⟶ l)
    (j : Fin (Word.append (Word.ColumnSplit.before w
      (UnmarkedGenerators.AttachedPrefix.index W τ h)) (Word.single .forward)).length) :
    W.paths (((UnmarkedGenerators.AttachedPrefix.diagram W τ h).obj k).arrow j) ∧
      W.paths (((UnmarkedGenerators.AttachedPrefix.diagram W τ h).map f).app j.castSucc) :=
  ⟨UnmarkedGenerators.AttachedPrefix.arrow_mem W τ h k j,
    UnmarkedGenerators.AttachedPrefix.map_mem W τ h f j.castSucc⟩

-- 任意の全指定図式の持ち上げは、元の包含で全対象・全射の関手に厳密に戻る。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] (W : MorphismProperty C) [W.IsMultiplicative]
    {w : Word} {X Y : C} (F : D ⥤ Zigzag W w X Y) (hF : ∀ d j, W ((F.obj d).arrow j)) :
    MarkedZigzag.liftFunctor W F hF ⋙ Zigzag.Relative.functor (MarkedZigzag.inclusion W) = F :=
  MarkedZigzag.liftFunctor_inclusion W F hF

-- 任意可換環の元の全自由次数で、同じ指定部分圏からの prefix の回収を検証する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n m : SimplexCategoryᵒᵖ)
    {w : Hammock.Word}
    {X Y : ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category}
    (τ : (Hammock.graph ((freeResolution
      (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).weakEquivalences w X Y).obj m)
    (h : ∃ j, Hammock.UnmarkedGenerators.column
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        (τ.obj 0) j ≠ []) :
    Hammock.UnmarkedGenerators.AttachedPrefix.markedFunctor
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        τ h ⋙
      Hammock.Zigzag.Relative.functor (Hammock.MarkedZigzag.inclusion
        (freeResolutionGeneratorBase
          (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences.paths) =
    Hammock.UnmarkedGenerators.AttachedPrefix.functor
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        τ h := Hammock.UnmarkedGenerators.AttachedPrefix.markedFunctor_inclusion
          (freeResolutionGeneratorBase
            (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences τ h


-- 元の三列 collapse の両端の cut を保持する。
open SerrePositivity.EInfinity.Hammock in
example : Word.ForwardTriple.collapse.cut 0 = (0 : Fin 4) ∧
    Word.ForwardTriple.collapse.cut (Fin.last 1) = (Fin.last 3 : Fin 4) :=
  ⟨Word.ForwardTriple.cut_zero, Word.ForwardTriple.cut_last⟩

-- 元の三射の連結を、元の WordAction で同じ合成射へ戻す。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) [W.IsMultiplicative] {X Y Z V : C}
    (e : X ⟶ Y) (f : Y ⟶ Z) (g : Z ⟶ V) :
    WordAction.obj Word.ForwardTriple.collapse (ForwardTriple.append (W := W) e f g) =
      ForwardZigzag.obj (e ≫ f ≫ g) := ForwardTriple.collapse_append e f g

-- 端点も動く縦射の合成を元の語の作用が保持する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) [W.IsMultiplicative] {a b : Word} (f : a ⟶ b)
    {X Y X' Y' X'' Y'' : C} {S : Zigzag W a X Y} {T : Zigzag W a X' Y'}
    {U : Zigzag W a X'' Y''} (g : Zigzag.MovingHom S T) (h : Zigzag.MovingHom T U) :
    WordAction.movingMap f (g.comp h) =
      (WordAction.movingMap f g).comp (WordAction.movingMap f h) :=
  WordAction.movingMap_comp f g h

-- 固定端点では既存の元の WordAction.functor と厳密に一致する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] (W : MorphismProperty C) [W.IsMultiplicative]
    {a b : Word} (f : a ⟶ b) {X Y : C}
    (F : Zigzag.MovingDiagram D C W a ((Functor.const D).obj X) ((Functor.const D).obj Y)) :
    (Zigzag.MovingDiagram.wordAction f F).fixedFunctor =
      F.fixedFunctor ⋙ WordAction.functor f := Zigzag.MovingDiagram.wordAction_fixedFunctor f F

-- 内部切断の全三列は元の同じ列の全図式を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (i : Fin w.length)
    (h : UnmarkedGenerators.column W (τ.obj 0) i ≠ []) :
    Zigzag.MovingDiagram.wordAction Word.ForwardTriple.collapse
      (((UnmarkedGenerators.Attachments.leftBlock W τ i h).append
        (UnmarkedGenerators.Attachments.generatorBlock W τ i h)).append
          (UnmarkedGenerators.Attachments.rightBlock W τ i h)) =
      UnmarkedGenerators.Attachments.collapsedColumnDiagram W τ i h :=
  UnmarkedGenerators.Attachments.collapse_blocks W τ i h

-- 任意可換環の実際の自由解像の各次数にも、同じ局所回収を適用する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n m : SimplexCategoryᵒᵖ)
    {w : Hammock.Word}
    {X Y : ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category}
    (τ : (Hammock.graph ((freeResolution
      (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).weakEquivalences w X Y).obj m)
    (i : Fin w.length)
    (h : Hammock.UnmarkedGenerators.column
      (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
        (τ.obj 0) i ≠ []) :
    let W := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    Hammock.Zigzag.MovingDiagram.wordAction Hammock.Word.ForwardTriple.collapse
      (((Hammock.UnmarkedGenerators.Attachments.leftBlock W τ i h).append
        (Hammock.UnmarkedGenerators.Attachments.generatorBlock W τ i h)).append
          (Hammock.UnmarkedGenerators.Attachments.rightBlock W τ i h)) =
      Hammock.UnmarkedGenerators.Attachments.collapsedColumnDiagram W τ i h :=
  Hammock.UnmarkedGenerators.Attachments.collapse_blocks
    (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences τ i h


-- 動く接合点の全図式で、元の圧縮と連結を交換する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] (W : MorphismProperty C) [W.IsMultiplicative]
    {a b a' b' : Word} {A B E : D ⥤ C} (f : a ⟶ a') (g : b ⟶ b')
    (F : Zigzag.MovingDiagram D C W a A B) (G : Zigzag.MovingDiagram D C W b B E) :
    Zigzag.MovingDiagram.wordAction (Word.appendMap f g) (F.append G) =
      (Zigzag.MovingDiagram.wordAction f F).append (Zigzag.MovingDiagram.wordAction g G) :=
  Zigzag.MovingDiagram.wordAction_append f g F G

-- 空語を許す任意の三つの語の結合則を全図式で検証する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] (W : MorphismProperty C) [W.IsMultiplicative]
    {a b c : Word} {A B E L : D ⥤ C} (F : Zigzag.MovingDiagram D C W a A B)
    (G : Zigzag.MovingDiagram D C W b B E) (H : Zigzag.MovingDiagram D C W c E L) :
    Zigzag.MovingDiagram.changeWord (Word.append_assoc a b c) ((F.append G).append H) =
      F.append (G.append H) := Zigzag.MovingDiagram.changeWord_append_assoc F G H

-- 元の τ の全行・全縦射を元の同じ語へ回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (i : Fin w.length)
    (h : UnmarkedGenerators.column W (τ.obj 0) i ≠ []) :
    UnmarkedGenerators.Attachments.refinedFunctor W τ i h ⋙
      WordAction.functor (UnmarkedGenerators.Attachments.refinementMap W τ i h) = τ :=
  UnmarkedGenerators.Attachments.refinedFunctor_recovery W τ i h

-- 元の Word 図式自身の作用で refined 単体を同じ τ に戻す。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (i : Fin w.length)
    (h : UnmarkedGenerators.column W (τ.obj 0) i ≠ []) :
    ((graphDiagram W.paths X Y).map
      (UnmarkedGenerators.Attachments.refinementMap W τ i h)).app n
        (UnmarkedGenerators.Attachments.refinedSimplex W τ i h) = τ :=
  UnmarkedGenerators.Attachments.refinedSimplex_recovery W τ i h

-- 元の余極限の標準射は同じ元の単体の像を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (i : Fin w.length)
    (h : UnmarkedGenerators.column W (τ.obj 0) i ≠ []) :
    (graphInclusion W.paths X Y (UnmarkedGenerators.Attachments.refinedWord w i)).app n
      (UnmarkedGenerators.Attachments.refinedSimplex W τ i h) =
        (graphInclusion W.paths X Y w).app n τ :=
  UnmarkedGenerators.Attachments.refinedSimplex_inclusion W τ i h

-- 任意可換環の実際の全自由次数で元の全図式の回収を検証する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n m : SimplexCategoryᵒᵖ)
    {w : Hammock.Word}
