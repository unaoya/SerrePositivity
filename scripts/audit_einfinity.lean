example : edgeComponent ℤ 2 0 (generator ℤ (n := 2) (d := 0) (![0, 0] : Fin 2 → Fin 2)) = 0 := by
  have hn : ¬ Function.Surjective (![0, 0] : Fin 2 → Fin 2) := by decide
