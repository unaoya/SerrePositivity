  (MarkedSpine.localizationHomEquiv W X Y).symm_apply_apply p

-- 同じ単体的 Hom 同型の順射は元の valueToLocalization の射写像。
open CategoryTheory SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
