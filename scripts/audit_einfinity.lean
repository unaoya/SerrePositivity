    (FirstFactor.inclusion W X Y w ≫ (FirstFactor.nonemptyIso W X Y).hom) ≫
      FirstFactor.nonemptyCut W X Y = FirstFactor.cutMap W w X Y :=
  FirstFactor.inclusion_nonemptyCut W X Y w

