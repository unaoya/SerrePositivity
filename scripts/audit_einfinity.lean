noncomputable section

-- 元の二方向 bar から元の全圏の nerve への射そのものを検査する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {W : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} W]
    (F : Wᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse})
    (G : W ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse}) :
    TwoSidedBar.space (F ⋙ nerveFunctor) (G ⋙ nerveFunctor) ⟶
      nerve (TwoSidedGrothendieck.total F G) := TwoSidedThomason.map F G

-- 元の全単体で底の全射列を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {W : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} W]
    (F : Wᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse})
    (G : W ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse}) (n : ℕ)
    (e : ComposableArrows (TwoSidedThomason.labels F G n) n) :
    TwoSidedThomason.simplex F G e ⋙ TwoSidedGrothendieck.projection =
      e ⋙ TwoSidedElements.projection _ _ := TwoSidedThomason.simplex_projection F G e

-- 元の左右の係数自然変換と元の比較射の厳密な正方形。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {W : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} W]
    {F F' : Wᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse}}
    {G G' : W ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse}} (α : F ⟶ F') (β : G ⟶ G') :
    TwoSidedThomason.map F G ≫ nerveMap (TwoSidedGrothendieck.coefficientMap α β) =
      TwoSidedBar.map (Functor.whiskerRight α nerveFunctor)
        (Functor.whiskerRight β nerveFunctor) ≫ TwoSidedThomason.map F' G' :=
  TwoSidedThomason.map_naturality α β

-- 任意の底の関手で元の比較射の正方形は厳密に可換。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {V W : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} V]
    [Category.{e2ComplexLimitUniverse} W] (H : V ⥤ W)
    (F : Wᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse})
    (G : W ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse}) :
    TwoSidedThomason.map (H.op ⋙ F) (H ⋙ G) ≫
      nerveMap (TwoSidedGrothendieck.baseChange H F G) =
        TwoSidedBar.baseChange H (F ⋙ nerveFunctor) (G ⋙ nerveFunctor) ≫
          TwoSidedThomason.map F G := TwoSidedThomason.map_baseChange H F G

-- 左を忘れると既存の一方向 Thomason 比較射そのものに戻る。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {W : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} W]
    (F : Wᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse})
    (G : W ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse}) :
    TwoSidedThomason.map F G ≫ nerveMap (TwoSidedThomason.forgetLeftTotal F G) =
      TwoSidedThomason.forgetLeftBar (F ⋙ nerveFunctor) (G ⋙ nerveFunctor) ≫
        SerrePositivity.EInfinity.FrameHom.Thomason.map G :=
  TwoSidedThomason.map_forgetLeft F G

-- 元の両ラベルの対角頂点を全次数でそのまま保持する。
open CategoryTheory Opposite SerrePositivity.EInfinity.Hammock in
example {W : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} W]
    (F : Wᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse})
    (G : W ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse}) (n : ℕ)
    (e : ComposableArrows (TwoSidedThomason.labels F G n) n) (i : Fin (n + 1)) :
    ((TwoSidedThomason.map F G).app (op (SimplexCategory.mk n)) e).obj i =
      TwoSidedGrothendieck.mk F G (e.obj i).base ((e.obj i).left.obj i)
        ((e.obj i).right.obj i) := TwoSidedThomason.map_vertex F G n e i

-- 任意可換環の実際の cofibrant 代数を底として同じ比較射を構成する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] :
    let C := (BarrattEccles.cofibrantAlgebraRelativeCategory R).category
    ∀ (F : Cᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse + 1, e2ComplexLimitUniverse + 1})
      (G : C ⥤ Cat.{e2ComplexLimitUniverse + 1, e2ComplexLimitUniverse + 1}),
      TwoSidedBar.space (F ⋙ nerveFunctor) (G ⋙ nerveFunctor) ⟶
        nerve (TwoSidedGrothendieck.total F G) := by
  intro C F G
  exact TwoSidedThomason.map F G

-- 任意可換環の元の全自由次数の augmentation の底の関手へ代入する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] :
    let C := BarrattEccles.cofibrantAlgebraRelativeCategory R
    ∀ (n : SimplexCategoryᵒᵖ)
      (F : C.categoryᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse + 1, e2ComplexLimitUniverse + 1})
      (G : C.category ⥤ Cat.{e2ComplexLimitUniverse + 1, e2ComplexLimitUniverse + 1}),
      let H := ((freeResolutionAugmentationNatTrans C).app n).functor
      TwoSidedThomason.map (H.op ⋙ F) (H ⋙ G) ≫
        nerveMap (TwoSidedGrothendieck.baseChange H F G) =
          TwoSidedBar.baseChange H (F ⋙ nerveFunctor) (G ⋙ nerveFunctor) ≫
            TwoSidedThomason.map F G := by
  intro C n F G H
  exact TwoSidedThomason.map_baseChange H F G

end

noncomputable section

-- 任意の二係数図式の元の比較射自身に追加条件を置かない。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {W : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} W]
    (F : Wᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse})
    (G : W ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse}) :
    IsWeakHomotopyEquivalence (TwoSidedThomason.map F G) :=
  TwoSidedThomason.map_isWeakHomotopyEquivalence F G

-- 任意の集合ラベルでも元の重み付き左射が弱同値。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {W : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} W]
    (F : Wᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse})
    (S : W ⥤ Type e2ComplexLimitUniverse) :
    IsWeakHomotopyEquivalence (TwoSidedWeightedLeft.map F S) :=
  TwoSidedWeightedLeft.map_isWeakHomotopyEquivalence F S

-- 既存の一方向定理を移した射は元の比較射そのもの。
open CategoryTheory SerrePositivity.EInfinity.Hammock SerrePositivity.KST.ProExcision in
example {W : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} W]
    (F : Wᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse})
    (S : W ⥤ Type e2ComplexLimitUniverse) :
    TwoSidedWeightedLeft.map F S = (TwoSidedWeightedLeftSource.spaceIso F S).hom ≫
      SSet.opFunctor.map
        (SerrePositivity.EInfinity.FrameHom.Thomason.map (TwoSidedMixedLabel.pulledDiagram F S)) ≫
      (nerveOppositeIso (Grothendieck (TwoSidedMixedLabel.pulledDiagram F S))).inv ≫
      nerveMap (TwoSidedMixedLabel.toMixed F S) := TwoSidedWeightedLeft.map_eq_transport F S

-- 全次数の対角を通した左射も同じ射の弱同値として得る。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {W : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} W]
    (F : Wᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse})
    (G : W ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse}) :
    IsWeakHomotopyEquivalence (TwoSidedWeightedLeft.diagonalMap F G) :=
  TwoSidedThomason.weightedLeft_diagonalMap_isWeakHomotopyEquivalence F G

-- その後の一方向比較との合成は元の二方向射と一致する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {W : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} W]
    (F : Wᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse})
    (G : W ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse}) :
    TwoSidedWeightedLeft.diagonalMap F G ≫ SerrePositivity.EInfinity.FrameHom.Thomason.map
      (TwoSidedGrothendieck.contravariantProjection F ⋙ G) = TwoSidedThomason.map F G :=
  TwoSidedThomason.weightedLeft_map_factorization F G

-- 始域は元の反転した一方向 bar と追加仮定なしに同型。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {W : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} W]
    (F : Wᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse})
    (S : W ⥤ Type e2ComplexLimitUniverse) :
    TwoSidedWeightedLeft.space F S ≅
      ((SerrePositivity.SimplicialModel.BarConstruction.functor S.Elementsᵒᵖ).obj
        (TwoSidedMixedLabel.pulledDiagram F S ⋙ nerveFunctor)).op :=
  TwoSidedWeightedLeftSource.spaceIso F S

-- 任意可換環の実際の cofibrant 代数圏にも元の弱同値を適用する。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity
  SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] :
    let C := (BarrattEccles.cofibrantAlgebraRelativeCategory R).category
    ∀ (F : Cᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse + 1, e2ComplexLimitUniverse + 1})
      (G : C ⥤ Cat.{e2ComplexLimitUniverse + 1, e2ComplexLimitUniverse + 1}),
      IsWeakHomotopyEquivalence (TwoSidedThomason.map F G) := by
  intro C F G
  exact TwoSidedThomason.map_isWeakHomotopyEquivalence F G

-- 元の自由分解の各底へ引いた図式にも同じ定理を適用する。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity
  SerrePositivity.EInfinity.Hammock SerrePositivity.EInfinity.SimplicialLocalization in
example (R : Type e2ComplexLimitUniverse) [CommRing R] :
    let C := BarrattEccles.cofibrantAlgebraRelativeCategory R
    ∀ (n : SimplexCategoryᵒᵖ)
      (F : C.categoryᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse + 1, e2ComplexLimitUniverse + 1})
      (G : C.category ⥤ Cat.{e2ComplexLimitUniverse + 1, e2ComplexLimitUniverse + 1}),
      let H := ((freeResolutionAugmentationNatTrans C).app n).functor
      IsWeakHomotopyEquivalence (TwoSidedThomason.map (H.op ⋙ F) (H ⋙ G)) := by
  intro C n F G H
  exact TwoSidedThomason.map_isWeakHomotopyEquivalence (H.op ⋙ F) (H ⋙ G)

end

noncomputable section

-- 元の底と両係数を同時に変えた比較の正方形。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {V W : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} V]
    [Category.{e2ComplexLimitUniverse} W] (H : V ⥤ W)
    {F : Vᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse}}
    {G : V ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse}}
    {F' : Wᵒᵖ ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse}}
    {G' : W ⥤ Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse}}
    (α : F ⟶ H.op ⋙ F') (β : G ⟶ H ⋙ G') :
    TwoSidedThomason.map F G ≫ nerveMap (TwoSidedThomason.transitionTotal H α β) =
      TwoSidedThomason.transitionBar H α β ≫ TwoSidedThomason.map F' G' :=
  TwoSidedThomason.map_transition H α β

-- 元の底が全次数で動いても対角 Thomason 射は弱同値。
open CategoryTheory SerrePositivity.InfinityCategories
  SerrePositivity.EInfinity.Hammock.TwoSidedDiagram in
example (D : SimplicialObject Data.{e2ComplexLimitUniverse}) :
    IsWeakHomotopyEquivalence (diagonalThomasonMap D) :=
  diagonalThomasonMap_isWeakHomotopyEquivalence D

-- 元の自然変換の対角正方形をそのまま保持する。
open CategoryTheory SerrePositivity.EInfinity.Hammock.TwoSidedDiagram in
example {D E : SimplicialObject Data.{e2ComplexLimitUniverse}} (τ : D ⟶ E) :
    diagonalThomasonMap D ≫ diagonalTotalMap τ =
      diagonalBarMap τ ≫ diagonalThomasonMap E := diagonalThomasonMap_naturality τ

-- 同じ射の弱同値性を全圏と bar の間で双方向に移す。
open CategoryTheory SerrePositivity.InfinityCategories
  SerrePositivity.EInfinity.Hammock.TwoSidedDiagram in
example {D E : SimplicialObject Data.{e2ComplexLimitUniverse}} (τ : D ⟶ E) :
    IsWeakHomotopyEquivalence (diagonalTotalMap τ) ↔
      IsWeakHomotopyEquivalence (diagonalBarMap τ) := diagonalMap_weak_iff τ

-- 通常の各次数の弱同値を仮定せず、固定射列長の部分対角を使う。
open CategoryTheory SerrePositivity.InfinityCategories
  SerrePositivity.EInfinity.Hammock.TwoSidedDiagram in
example {D E : SimplicialObject Data.{e2ComplexLimitUniverse}} (τ : D ⟶ E)
    (h : ∀ n, IsWeakHomotopyEquivalence (chainRowMap τ n)) :
    IsWeakHomotopyEquivalence (diagonalTotalMap τ) := diagonalTotalMap_weak_of_chainRows τ h

-- 実際の transfunctor の係数自然変換から全作用素の自然変換を構成する。
open CategoryTheory SerrePositivity.EInfinity.Hammock.Transfunctor in
example {B : SimplicialObject Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse}}
    {L L' : Covariant (B ⋙ Cat.opFunctor)} {R R' : Covariant B}
    (α : L ⟶ L') (β : R ⟶ R') :
    twoSidedDiagram B L R ⟶ twoSidedDiagram B L' R' := twoSidedDiagramMap α β

-- 固定対象の元の表示と作用素を保つ係数図式を構成する。
open CategoryTheory SerrePositivity.EInfinity.Hammock.Transfunctor in
example (B : SimplicialObject Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse})
    (p : (n : SimplexCategoryᵒᵖ) → B.obj n)
    (hp : ∀ {n m : SimplexCategoryᵒᵖ} (θ : n ⟶ m), (B.map θ).toFunctor.obj (p n) = p m)
    (T : Covariant B) : SimplicialObject Cat.{e2ComplexLimitUniverse, e2ComplexLimitUniverse} :=
  objectDiagram B p hp T

-- 任意可換環の実際の自由相対解像の底に全次数の比較を代入する。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity
  SerrePositivity.EInfinity.SimplicialLocalization SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] :
    let C := BarrattEccles.cofibrantAlgebraRelativeCategory R
    let B := freeResolutionUnderlyingDiagram C
    ∀ (L : Transfunctor.Covariant (B ⋙ Cat.opFunctor)) (T : Transfunctor.Covariant B),
      IsWeakHomotopyEquivalence
        (TwoSidedDiagram.diagonalThomasonMap (Transfunctor.twoSidedDiagram B L T)) := by
  intro C B L T
  exact TwoSidedDiagram.diagonalThomasonMap_isWeakHomotopyEquivalence _

end

noncomputable section

-- 任意長の元の射列を隣接 Hom 座標から厳密に回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (k : ℕ) (c : ComposableArrows C k) :
    (ChainCoordinates.equivalence k).symm (ChainCoordinates.equivalence k c) = c :=
  (ChainCoordinates.equivalence k).symm_apply_apply c

-- 底と両係数を同時に動かした元の座標の正方形。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] (H : C ⥤ D)
    {A : Cᵒᵖ ⥤ Type e2ComplexLimitUniverse} {B : C ⥤ Type e2ComplexLimitUniverse}
    {A' : Dᵒᵖ ⥤ Type e2ComplexLimitUniverse} {B' : D ⥤ Type e2ComplexLimitUniverse}
    (α : A ⟶ H.op ⋙ A') (β : B ⟶ H ⋙ B') (k : ℕ)
    (e : ComposableArrows (TwoSidedElements.Element A B) k) :
    LabelledChainCoordinates.equivalence A' B' k
      (e ⋙ TwoSidedElements.map α β ⋙ TwoSidedElements.pre H A' B') =
        LabelledChainCoordinates.map H α β (LabelledChainCoordinates.equivalence A B k e) :=
  LabelledChainCoordinates.equivalence_map H α β e

-- 固定頂点の表示等式を含む元の復元の自然性。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {O C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] (p : O ≃ C) (q : O ≃ D) (H : C ⥤ D)
    {A : Cᵒᵖ ⥤ Type e2ComplexLimitUniverse} {B : C ⥤ Type e2ComplexLimitUniverse}
    {A' : Dᵒᵖ ⥤ Type e2ComplexLimitUniverse} {B' : D ⥤ Type e2ComplexLimitUniverse}
    (α : A ⟶ H.op ⋙ A') (β : B ⟶ H ⋙ B') (hp : ∀ o, H.obj (p o) = q o)
    (k : ℕ) (x : Fin (k + 1) → O) (v : FixedVertexChainCoordinates.Fiber p A B k x) :
    FixedVertexChainCoordinates.decode p A B k x v ⋙ TwoSidedElements.map α β ⋙
        TwoSidedElements.pre H A' B' =
      FixedVertexChainCoordinates.decode q A' B' k x
        (FixedVertexChainCoordinates.fiberMap q H α β hp x v) :=
  FixedVertexChainCoordinates.decode_naturality q H α β hp x v

-- 任意個数の有限 Hom 因子の元の比較射自身の弱同値性。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {k : ℕ} {A B : Fin k → SSet.{e2ComplexLimitUniverse}} (η : ∀ i, A i ⟶ B i)
    (hη : ∀ i, IsWeakHomotopyEquivalence (η i)) :
    IsWeakHomotopyEquivalence (FiniteProduct.map η) := FiniteProduct.map_weak η hη

-- 空積も追加条件なく含める。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {A B : Fin 0 → SSet.{e2ComplexLimitUniverse}} (η : ∀ i, A i ⟶ B i) :
    IsWeakHomotopyEquivalence (FiniteProduct.map η) :=
  FiniteProduct.map_weak η (fun i => Fin.elim0 i)

-- 全次数で動く元の底でも元の部分対角を Hom 積の和へ厳密に戻す。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example (D : SimplicialObject TwoSidedDiagram.Data.{e2ComplexLimitUniverse})
    {O : Type e2ComplexLimitUniverse} (p : (n : SimplexCategoryᵒᵖ) → O ≃ (D.obj n).base)
    (hp : ∀ {n m : SimplexCategoryᵒᵖ} (θ : n ⟶ m) (o : O),
      (D.map θ).base.obj (p n o) = p m o) (k : SimplexCategoryᵒᵖ) :
    TwoSidedDiagram.chainRow D k ≅
      IndexedSum.space (TwoSidedDiagram.FixedVertices.product D p hp k) :=
  TwoSidedDiagram.FixedVertices.productsIso D p hp k

-- 各固定頂点列の元の作用素を、内在的な Hom と両係数の対角で照合する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example (D : SimplicialObject TwoSidedDiagram.Data.{e2ComplexLimitUniverse})
    {O : Type e2ComplexLimitUniverse} (p : (n : SimplexCategoryᵒᵖ) → O ≃ (D.obj n).base)
    (hp : ∀ {n m : SimplexCategoryᵒᵖ} (θ : n ⟶ m) (o : O),
      (D.map θ).base.obj (p n o) = p m o) (k : SimplexCategoryᵒᵖ)
    (x : Fin (k.unop.len + 1) → O) :
    TwoSidedDiagram.FixedVertices.fiberSpace D p hp k x ≅
      TwoSidedDiagram.FixedVertices.product D p hp k x :=
  TwoSidedDiagram.FixedVertices.productIso D p hp k x

-- 任意可換環の実際の自由相対解像と標準の対象表示をそのまま代入する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] :
    let C := BarrattEccles.cofibrantAlgebraRelativeCategory R
    let B := freeResolutionUnderlyingDiagram C
    ∀ (L : Transfunctor.Covariant (B ⋙ Cat.opFunctor)) (T : Transfunctor.Covariant B)
      (k : SimplexCategoryᵒᵖ),
      let D := Transfunctor.twoSidedDiagram B L T
      let p := fun n => (freeResolutionObjectEquiv C n).symm
      let hp := fun {n m} (θ : n ⟶ m) o => freeResolutionObject_naturality C θ o
      TwoSidedDiagram.chainRow D k ≅
        IndexedSum.space (TwoSidedDiagram.FixedVertices.product D p hp k) := by
  intro C B L T k D p hp
  exact TwoSidedDiagram.FixedVertices.productsIso D p hp k

end

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
section e2TwoSidedWeakFixtures
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock
open SerrePositivity.EInfinity.Hammock.TwoSidedDiagram
open SerrePositivity.EInfinity.Hammock.TwoSidedDiagram.FixedVertices

variable {D E : SimplicialObject Data.{e2ComplexLimitUniverse}} {O : Type e2ComplexLimitUniverse}
  (p : (n : SimplexCategoryᵒᵖ) → O ≃ (D.obj n).base)
  (q : (n : SimplexCategoryᵒᵖ) → O ≃ (E.obj n).base)
  (hp : ∀ {n m : SimplexCategoryᵒᵖ} (θ : n ⟶ m) (o : O),
    (D.map θ).base.obj (p n o) = p m o)
  (hq : ∀ {n m : SimplexCategoryᵒᵖ} (θ : n ⟶ m) (o : O),
    (E.map θ).base.obj (q n o) = q m o)
  (τ : D ⟶ E) (hτ : ∀ n o, (τ.app n).base.obj (p n o) = q n o)
include p q hp hq hτ

-- 元の chainRowMap は元の Hom・両係数の直積の和そのもの。
example (k : SimplexCategoryᵒᵖ) :
    (productsIso D p hp k).inv ≫ chainRowMap τ k =
      IndexedSum.map (productMap p q hp hq τ hτ k) ≫ (productsIso E q hq k).inv :=
  productsIso_inv_naturality p q hp hq τ hτ k

-- 各通常次数の弱同値性を要求せず、固定 Hom と係数の対角で判定する。
example (hH : ∀ X Y, IsWeakHomotopyEquivalence (homSpaceMap p q hp hq τ hτ X Y))
    (hL : ∀ X, IsWeakHomotopyEquivalence (leftSpaceMap p q hp hq τ hτ X))
    (hR : ∀ X, IsWeakHomotopyEquivalence (rightSpaceMap p q hp hq τ hτ X))
    (k : SimplexCategoryᵒᵖ) : IsWeakHomotopyEquivalence (chainRowMap τ k) :=
  chainRowMap_weak p q hp hq τ hτ hH hL hR k

-- 元の全圏の対角射自身を同じ三つの入力で閉じる。
example (hH : ∀ X Y, IsWeakHomotopyEquivalence (homSpaceMap p q hp hq τ hτ X Y))
    (hL : ∀ X, IsWeakHomotopyEquivalence (leftSpaceMap p q hp hq τ hτ X))
    (hR : ∀ X, IsWeakHomotopyEquivalence (rightSpaceMap p q hp hq τ hτ X)) :
    IsWeakHomotopyEquivalence (diagonalTotalMap τ) :=
  diagonalTotalMap_weak p q hp hq τ hτ hH hL hR

-- 固定底を含む充満忠実な底では元の係数の対角だけを要求する。
example (hF : ∀ n, (τ.app n).base.FullyFaithful)
    (hL : ∀ X, IsWeakHomotopyEquivalence (leftSpaceMap p q hp hq τ hτ X))
    (hR : ∀ X, IsWeakHomotopyEquivalence (rightSpaceMap p q hp hq τ hτ X)) :
    IsWeakHomotopyEquivalence (diagonalTotalMap τ) :=
  diagonalTotalMap_weak_of_fullyFaithful_base p q hp hq τ hτ hF hL hR

-- 恒等係数を含む同型係数では、底の実際の Hom 弱比較だけを要求する。
example (hH : ∀ X Y, IsWeakHomotopyEquivalence (homSpaceMap p q hp hq τ hτ X Y))
    (hL : ∀ n X, IsIso ((τ.app n).left.app (Opposite.op (p n X))))
    (hR : ∀ n X, IsIso ((τ.app n).right.app (p n X))) :
    IsWeakHomotopyEquivalence (diagonalTotalMap τ) :=
  diagonalTotalMap_weak_of_isIso_coefficients p q hp hq τ hτ hH hL hR

-- 充満忠実性から得る同型も元の同じ Hom 比較射を回収する。
example (hF : ∀ n, (τ.app n).base.FullyFaithful) (X Y : O) :
    (homSpaceIso p q hp hq τ hτ hF X Y).hom = homSpaceMap p q hp hq τ hτ X Y :=
  homSpaceIso_hom p q hp hq τ hτ hF X Y

-- 各係数圏の同型から元の対角の射自身の弱同値性を回収する。
example (X : O) (hL : ∀ n, IsIso ((τ.app n).left.app (Opposite.op (p n X))))
    (hR : ∀ n, IsIso ((τ.app n).right.app (p n X))) :
    IsWeakHomotopyEquivalence (leftSpaceMap p q hp hq τ hτ X) ∧
      IsWeakHomotopyEquivalence (rightSpaceMap p q hp hq τ hτ X) :=
  ⟨leftSpaceMap_weak_of_isIso p q hp hq τ hτ X hL,
    rightSpaceMap_weak_of_isIso p q hp hq τ hτ X hR⟩
end e2TwoSidedWeakFixtures

-- 任意可換環の実際の自由解像で、元の全係数自然変換を固定底定理へ代入する。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity
  SerrePositivity.EInfinity.SimplicialLocalization SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] :
    let C := BarrattEccles.cofibrantAlgebraRelativeCategory R
    let B := freeResolutionUnderlyingDiagram C
    ∀ {L L' : Transfunctor.Covariant (B ⋙ Cat.opFunctor)} {T T' : Transfunctor.Covariant B}
      (α : L ⟶ L') (β : T ⟶ T'),
      let D := Transfunctor.twoSidedDiagram B L T
      let E := Transfunctor.twoSidedDiagram B L' T'
      let τ : D ⟶ E := Transfunctor.twoSidedDiagramMap α β
      let p : (n : SimplexCategoryᵒᵖ) → C.category ≃ B.obj n :=
        fun n => (freeResolutionObjectEquiv C n).symm
      let hp : ∀ {n m : SimplexCategoryᵒᵖ} (θ : n ⟶ m) o,
          (B.map θ).toFunctor.obj (p n o) = p m o :=
        fun θ o => freeResolutionObject_naturality C θ o
      (∀ X, IsWeakHomotopyEquivalence
