    let W := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    FirstFactor.extraction W Y X ≫ FirstFactor.MarkedSpine.wordValue W Y X = colimitValue W X Y :=
  FirstFactor.extraction_wordValue (freeResolutionGeneratorBase
    (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences Y X


-- 元の三因子の貼り戻しは同じ元の単体の標準射へ戻る。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {w : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (τ : (graph W.paths w X Y).obj n) (h : ∃ j, column W (τ.obj 0) j ≠ []) :
    (FactorTarget.paste W X Y).app n (FirstFactor.point W τ h) =
      (graphInclusion W.paths X Y w).app n τ := FirstFactor.paste_point W τ h

-- 実際の非空部分の切断と貼り戻しで元の包含自身を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (X Y : Paths C) :
    FirstFactor.nonemptyCut W X Y ≫ FactorTarget.paste W X Y = NonemptyValue.inclusion W X Y :=
  FirstFactor.nonemptyCut_paste W X Y

-- 貼り戻しは元の全指定因子・同じ生成矢の全単体作用素に自然である。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (Y X : Paths C) {n m : SimplexCategoryᵒᵖ} (θ : n ⟶ m)
    (t : FirstFactor.MarkedSpine W Y n X) :
    FirstFactor.MarkedSpine.glue (FirstFactor.MarkedSpine.map θ t) =
      (colimitGraph W.paths X Y).map θ (FirstFactor.MarkedSpine.glue t) :=
  FirstFactor.MarkedSpine.glue_simplex θ t

-- 元の全 hammock で反復抽出の後の貼り戻しが元の恒等射である。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (Y X : Paths C) :
    FirstFactor.extraction W Y X ≫ FirstFactor.MarkedSpine.gluing W Y X =
      𝟙 (colimitGraph W.paths X Y) := FirstFactor.extraction_gluing W Y X

-- 同じ抽出射自身は全次数で単射である。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (Y X : Paths C) (n : SimplexCategoryᵒᵖ) :
    Function.Injective ((FirstFactor.extraction W Y X).app n) :=
  FirstFactor.extraction_injective W Y X n

-- 任意可換環の実際の全自由次数で同じ元の恒等射を回収する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (X Y : ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category) :
    let W := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    FirstFactor.extraction W Y X ≫ FirstFactor.MarkedSpine.gluing W Y X =
      𝟙 (colimitGraph W.paths X Y) :=
  FirstFactor.extraction_gluing (freeResolutionGeneratorBase
    (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences Y X


-- 任意の三因子の貼り戻しの元の文字列を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (X Y : Paths C) :
    FactorTarget.paste W X Y ≫ colimitValue W X Y = FactorTarget.wordValue W X Y :=
  FactorTarget.paste_value W X Y

-- 指定 hammock の元の点は包含して抽出すると同じ元の終端へ戻る。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (Y X : Paths C) {n : SimplexCategoryᵒᵖ}
    (p : (AllMarked.nativeSpace W X Y).obj n) :
    FirstFactor.markedSpine W Y n X ((AllMarked.inclusion W X Y).app n p) =
      FirstFactor.MarkedSpine.nil X p := FirstFactor.markedSpine_native W Y X p

-- 元の任意の語の貼り戻しで最初の非指定列の位置を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (g : FactorTarget.Index W) (σ : (AllMarked.nativeGraph W X g.val.left a).obj n)
    (τ : (graph W.paths b g.val.right Y).obj n)
    (h : ∃ j, column W ((Pasted.simplex W g σ τ).obj 0) j ≠ []) :
    AttachedPrefix.index W (Pasted.simplex W g σ τ) h = Pasted.columnIndex a b :=
  Pasted.simplex_firstColumn W g σ τ h

-- 任意の余極限の三因子を貼って切ると同じ元の生成矢を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (X Y : Paths C) {n : SimplexCategoryᵒᵖ}
    (s : (FactorTarget.space W X Y).obj n) :
    ((FirstFactor.nonemptyCut W X Y).app n ((FactorTarget.pasteNonempty W X Y).app n s)).1 = s.1 :=
  FactorTarget.pasteNonempty_generator_index W X Y s

-- 残りの点の非指定文字列も元の残りと一致する。点そのものの回収は別工程である。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (X Y : Paths C) {n : SimplexCategoryᵒᵖ}
    (s : (FactorTarget.space W X Y).obj n) :
    (colimitValue W ((FirstFactor.nonemptyCut W X Y).app n
      ((FactorTarget.pasteNonempty W X Y).app n s)).1.val.right Y).app n
        ((FirstFactor.nonemptyCut W X Y).app n ((FactorTarget.pasteNonempty W X Y).app n s)).2.2 =
      (colimitValue W s.1.val.right Y).app n s.2.2 :=
  FactorTarget.pasteNonempty_residual_value W X Y s

-- 任意可換環の実際の全自由次数でも同じ生成矢を回収する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n m : SimplexCategoryᵒᵖ)
    (X Y : ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category)
    (s : let W := (freeResolutionGeneratorBase
        (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
      (FactorTarget.space W X Y).obj m) :
    let W := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    ((FirstFactor.nonemptyCut W X Y).app m ((FactorTarget.pasteNonempty W X Y).app m s)).1 = s.1 :=
  FactorTarget.pasteNonempty_generator_index (freeResolutionGeneratorBase
    (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences X Y s


-- 元の raw な長さ一の列の FixedCut の前後が長さ零である。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization.GeneratorWord in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {g : Quiver.Total C} {A B : Paths C} {p : A ⟶ B}
    (P : FixedCut W g p) (hp : p.length = 1) : P.left.length = 0 ∧ P.right.length = 0 :=
  ⟨FixedCut.left_length_of_one W P hp, FixedCut.right_length_of_one W P hp⟩

-- 全成分が長さ零なら元の自然変換全体が関手の等式による移送である。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization.GeneratorWord in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] {A B : D ⥤ Paths C} (α : A ⟶ B)
    (hα : ∀ d, (α.app d).length = 0) : ∃ h : A = B, α = eqToHom h :=
  zeroNatTrans_eqToHom α hα

-- 元の貼り戻しの全行の raw な生成列は長さ一である。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (g : FactorTarget.Index W) (σ : (AllMarked.nativeGraph W X g.val.left a).obj n)
    (τ : (graph W.paths b g.val.right Y).obj n)
    (h : ∃ j, column W ((Pasted.simplex W g σ τ).obj 0) j ≠ []) (d : Fin (n.unop.len + 1)) :
    (((Pasted.simplex W g σ τ).obj d).arrow
      (AttachedPrefix.index W (Pasted.simplex W g σ τ) h)).length = 1 :=
  Pasted.selected_column_length_one W g σ τ h d

-- 元の前の全図式を元の指定 prefix の全関手へ回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (g : FactorTarget.Index W) (σ : (AllMarked.nativeGraph W X g.val.left a).obj n)
    (τ : (graph W.paths b g.val.right Y).obj n) :
    HEq (Zigzag.MovingDiagram.changeWord (Pasted.before_word a b)
      (Attachments.beforeDiagram W (Pasted.simplex W g σ τ) (Pasted.columnIndex a b)))
      (Zigzag.MovingDiagram.ofFunctor ((AllMarked.graphMap W X g.val.left a).app n σ)) :=
  Pasted.before_diagram W g σ τ

-- 元の後の全図式を元の残りの全関手へ回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {a b : Word} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (g : FactorTarget.Index W) (σ : (AllMarked.nativeGraph W X g.val.left a).obj n)
    (τ : (graph W.paths b g.val.right Y).obj n) :
    HEq (Zigzag.MovingDiagram.changeWord (Pasted.after_word a b)
      (Attachments.afterDiagram W (Pasted.simplex W g σ τ) (Pasted.columnIndex a b)))
      (Zigzag.MovingDiagram.ofFunctor τ) := Pasted.after_diagram W g σ τ

-- 任意可換環の実際の全自由次数でも元の prefix の全図式を回収する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n m : SimplexCategoryᵒᵖ)
    {a b : Word}
    (X Y : ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category)
    (g : let W := (freeResolutionGeneratorBase
        (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
      FactorTarget.Index W)
    (σ : let W := (freeResolutionGeneratorBase
        (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
      (AllMarked.nativeGraph W X g.val.left a).obj m)
    (τ : (graph ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).weakEquivalences
      b g.val.right Y).obj m) :
    let W := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    HEq (Zigzag.MovingDiagram.changeWord (Pasted.before_word a b)
      (Attachments.beforeDiagram W (Pasted.simplex W g σ τ) (Pasted.columnIndex a b)))
      (Zigzag.MovingDiagram.ofFunctor ((AllMarked.graphMap W X g.val.left a).app m σ)) :=
  Pasted.before_diagram (freeResolutionGeneratorBase
    (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences g σ τ


-- 元の恒等列の標準射は元の空語の単位点である。
open CategoryTheory MonoidalCategory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) [W.IsMultiplicative] (X : C) (n : SimplexCategoryᵒᵖ) :
    arrowPoint W (𝟙 X) n = (colimitUnit W X).app n PUnit.unit :=
  arrowPoint_identity W X n

-- 元の任意の点に対する実際の左右の単位則を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) [W.IsMultiplicative] {X Y : C} {n : SimplexCategoryᵒᵖ}
    (p : (colimitGraph W X Y).obj n) :
    composePoint W X X Y (arrowPoint W (𝟙 X) n) p = p ∧
      composePoint W X Y Y p (arrowPoint W (𝟙 Y) n) = p :=
  ⟨composePoint_identity_left W p, composePoint_identity_right W p⟩

-- 任意の三因子の元の依存和の点を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (X Y : Paths C) {n : SimplexCategoryᵒᵖ}
    (s : (FactorTarget.space W X Y).obj n) :
    (FirstFactor.nonemptyCut W X Y).app n ((FactorTarget.pasteNonempty W X Y).app n s) = s :=
  FactorTarget.pasteNonempty_cut_point W X Y s

-- 全 prefix と終端を保持した元の因子列を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (Y X : Paths C) {n : SimplexCategoryᵒᵖ}
    (t : FirstFactor.MarkedSpine W Y n X) :
    FirstFactor.markedSpine W Y n X (FirstFactor.MarkedSpine.glue t) = t :=
  FirstFactor.markedSpine_glue W Y t

-- 元の抽出と貼り戻し自身が同型の二射である。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (Y X : Paths C) :
    (FirstFactor.markedSpineIso W Y X).hom = FirstFactor.extraction W Y X ∧
      (FirstFactor.markedSpineIso W Y X).inv = FirstFactor.MarkedSpine.gluing W Y X := ⟨rfl, rfl⟩

-- 任意可換環の実際の全自由次数の hammock に同じ同型を代入する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock SerrePositivity.EInfinity.Hammock.UnmarkedGenerators in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (X Y : ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    colimitGraph W.paths X Y ≅ FirstFactor.MarkedSpine.space W Y X :=
  FirstFactor.markedSpineIso (freeResolutionGeneratorBase
    (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences Y X


-- 元の相対関手の余極限写像自身が任意の二点の合成を保つ。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse}
    [Category.{e2ComplexLimitUniverse} C] [Category.{e2ComplexLimitUniverse} D]
    {W : MorphismProperty C} [W.IsMultiplicative]
    {V : MorphismProperty D} [V.IsMultiplicative] (F : LocalizerMorphism W V)
    {X Y Z : C} {n : SimplexCategoryᵒᵖ}
    (p : (colimitGraph W X Y).obj n) (q : (colimitGraph W Y Z).obj n) :
    (Relative.colimitMap F X Z).app n (composePoint W X Y Z p q) =
      composePoint V (F.functor.obj X) (F.functor.obj Y) (F.functor.obj Z)
        ((Relative.colimitMap F X Y).app n p) ((Relative.colimitMap F Y Z).app n q) :=
  Relative.composePoint_map F p q

-- 明示的な全因子列の合成を貼ると元の hammock の合成に戻る。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    {W : MorphismProperty C} {X Y Z : Paths C} {n : SimplexCategoryᵒᵖ}
    (s : MarkedSpine W Y n X) (t : MarkedSpine W Z n Y) :
    MarkedSpine.glue (MarkedSpine.append s t) =
      composePoint W.paths X Y Z (MarkedSpine.glue s) (MarkedSpine.glue t) :=
  MarkedSpine.glue_append s t

-- 元の全因子列の合成の左右単位を同じ指定終端で回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    {W : MorphismProperty C} {X Y : Paths C} {n : SimplexCategoryᵒᵖ}
    (t : MarkedSpine W Y n X) :
    MarkedSpine.append (MarkedSpine.unitPoint W X n) t = t ∧
      MarkedSpine.append t (MarkedSpine.unitPoint W Y n) = t :=
  ⟨MarkedSpine.append_left_unit t, MarkedSpine.append_right_unit t⟩

-- 指定二部分の像が同じなら任意の目標圏への合成保存拡張は一意である。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C D : Type e2ComplexLimitUniverse}
    [Category.{e2ComplexLimitUniverse} C] [Category.{e2ComplexLimitUniverse} D]
    {W : MorphismProperty C} {n : SimplexCategoryᵒᵖ} (F : MarkedSpine.FoldData W n D)
    (H : ∀ {X Y : Paths C}, MarkedSpine W Y n X → (F.obj X ⟶ F.obj Y))
    (hm : ∀ {X Y} (p : (AllMarked.nativeSpace W X Y).obj n),
      H (MarkedSpine.nil X p) = F.marked p)
    (hg : ∀ g, H (MarkedSpine.generatorPoint W g n) = F.generator g)
    (hc : ∀ {X Y Z} (s : MarkedSpine W Y n X) (t : MarkedSpine W Z n Y),
      H (MarkedSpine.append s t) = H s ≫ H t) {X Y : Paths C} (t : MarkedSpine W Y n X) :
    H t = F.fold t := F.fold_unique H hm hg hc t

-- 全単体作用素の前合成は元の全因子列の評価と一致する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C D : Type e2ComplexLimitUniverse}
    [Category.{e2ComplexLimitUniverse} C] [Category.{e2ComplexLimitUniverse} D]
    {W : MorphismProperty C} {n m : SimplexCategoryᵒᵖ} (F : MarkedSpine.FoldData W m D)
    (θ : n ⟶ m) {X Y : Paths C} (t : MarkedSpine W Y n X) :
    (F.precompSimplex θ).fold t = F.fold (MarkedSpine.map θ t) := F.fold_simplex θ t

-- 任意可換環の元の全自由次数に明示的な全因子列の豊穣圏を代入する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    EnrichedCategory SSet.{e2ComplexLimitUniverse + 1} (Paths C) :=
  MarkedSpine.enrichedCategory (freeResolutionGeneratorBase
    (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences


-- 任意の豊穣目標への全因子列の評価は全単体作用素と一致する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [EnrichedCategory SSet.{e2ComplexLimitUniverse} D] {W : MorphismProperty C}
    (F : MarkedSpine.EnrichedFoldData W D) {X Y : Paths C} {n m : SimplexCategoryᵒᵖ}
    (θ : n ⟶ m) (t : MarkedSpine W Y n X) :
    (F.obj X ⟶[SSet.{e2ComplexLimitUniverse}] F.obj Y).map θ (F.foldPoint n t) =
      F.foldPoint m (MarkedSpine.map θ t) := F.foldPoint_simplex θ t

-- 元の hammock 自身への拡張は二つの生成部分の像を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [EnrichedCategory SSet.{e2ComplexLimitUniverse} D] {W : MorphismProperty C}
    (F : MarkedSpine.EnrichedFoldData W D) (X Y : Paths C) (g : FactorTarget.Index W) :
    AllMarked.inclusion W X Y ≫ F.hammockFoldMap X Y = F.marked X Y ∧
      arrowMap W.paths g.val.hom.toPath ≫ F.hammockFoldMap g.val.left g.val.right = F.generator g :=
  ⟨F.hammockFoldMap_marked X Y, F.hammockFoldMap_generator g⟩

-- 単位と合成の保存は元の全語の余極限上の元の二射について成立する。
open CategoryTheory MonoidalCategory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [EnrichedCategory SSet.{e2ComplexLimitUniverse} D] {W : MorphismProperty C}
    (F : MarkedSpine.EnrichedFoldData W D) (X Y Z : Paths C) :
    colimitUnit W.paths X ≫ F.hammockFoldMap X X = eId SSet.{e2ComplexLimitUniverse} (F.obj X) ∧
      colimitComposition W.paths X Y Z ≫ F.hammockFoldMap X Z =
        (F.hammockFoldMap X Y ⊗ₘ F.hammockFoldMap Y Z) ≫
          eComp SSet.{e2ComplexLimitUniverse} (F.obj X) (F.obj Y) (F.obj Z) :=
  ⟨F.hammockFoldMap_unit X, F.hammockFoldMap_comp X Y Z⟩

-- 元の hammock からの豊穣関手と二つの生成部分の像の指定は全単射である。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [EnrichedCategory SSet.{e2ComplexLimitUniverse} D] (W : MorphismProperty C) :
    letI := Hammock.enrichedCategory W.paths
    EnrichedFunctor SSet.{e2ComplexLimitUniverse} (Paths C) D ≃ MarkedSpine.EnrichedFoldData W D :=
  MarkedSpine.hammockEnrichedFunctorEquiv W

-- 指定した元の全単体写像は拡張の後の制限で厳密に回収される。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [EnrichedCategory SSet.{e2ComplexLimitUniverse} D] {W : MorphismProperty C}
    (F : MarkedSpine.EnrichedFoldData W D) :
    MarkedSpine.restrictHammockEnrichedFunctor W (F.hammockEnrichedFunctor W) = F :=
  MarkedSpine.restrict_hammock_extend F

-- 任意可換環の実際の全自由次数から任意の豊穣目標への同じ拡張を代入する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (D : Type (e2ComplexLimitUniverse + 1)) [EnrichedCategory SSet.{e2ComplexLimitUniverse + 1} D]
    (F : let W := (freeResolutionGeneratorBase
        (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
      MarkedSpine.EnrichedFoldData W D) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    letI : EnrichedCategory SSet.{e2ComplexLimitUniverse + 1}
        ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category :=
      show EnrichedCategory SSet.{e2ComplexLimitUniverse + 1} (Paths C) from
        Hammock.enrichedCategory W.paths
    EnrichedFunctor SSet.{e2ComplexLimitUniverse + 1}
      ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category D :=
  F.hammockEnrichedFunctor (freeResolutionGeneratorBase
    (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences


-- 任意の離散豊穣化からの関手は元の underlying 圏への関手と同値である。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [EnrichedCategory SSet.{e2ComplexLimitUniverse} D] :
    letI := DiscreteEnrichment.enrichedCategory (C := C)
    EnrichedFunctor SSet.{e2ComplexLimitUniverse} C D ≃
      (C ⥤ ForgetEnrichment SSet.{e2ComplexLimitUniverse} D) := DiscreteEnrichment.functorEquiv

-- 非指定自由圏への拡張は元の同じ生成矢の一定単体を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor
  SerrePositivity.EInfinity.SimplicialLocalization in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [EnrichedCategory SSet.{e2ComplexLimitUniverse} D] {W : MorphismProperty C}
    (F : MarkedSpine.EnrichedFoldData W D) (g : FactorTarget.Index W) :
    letI := DiscreteEnrichment.enrichedCategory
      (C := Paths (MarkedGenerators.quiver (GeneratorPartition.unmarked W)))
    DiscreteEnrichment.point (MarkedSpine.unmarkedGeneratorPath W g) ≫
      F.unmarkedEnrichedFunctor.map g.val.left g.val.right = F.generator g :=
  F.unmarkedEnrichedFunctor_generator g

-- 共通対象の表示の等式を含む元の二つの関手の組を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [EnrichedCategory SSet.{e2ComplexLimitUniverse} D] {W : MorphismProperty C}
    (P : MarkedSpine.EnrichedParts W D) : P.foldData.parts = P := P.foldData_parts

-- 元の二つの豊穣包含との合成による制限そのものが全単射である。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [EnrichedCategory SSet.{e2ComplexLimitUniverse} D] (W : MorphismProperty C) :
    letI := Hammock.enrichedCategory W.paths
    EnrichedFunctor SSet.{e2ComplexLimitUniverse} (Paths C) D ≃ MarkedSpine.EnrichedParts W D :=
  MarkedSpine.freeProductFunctorEquiv W

-- 元の二つの部分からの任意の組は元の hammock へ一意に拡張する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [EnrichedCategory SSet.{e2ComplexLimitUniverse} D] {W : MorphismProperty C}
    (P : MarkedSpine.EnrichedParts W D) :
    letI := Hammock.enrichedCategory W.paths
    ∃! F : EnrichedFunctor SSet.{e2ComplexLimitUniverse} (Paths C) D,
      MarkedSpine.restrictParts W F = P := MarkedSpine.existsUnique_freeProductExtension W P

-- 任意可換環の実際の全自由次数の元の二つの部分について同じ普遍性を代入する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (D : Type (e2ComplexLimitUniverse + 1)) [EnrichedCategory SSet.{e2ComplexLimitUniverse + 1} D]
    (P : let W := (freeResolutionGeneratorBase
        (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
      MarkedSpine.EnrichedParts W D) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    letI : EnrichedCategory SSet.{e2ComplexLimitUniverse + 1}
        ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category :=
      show EnrichedCategory SSet.{e2ComplexLimitUniverse + 1} (Paths C) from
        Hammock.enrichedCategory W.paths
    ∃! F : EnrichedFunctor SSet.{e2ComplexLimitUniverse + 1}
      ((freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n).category D,
      MarkedSpine.restrictParts W F = P :=
  MarkedSpine.existsUnique_freeProductExtension (freeResolutionGeneratorBase
    (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences P


-- 元の根付き quiver の射影は star と costar の双方で全単射である。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    letI := FreeQuiverCover.quiver A
    (FreeQuiverCover.projection A).IsCovering := FreeQuiverCover.projection_isCovering A

-- 対称化した元の全射列も指定始点から一意に持ち上がる。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q)
    (x : FreeQuiverCover.Vertex A) :
    letI := FreeQuiverCover.quiver A
    Function.Bijective ((FreeQuiverCover.projection A).symmetrify.pathStar
      (Quiver.Symmetrify.of.obj x)) := by
  let := FreeQuiverCover.quiver A
  exact (FreeQuiverCover.symmetrify_isCovering A).pathStar_bijective _

-- 元の対称射列の商をラベルに持つ任意の頂点へ固定根から到達できる。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q)
    (x : FreeQuiverCover.Vertex A) :
    Nonempty (FreeQuiverCover.symmetricPath A (FreeQuiverCover.root A) x) :=
  FreeQuiverCover.root_connected A x

-- 実際の持ち上げ終点のラベルは元の対称射列の値で回収される。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q)
    (x y : FreeQuiverCover.Vertex A) (p : FreeQuiverCover.symmetricPath A x y) :
    letI := FreeQuiverCover.quiver A
    x.path ≫ FreeQuiverCover.symmetricEvaluation.map
      ((FreeQuiverCover.symmetricProjection A).mapPath p) = y.path :=
  FreeQuiverCover.projected_endpoint A x y p

-- 元の自由圏の射影自身が忠実である。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    letI := FreeQuiverCover.quiver A
    (FreeQuiverCover.pathProjection A).Faithful := FreeQuiverCover.pathProjection_faithful A

-- 任意可換環の実際の全自由次数の指定生成 quiver へ同じ根付き被覆を代入する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (A : (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    letI := FreeQuiverCover.quiver (Q := MarkedGenerators.quiver W) A
    (FreeQuiverCover.projection (Q := MarkedGenerators.quiver W) A).IsCovering :=
  FreeQuiverCover.projection_isCovering (Q := MarkedGenerators.quiver
    (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences) A

-- 逆射を含む元の自由 groupoid の射影自身が忠実である。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    letI := FreeQuiverCover.quiver A
    (FreeQuiverCover.groupoidProjection A).Faithful :=
  FreeQuiverCover.groupoidProjection_faithful A

-- 元の全 groupoid 射について持ち上げ終点の式が成立する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    letI := FreeQuiverCover.quiver A
    ∀ {x y : Quiver.FreeGroupoid (FreeQuiverCover.Vertex A)} (f : x ⟶ y),
      x.as.path ≫ (FreeQuiverCover.groupoidProjection A).map f = y.as.path :=
  FreeQuiverCover.groupoidProjection_endpoint A

-- 元の置換作用は任意の持ち上げ射の右合成を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    letI := FreeQuiverCover.quiver A
    ∀ (S : Quiver.FreeGroupoid (FreeQuiverCover.Vertex A)) {x y} (f : x ⟶ y) (h : S ⟶ x),
      FreeQuiverCover.starPermutation A S f (FreeQuiverCover.encodeStar A S x h) =
        FreeQuiverCover.encodeStar A S y (h ≫ f) :=
  FreeQuiverCover.starRepresentation_action A

-- 元の被覆の自由 groupoid は薄い。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    letI := FreeQuiverCover.quiver A
    Quiver.IsThin (Quiver.FreeGroupoid (FreeQuiverCover.Vertex A)) :=
  FreeQuiverCover.groupoid_isThin A

-- 存在と一意性を局所選択できる。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    letI := FreeQuiverCover.quiver A
    ∀ x y : Quiver.FreeGroupoid (FreeQuiverCover.Vertex A), Unique (x ⟶ y) :=
  FreeQuiverCover.groupoidHomUnique A

-- 任意可換環の実際の全自由次数の指定生成 quiver での忠実性。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (A : (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    letI := FreeQuiverCover.quiver (Q := MarkedGenerators.quiver W) A
    (FreeQuiverCover.groupoidProjection (Q := MarkedGenerators.quiver W) A).Faithful :=
  FreeQuiverCover.groupoidProjection_faithful (Q := MarkedGenerators.quiver
    (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences) A

-- 元の被覆の全生成辺が正逆どちらかで測地木に属する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    letI := FreeQuiverCover.quiver A
    ∀ {x y : FreeQuiverCover.Vertex A} (f : x ⟶ y),
      f.toPos ∈ FreeQuiverCover.spanningTree A x y ∨
        f.toNeg ∈ FreeQuiverCover.spanningTree A y x :=
  FreeQuiverCover.every_edge_in_spanningTree A

-- 元の生成辺の両端の高さは一つ違う。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    letI := FreeQuiverCover.quiver A
    ∀ {x y : FreeQuiverCover.Vertex A} (_ : x ⟶ y),
      FreeQuiverCover.treeHeight A y = FreeQuiverCover.treeHeight A x + 1 ∨
        FreeQuiverCover.treeHeight A x = FreeQuiverCover.treeHeight A y + 1 :=
  FreeQuiverCover.edge_treeHeight A

-- 高い頂点へ入る元の対称生成辺そのものが一意。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    letI := FreeQuiverCover.quiver A
    ∀ {x y z : Quiver.Symmetrify (FreeQuiverCover.Vertex A)} (e : x ⟶ z) (f : y ⟶ z),
      FreeQuiverCover.treeHeight A x ≤ FreeQuiverCover.treeHeight A z →
        FreeQuiverCover.treeHeight A y ≤ FreeQuiverCover.treeHeight A z → x = y ∧ HEq e f :=
  FreeQuiverCover.higher_incoming_unique A

-- 根以外を含む任意の有限頂点集合から根以外の葉を選べる。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q)
    (S : Finset (FreeQuiverCover.Vertex A)) (hS : ∃ x ∈ S, x ≠ FreeQuiverCover.root A) :
    letI := FreeQuiverCover.quiver A
    ∃ z ∈ S, z ≠ FreeQuiverCover.root A ∧ QuiverTree.IsLeafIn S z :=
  FreeQuiverCover.exists_nonroot_finite_leaf A S hS

-- 測地木の根の元の高さも零として回収する。
open SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    FreeQuiverCover.treeHeight A (FreeQuiverCover.root A) = 0 := FreeQuiverCover.treeHeight_root A

-- 任意可換環の実際の全自由次数の指定生成 quiver の全辺へ代入する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (A : (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    letI := FreeQuiverCover.quiver (Q := MarkedGenerators.quiver W) A
    ∀ {x y : FreeQuiverCover.Vertex (Q := MarkedGenerators.quiver W) A} (f : x ⟶ y),
      f.toPos ∈ FreeQuiverCover.spanningTree (Q := MarkedGenerators.quiver W) A x y ∨
        f.toNeg ∈ FreeQuiverCover.spanningTree (Q := MarkedGenerators.quiver W) A y x :=
  FreeQuiverCover.every_edge_in_spanningTree (Q := MarkedGenerators.quiver
    (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences) A

-- 指定両端のラベルが整合すれば元の正向き射列は一意に持ち上がる。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q)
    (x y : FreeQuiverCover.Vertex A) (p : Quiver.Path x.base y.base)
    (h : x.path ≫ FreeQuiverCover.positiveEvaluation.map p = y.path) :
    letI := FreeQuiverCover.quiver A
    ∃! q : Quiver.Path x y, (FreeQuiverCover.projection A).mapPath q = p :=
  FreeQuiverCover.existsUnique_liftPathTo A x y p h

-- 任意のラベル付き図式は射影で元の関手に戻る。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q)
    {D : Type e2ComplexLimitUniverse} [Category D] (F : D ⥤ Paths Q)
    (L : FreeQuiverCover.DiagramLabels A F) :
    letI := FreeQuiverCover.quiver A
    FreeQuiverCover.diagramLift A L ⋙ FreeQuiverCover.pathProjection A = F :=
  FreeQuiverCover.diagramLift_projection A L

-- 元の全縦射に沿って元の接頭ラベルが整合する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q)
    {w : Word} {Y : Paths Q}
    {S T : Zigzag (⊤ : MorphismProperty (Paths Q)) w ((Paths.of Q).obj A) Y}
    (f : S ⟶ T) (j : Fin (w.length + 1)) :
    FreeQuiverCover.zigzagPrefix A S j ≫ FreeQuiverCover.positiveEvaluation.map (f.app j) =
      FreeQuiverCover.zigzagPrefix A T j := FreeQuiverCover.zigzagPrefix_naturality A f j

-- 元の値の fiber の持ち上げと射影は元の包含に厳密に一致する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q)
    (w : Word) (Y : Paths Q)
    (β : (Quiver.FreeGroupoid.of Q).obj A ⟶ FreeQuiverCover.positiveEvaluation.obj Y) :
    letI := FreeQuiverCover.quiver A
    FreeQuiverCover.zigzagLiftFunctor A w Y β ⋙ FreeQuiverCover.zigzagProjection A w Y β =
      (FreeQuiverCover.zigzagValueProperty A w Y β).ι :=
  FreeQuiverCover.zigzagLiftFunctor_projection A

-- 空語・根の恒等値でも元の同じ包含を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    let Y := (Paths.of Q).obj A
    letI := FreeQuiverCover.quiver A
    FreeQuiverCover.zigzagLiftFunctor A Word.empty Y (𝟙 _) ⋙
      FreeQuiverCover.zigzagProjection A Word.empty Y (𝟙 _) =
        (FreeQuiverCover.zigzagValueProperty A Word.empty Y (𝟙 _)).ι :=
  FreeQuiverCover.zigzagLiftFunctor_projection A

-- 任意可換環の実際の全自由次数の指定生成 quiver へ持ち上げ関手を代入する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (A B : (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category)
    (w : Word) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    let Q := MarkedGenerators.quiver W
    ∀ β : (Quiver.FreeGroupoid.of Q).obj A ⟶ (Quiver.FreeGroupoid.of Q).obj B,
    let Y := (Paths.of Q).obj B
    letI := FreeQuiverCover.quiver (Q := Q) A
    FreeQuiverCover.zigzagLiftFunctor (Q := Q) A w Y β ⋙
      FreeQuiverCover.zigzagProjection (Q := Q) A w Y β =
        (FreeQuiverCover.zigzagValueProperty (Q := Q) A w Y β).ι := by
  intro C W Q β
  exact FreeQuiverCover.zigzagLiftFunctor_projection (Q := Q) A

-- 元の射影の接頭値は被覆の元の全頂点ラベルに等しい。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q)
    {w : Word} {Y : Paths Q}
    {β : (Quiver.FreeGroupoid.of Q).obj A ⟶ FreeQuiverCover.positiveEvaluation.obj Y} :
    letI := FreeQuiverCover.quiver A
    ∀ (Z : Zigzag (⊤ : MorphismProperty (Paths (FreeQuiverCover.Vertex A))) w
      ((Paths.of (FreeQuiverCover.Vertex A)).obj (FreeQuiverCover.root A))
      ((Paths.of (FreeQuiverCover.Vertex A)).obj (FreeQuiverCover.fiberEndpoint A Y β)))
      (j : Fin (w.length + 1)),
      FreeQuiverCover.zigzagPrefix A ((FreeQuiverCover.zigzagProjection A w Y β).obj Z) j =
        (Z.vertex j).path := FreeQuiverCover.projectedPrefix_eq_label A

-- 元の二つの関手を持つ厳密な圏同型を得る。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q)
    (w : Word) (Y : Paths Q)
    (β : (Quiver.FreeGroupoid.of Q).obj A ⟶ FreeQuiverCover.positiveEvaluation.obj Y) :
    letI := FreeQuiverCover.quiver A
    Cat.of (FreeQuiverCover.ZigzagValueFiber A w Y β) ≅
      Cat.of (Zigzag (⊤ : MorphismProperty (Paths (FreeQuiverCover.Vertex A))) w
        ((Paths.of (FreeQuiverCover.Vertex A)).obj (FreeQuiverCover.root A))
        ((Paths.of (FreeQuiverCover.Vertex A)).obj (FreeQuiverCover.fiberEndpoint A Y β))) :=
  FreeQuiverCover.zigzagFiberCategoryIso A w Y β

-- 元の全語の作用と持ち上げ関手が厳密に可換する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q)
    (Y : Paths Q) (β : (Quiver.FreeGroupoid.of Q).obj A ⟶ FreeQuiverCover.positiveEvaluation.obj Y) :
    letI := FreeQuiverCover.quiver A
    ∀ {a b : Word} (f : a ⟶ b),
      FreeQuiverCover.zigzagFiberWordAction A Y β f ⋙ FreeQuiverCover.zigzagLiftFunctor A b Y β =
        FreeQuiverCover.zigzagLiftFunctor A a Y β ⋙ WordAction.functor f :=
  FreeQuiverCover.zigzagLiftFunctor_wordAction A Y β

-- 空語の逆向きの単体写像も元の射影の nerve そのものである。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    let Y := (Paths.of Q).obj A
    letI := FreeQuiverCover.quiver A
    (FreeQuiverCover.fiberGraphDiagramIso A Y (𝟙 _)).inv.app Word.empty =
      nerveMap (FreeQuiverCover.zigzagFiberProjection A Word.empty Y (𝟙 _)) :=
  FreeQuiverCover.fiberGraphDiagramIso_inv_app A _ _ Word.empty

-- 全語の余極限の同型は元の各標準射で回収される。
open CategoryTheory CategoryTheory.Limits SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q)
    (Y : Paths Q) (β : (Quiver.FreeGroupoid.of Q).obj A ⟶ FreeQuiverCover.positiveEvaluation.obj Y)
    (w : Word) :
    letI := FreeQuiverCover.quiver A
    colimit.ι (FreeQuiverCover.fiberGraphDiagram A Y β) w ≫
      (FreeQuiverCover.fiberGraphColimitIso A Y β).hom =
        nerveMap (FreeQuiverCover.zigzagLiftFunctor A w Y β) ≫
          graphInclusion (⊤ : MorphismProperty (Paths (FreeQuiverCover.Vertex A)))
            ((Paths.of (FreeQuiverCover.Vertex A)).obj (FreeQuiverCover.root A))
            ((Paths.of (FreeQuiverCover.Vertex A)).obj (FreeQuiverCover.fiberEndpoint A Y β)) w :=
  FreeQuiverCover.fiberGraphColimitIso_fac A Y β w

-- 任意可換環の実際の全自由次数の指定生成 quiver の全語の余極限へ代入する。
open CategoryTheory CategoryTheory.Limits SerrePositivity.EInfinity
  SerrePositivity.EInfinity.SimplicialLocalization SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (A B : (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    let Q := MarkedGenerators.quiver W
    ∀ β : (Quiver.FreeGroupoid.of Q).obj A ⟶ (Quiver.FreeGroupoid.of Q).obj B,
    let Y := (Paths.of Q).obj B
    letI := FreeQuiverCover.quiver (Q := Q) A
    colimit (FreeQuiverCover.fiberGraphDiagram (Q := Q) A Y β) ≅
      colimitGraph (⊤ : MorphismProperty (Paths (FreeQuiverCover.Vertex (Q := Q) A)))
        ((Paths.of (FreeQuiverCover.Vertex (Q := Q) A)).obj (FreeQuiverCover.root (Q := Q) A))
        ((Paths.of (FreeQuiverCover.Vertex (Q := Q) A)).obj
          (FreeQuiverCover.fiberEndpoint (Q := Q) A Y β)) := by
  intro C W Q β
  exact FreeQuiverCover.fiberGraphColimitIso (Q := Q) A ((Paths.of Q).obj B) β

-- 任意の添字圏の型値図式で元の余極限と fiber が交換する。
open CategoryTheory CategoryTheory.Limits SerrePositivity.EInfinity.Hammock in
example {I : Type e2ComplexLimitUniverse} [Category I] {F : I ⥤ Type e2ComplexLimitUniverse}
    (c : F.CoconeTypes) (β : c.pt) [HasColimit F]
    [HasColimit (LabelledColimit.fiberDiagram c β)] :
    colimit (LabelledColimit.fiberDiagram c β) ≃
      {z : colimit F // LabelledColimit.colimitLabel c z = β} :=
  LabelledColimit.colimitFiberEquiv c β

-- 単体集合での同型も filtered 性やモデル構造を要求しない。
open CategoryTheory CategoryTheory.Limits SerrePositivity.EInfinity.Hammock in
example {I : Type e2ComplexLimitUniverse} [Category I]
    {X : I ⥤ SSet.{e2ComplexLimitUniverse}} {B : Type e2ComplexLimitUniverse}
    (L : SimplicialLabelledColimit.Labels X B) (β : B)
    [HasColimit X] [HasColimitsOfShape I (Type e2ComplexLimitUniverse)] :
    colimit (SimplicialLabelledColimit.fiberDiagram L β) ≅
      SimplicialValueFiber.space (SimplicialLabelledColimit.colimitValue L) β :=
  SimplicialLabelledColimit.colimitFiberIso L β

-- 元の全語の標準射と元の fiber の包含を回収する。
open CategoryTheory CategoryTheory.Limits SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q)
    (Y : Paths Q) (β : (Quiver.FreeGroupoid.of Q).obj A ⟶ FreeQuiverCover.positiveEvaluation.obj Y)
    (w : Word) :
    colimit.ι (FreeQuiverCover.fiberGraphDiagram A Y β) w ≫
      (FreeQuiverCover.valueFiberColimitIso A Y β).hom ≫
        SimplicialValueFiber.inclusion (FreeQuiverCover.hammockValue A Y) β =
          nerveMap (FreeQuiverCover.zigzagValueProperty A w Y β).ι ≫
            graphInclusion (⊤ : MorphismProperty (Paths Q)) ((Paths.of Q).obj A) Y w :=
  FreeQuiverCover.valueFiberColimitIso_fac_inclusion A Y β w

-- 既存の同じ評価の fiber は元の被覆の hammock に同型である。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q)
    (Y : Paths Q) (β : (Quiver.FreeGroupoid.of Q).obj A ⟶ FreeQuiverCover.positiveEvaluation.obj Y) :
    letI := FreeQuiverCover.quiver A
    SimplicialValueFiber.space (Zigzag.Value.colimitValue FreeQuiverCover.positiveEvaluation
      FreeQuiverCover.positiveEvaluation_inverts_top ((Paths.of Q).obj A) Y) β ≅
      colimitGraph (⊤ : MorphismProperty (Paths (FreeQuiverCover.Vertex A)))
        ((Paths.of (FreeQuiverCover.Vertex A)).obj (FreeQuiverCover.root A))
        ((Paths.of (FreeQuiverCover.Vertex A)).obj (FreeQuiverCover.fiberEndpoint A Y β)) :=
  FreeQuiverCover.existingHammockValueFiberCoverIso A Y β

-- 空語でも全部分圏の nerve と元の graph の値の fiber を同定する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    let Y := (Paths.of Q).obj A
    (FreeQuiverCover.fiberGraphDiagram A Y (𝟙 _)).obj Word.empty ≅
      SimplicialValueFiber.space (FreeQuiverCover.graphValue A Y Word.empty) (𝟙 _) :=
  FreeQuiverCover.fiberGraphIso A _ _ Word.empty

-- 任意可換環の実際の全自由次数でも既存の評価の同じ fiber を同定する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (A B : (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    let Q := MarkedGenerators.quiver W
    ∀ β : (Quiver.FreeGroupoid.of Q).obj A ⟶ (Quiver.FreeGroupoid.of Q).obj B,
    let Y := (Paths.of Q).obj B
    letI := FreeQuiverCover.quiver (Q := Q) A
    SimplicialValueFiber.space (Zigzag.Value.colimitValue
      (FreeQuiverCover.positiveEvaluation (Q := Q))
      (FreeQuiverCover.positiveEvaluation_inverts_top (Q := Q)) ((Paths.of Q).obj A) Y) β ≅
      colimitGraph (⊤ : MorphismProperty (Paths (FreeQuiverCover.Vertex (Q := Q) A)))
        ((Paths.of (FreeQuiverCover.Vertex (Q := Q) A)).obj (FreeQuiverCover.root (Q := Q) A))
        ((Paths.of (FreeQuiverCover.Vertex (Q := Q) A)).obj
          (FreeQuiverCover.fiberEndpoint (Q := Q) A Y β)) := by
  intro C W Q β
  exact FreeQuiverCover.existingHammockValueFiberCoverIso (Q' := Q) A ((Paths.of Q).obj B) β

attribute [local instance] Classical.propDecidable

-- 元の有限頂点集合は空射列も含め始点・終点を保つ。
open SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] {x y : Q}
    (p : Quiver.Path x y) : x ∈ pathVertices p ∧ y ∈ pathVertices p :=
  ⟨pathVertices_source p, pathVertices_target p⟩

-- 元の被覆の有限包は同じ根からの射列で閉じる。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q)
    (S : Finset (FreeQuiverCover.Vertex A)) :
    letI := FreeQuiverCover.quiver A
    letI := FreeQuiverCover.spanningTreeArborescence A
    QuiverTree.RootClosed (FreeQuiverCover.spanningTree A) (FreeQuiverCover.finiteHull A S) :=
  FreeQuiverCover.finiteHull_closed A S

-- 元の葉を除くと閉性が保たれ、頂点数が真に減る。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    {T : WideSubquiver (Quiver.Symmetrify Q)} [Quiver.Arborescence T]
    {S : Finset Q} (D : QuiverTree.LeafDeletion T S) :
    QuiverTree.RootClosed T (S.erase D.leaf) ∧ (S.erase D.leaf).card < S.card :=
  ⟨D.remaining_closed, D.card_lt⟩

-- 元の相対関手の底の合成が厳密な恒等関手となる。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    {T : WideSubquiver (Quiver.Symmetrify Q)} [Quiver.Arborescence T]
    {S : Finset Q} (D : QuiverTree.LeafDeletion T S) :
    letI := FiniteQuiver.quiver S
    letI := FiniteQuiver.quiver (S.erase D.leaf)
    D.inclusionRelative.functor ⋙ D.retractionRelative.functor =
      𝟭 (Paths (FiniteQuiver.Vertex (S.erase D.leaf))) := D.inclusion_retraction_underlying

-- 空集合の有限包も元の根だけを含む。
open SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    FreeQuiverCover.finiteHull A ∅ = {FreeQuiverCover.root A} := FreeQuiverCover.finiteHull_empty A

-- 任意可換環の実際の全自由次数で葉を選び元の同じ関手の左逆を回収する。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (A : (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    let Q := MarkedGenerators.quiver W
    ∀ (S : Finset (FreeQuiverCover.Vertex (Q := Q) A))
      (hne : ∃ x ∈ S, x ≠ FreeQuiverCover.root (Q := Q) A),
    letI := FreeQuiverCover.quiver (Q := Q) A
    letI := FreeQuiverCover.spanningTreeArborescence (Q := Q) A
    let D := FreeQuiverCover.finiteHullLeafDeletion (Q := Q) A S hne
    letI := FiniteQuiver.quiver (FreeQuiverCover.finiteHull (Q := Q) A S)
    letI := FiniteQuiver.quiver ((FreeQuiverCover.finiteHull (Q := Q) A S).erase D.leaf)
    D.inclusionRelative.functor ⋙ D.retractionRelative.functor =
      𝟭 (Paths (FiniteQuiver.Vertex ((FreeQuiverCover.finiteHull (Q := Q) A S).erase D.leaf))) := by
  intro C W Q S hne
  let := FreeQuiverCover.quiver (Q := Q) A
  let := FreeQuiverCover.spanningTreeArborescence (Q := Q) A
  exact QuiverTree.LeafDeletion.inclusion_retraction_underlying
    (FreeQuiverCover.finiteHullLeafDeletion (Q := Q) A S hne)

-- 葉の向きが正のときの全射列での自然性。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    {T : WideSubquiver (Quiver.Symmetrify Q)} [Quiver.Arborescence T]
    {S : Finset Q} (D : QuiverTree.LeafDeletion T S)
    (g : D.parent ⟶ D.leaf) (hg : D.edge.val = g.toPos) :
    letI := FiniteQuiver.quiver S
    ∀ {x y : Paths (FiniteQuiver.Vertex S)} (f : x ⟶ y),
      D.collapseFunctor.map f ≫ (D.positiveDeformation g hg).app y =
        (D.positiveDeformation g hg).app x ≫ f := by
  let := FiniteQuiver.quiver S
  intro x y f
  exact (D.positiveDeformation g hg).naturality f

-- 葉の向きが負のときの全射列での自然性。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    {T : WideSubquiver (Quiver.Symmetrify Q)} [Quiver.Arborescence T]
    {S : Finset Q} (D : QuiverTree.LeafDeletion T S)
    (g : D.leaf ⟶ D.parent) (hg : D.edge.val = g.toNeg) :
    letI := FiniteQuiver.quiver S
    ∀ {x y : Paths (FiniteQuiver.Vertex S)} (f : x ⟶ y),
      f ≫ (D.negativeDeformation g hg).app y =
        (D.negativeDeformation g hg).app x ≫ D.collapseFunctor.map f := by
  let := FiniteQuiver.quiver S
  intro x y f
  exact (D.negativeDeformation g hg).naturality f

-- 葉における正の成分は同じ元の接続辺を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    {T : WideSubquiver (Quiver.Symmetrify Q)} [Quiver.Arborescence T]
    {S : Finset Q} (D : QuiverTree.LeafDeletion T S)
    (g : D.parent ⟶ D.leaf) (hg : D.edge.val = g.toPos) :
    letI := FiniteQuiver.quiver S
    (D.positiveDeformation g hg).app
        ((Paths.of (FiniteQuiver.Vertex S)).obj D.leafVertex) =
      eqToHom (D.collapse_obj_leaf D.leafVertex rfl) ≫
        (Paths.of (FiniteQuiver.Vertex S)).map
          (show D.parentVertex ⟶ D.leafVertex from g) ≫ eqToHom rfl := by
  let := FiniteQuiver.quiver S
  exact D.positiveComponent_leaf g D.leafVertex rfl

-- 葉における負の成分も同じ元の接続辺を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    {T : WideSubquiver (Quiver.Symmetrify Q)} [Quiver.Arborescence T]
    {S : Finset Q} (D : QuiverTree.LeafDeletion T S)
    (g : D.leaf ⟶ D.parent) (hg : D.edge.val = g.toNeg) :
    letI := FiniteQuiver.quiver S
    (D.negativeDeformation g hg).app
        ((Paths.of (FiniteQuiver.Vertex S)).obj D.leafVertex) =
      eqToHom rfl ≫ (Paths.of (FiniteQuiver.Vertex S)).map
        (show D.leafVertex ⟶ D.parentVertex from g) ≫
          eqToHom (D.collapse_obj_leaf D.leafVertex rfl).symm := by
  let := FiniteQuiver.quiver S
  exact D.negativeComponent_leaf g D.leafVertex rfl

-- 葉以外では元の対象の等式による恒等射となる。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    {T : WideSubquiver (Quiver.Symmetrify Q)} [Quiver.Arborescence T]
    {S : Finset Q} (D : QuiverTree.LeafDeletion T S)
    (g : D.parent ⟶ D.leaf) (hg : D.edge.val = g.toPos)
    (x : FiniteQuiver.Vertex S) (hx : x.val ≠ D.leaf) :
    letI := FiniteQuiver.quiver S
    (D.positiveDeformation g hg).app ((Paths.of (FiniteQuiver.Vertex S)).obj x) =
      eqToHom (D.collapse_obj_of_ne x hx) := D.positiveComponent_of_ne g x hx

-- 任意可換環の実際の全自由次数で元の有限木の自然変形を使う。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (A : (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    let Q := MarkedGenerators.quiver W
    ∀ (S : Finset (FreeQuiverCover.Vertex (Q := Q) A))
      (hne : ∃ x ∈ S, x ≠ FreeQuiverCover.root (Q := Q) A),
    letI := FreeQuiverCover.quiver (Q := Q) A
    letI := FreeQuiverCover.spanningTreeArborescence (Q := Q) A
    let D := FreeQuiverCover.finiteHullLeafDeletion (Q := Q) A S hne
    letI := FiniteQuiver.quiver (FreeQuiverCover.finiteHull (Q := Q) A S)
    (D.collapseFunctor ⟶ 𝟭 (Paths (FiniteQuiver.Vertex (FreeQuiverCover.finiteHull (Q := Q) A S)))) ⊕
      (𝟭 (Paths (FiniteQuiver.Vertex (FreeQuiverCover.finiteHull (Q := Q) A S))) ⟶
        D.collapseFunctor) := by
  intro C W Q S hne
  let := FreeQuiverCover.quiver (Q := Q) A
  let := FreeQuiverCover.spanningTreeArborescence (Q := Q) A
  exact QuiverTree.LeafDeletion.deformation
    (FreeQuiverCover.finiteHullLeafDeletion (Q := Q) A S hne)

-- 元の指定射による forward 後合成 は弱同値。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) [W.IsMultiplicative] {X Y : C}
    (g : X ⟶ Y) (hg : W g) (A : C) :
    IsWeakHomotopyEquivalence (postcomposePointMap A (arrowMap W g)) :=
  WeakArrow.postcompose_forward_isWeakHomotopyEquivalence g hg A

-- 元の指定射による backward 後合成 は弱同値。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) [W.IsMultiplicative] {X Y : C}
    (g : X ⟶ Y) (hg : W g) (A : C) :
    IsWeakHomotopyEquivalence (postcomposePointMap A (backwardMap g hg)) :=
  WeakArrow.postcompose_backward_isWeakHomotopyEquivalence g hg A

-- 元の指定射による forward 前合成 は弱同値。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) [W.IsMultiplicative] {X Y : C}
    (g : X ⟶ Y) (hg : W g) (A : C) :
    IsWeakHomotopyEquivalence (precomposePointMap (arrowMap W g) A) :=
  WeakArrow.precompose_forward_isWeakHomotopyEquivalence g hg A

-- 元の指定射による backward 前合成 は弱同値。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) [W.IsMultiplicative] {X Y : C}
    (g : X ⟶ Y) (hg : W g) (A : C) :
    IsWeakHomotopyEquivalence (precomposePointMap (backwardMap g hg) A) :=
  WeakArrow.precompose_backward_isWeakHomotopyEquivalence g hg A

-- 単位から元の往復合成への実際の単体的ホモトピーも得られる。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) [W.IsMultiplicative] {X Y : C}
    (g : X ⟶ Y) (hg : W g) :
    Nonempty (SSet.Homotopy (colimitUnit W X)
      (composeUnitMaps (arrowMap W g) (backwardMap g hg))) :=
  ⟨WeakArrow.sourceCompositeHomotopy g hg⟩

-- 任意可換環の実際の自由解像の全次数で元の指定射の四つの作用を検査。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity
  SerrePositivity.EInfinity.SimplicialLocalization SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ) :
    let B := (freeResolution (BarrattEccles.cofibrantAlgebraRelativeCategory R)).obj n
    ∀ {X Y : B.category} (g : X ⟶ Y) (hg : B.weakEquivalences g) (A : B.category),
      IsWeakHomotopyEquivalence (postcomposePointMap A (arrowMap B.weakEquivalences g)) ∧
      IsWeakHomotopyEquivalence (postcomposePointMap A (backwardMap g hg)) ∧
      IsWeakHomotopyEquivalence (precomposePointMap (arrowMap B.weakEquivalences g) A) ∧
      IsWeakHomotopyEquivalence (precomposePointMap (backwardMap g hg) A) := by
  intro B X Y g hg A
  exact ⟨WeakArrow.postcompose_forward_isWeakHomotopyEquivalence g hg A,
    WeakArrow.postcompose_backward_isWeakHomotopyEquivalence g hg A,
    WeakArrow.precompose_forward_isWeakHomotopyEquivalence g hg A,
    WeakArrow.precompose_backward_isWeakHomotopyEquivalence g hg A⟩

-- 元の端点移動を含む全語の余極限上のホモトピー。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] {W : MorphismProperty C} [W.IsMultiplicative]
    {V : MorphismProperty D} [V.IsMultiplicative] {F G : LocalizerMorphism W V}
    (η : F.functor ⟶ G.functor) (hη : ∀ X, V (η.app X)) (X Y : C) :
    Nonempty (SSet.Homotopy
      (Relative.colimitMap F X Y ≫
        postcomposePointMap (F.functor.obj X) (arrowMap V (η.app Y)))
      (Relative.colimitMap G X Y ≫
        precomposePointMap (arrowMap V (η.app X)) (G.functor.obj Y))) :=
  ⟨RelativeNatural.homotopy η hη X Y⟩

-- 元の二つの比較射の弱同値性が同値となる。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] {W : MorphismProperty C} [W.IsMultiplicative]
    {V : MorphismProperty D} [V.IsMultiplicative] {F G : LocalizerMorphism W V}
    (η : F.functor ⟶ G.functor) (hη : ∀ X, V (η.app X)) (X Y : C) :
    IsWeakHomotopyEquivalence (Relative.colimitMap F X Y) ↔
      IsWeakHomotopyEquivalence (Relative.colimitMap G X Y) := RelativeNatural.weak_iff η hη X Y

-- 全語の元の標準射と区間を保持した回収式。
open CategoryTheory CategoryTheory.MonoidalCategory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] {W : MorphismProperty C} [W.IsMultiplicative]
    {V : MorphismProperty D} [V.IsMultiplicative] {F G : LocalizerMorphism W V}
    (η : F.functor ⟶ G.functor) (hη : ∀ X, V (η.app X)) (X Y : C) (w : Word) :
    (graphInclusion W X Y w ▷
      SSet.stdSimplex.{e2ComplexLimitUniverse}.obj (SimplexCategory.mk 1)) ≫
        (RelativeNatural.homotopy η hη X Y).h =
          (RelativeNatural.fixedWordHomotopy η hη w X Y).h :=
  RelativeNatural.colimitHomotopyMap_fac η hη X Y w

-- 空語を含め同じ元の固定語の比較を供給する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] {W : MorphismProperty C} [W.IsMultiplicative]
    {V : MorphismProperty D} [V.IsMultiplicative] {F G : LocalizerMorphism W V}
    (η : F.functor ⟶ G.functor) (hη : ∀ X, V (η.app X)) (X Y : C) :
    Nonempty (SSet.Homotopy (RelativeNatural.beforeMap η Word.empty X Y)
      (RelativeNatural.afterMap η Word.empty X Y)) :=
  ⟨RelativeNatural.fixedWordHomotopy η hη Word.empty X Y⟩

-- 葉が元の端点である場合も除外しない合成関手の弱同値性。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    {T : WideSubquiver (Quiver.Symmetrify Q)} [Quiver.Arborescence T]
    {S : Finset Q} (D : QuiverTree.LeafDeletion T S) :
    letI := FiniteQuiver.quiver S
    ∀ x y : Paths (FiniteQuiver.Vertex S),
      IsWeakHomotopyEquivalence (Relative.colimitMap D.collapseRelative x y) :=
  D.collapse_colimitMap_isWeakHomotopyEquivalence

-- 任意可換環の実際の全自由次数で同じ葉の合成の弱同値性を検査。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity
  SerrePositivity.EInfinity.SimplicialLocalization SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (A : (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    let Q := MarkedGenerators.quiver W
    ∀ (S : Finset (FreeQuiverCover.Vertex (Q := Q) A))
      (hne : ∃ x ∈ S, x ≠ FreeQuiverCover.root (Q := Q) A),
    letI := FreeQuiverCover.quiver (Q := Q) A
    letI := FreeQuiverCover.spanningTreeArborescence (Q := Q) A
    let D := FreeQuiverCover.finiteHullLeafDeletion (Q := Q) A S hne
    letI := FiniteQuiver.quiver (FreeQuiverCover.finiteHull (Q := Q) A S)
    ∀ x y : Paths (FiniteQuiver.Vertex (FreeQuiverCover.finiteHull (Q := Q) A S)),
      IsWeakHomotopyEquivalence (Relative.colimitMap D.collapseRelative x y) := by
  intro C W Q S hne
  let := FreeQuiverCover.quiver (Q := Q) A
  let := FreeQuiverCover.spanningTreeArborescence (Q := Q) A
  exact QuiverTree.LeafDeletion.collapse_colimitMap_isWeakHomotopyEquivalence
    (FreeQuiverCover.finiteHullLeafDeletion (Q := Q) A S hne)

-- 元の二つの隣接合成から中間の弱同値性を回収する。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {A B C D : SSet.{e2ComplexLimitUniverse}} (f : A ⟶ B) (g : B ⟶ C) (h : C ⟶ D)
    (hfg : IsWeakHomotopyEquivalence (f ≫ g)) (hgh : IsWeakHomotopyEquivalence (g ≫ h)) :
    IsWeakHomotopyEquivalence g := weak_middle_of_composites f g h hfg hgh

-- 根だけの集合でも元の終射の弱同値性を使う。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    (T : WideSubquiver (Quiver.Symmetrify Q)) [Quiver.Arborescence T]
    [Quiver.IsThin (Quiver.FreeGroupoid Q)] :
    let S : Finset Q := {Quiver.root T}
    letI := FiniteQuiver.quiver S
    ∀ x y : Paths (FiniteQuiver.Vertex S),
      IsWeaklyContractible (colimitGraph
        (⊤ : MorphismProperty (Paths (FiniteQuiver.Vertex S))) x y) :=
  QuiverTree.root_colimit_isWeaklyContractible T (fun _ hx => Finset.mem_singleton.mp hx)

-- 任意の元の根に閉じた有限集合の全端点で可縮性を回収する。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    (T : WideSubquiver (Quiver.Symmetrify Q)) [Quiver.Arborescence T]
    [Quiver.IsThin (Quiver.FreeGroupoid Q)] (S : Finset Q) (hS : QuiverTree.RootClosed T S) :
    letI := FiniteQuiver.quiver S
    ∀ x y : Paths (FiniteQuiver.Vertex S),
      IsWeaklyContractible (colimitGraph
        (⊤ : MorphismProperty (Paths (FiniteQuiver.Vertex S))) x y) :=
  QuiverTree.finite_colimit_isWeaklyContractible T S hS

-- 元の葉の除去と包含は別々にも弱同値を与える。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    (T : WideSubquiver (Quiver.Symmetrify Q)) [Quiver.Arborescence T]
    [Quiver.IsThin (Quiver.FreeGroupoid Q)] {S : Finset Q} (D : QuiverTree.LeafDeletion T S)
    (hS : QuiverTree.RootClosed T S) :
    letI := FiniteQuiver.quiver S
    letI := FiniteQuiver.quiver (S.erase D.leaf)
    (∀ x y : Paths (FiniteQuiver.Vertex S),
      IsWeakHomotopyEquivalence (Relative.colimitMap D.retractionRelative x y)) ∧
    (∀ x y : Paths (FiniteQuiver.Vertex (S.erase D.leaf)),
      IsWeakHomotopyEquivalence (Relative.colimitMap D.inclusionRelative x y)) :=
  ⟨QuiverTree.LeafDeletion.retraction_colimitMap_isWeakHomotopyEquivalence T D hS,
    QuiverTree.LeafDeletion.inclusion_colimitMap_isWeakHomotopyEquivalence T D hS⟩

-- 元の被覆の空集合の包も同じ実際の hammock で可縮。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (A : Q) :
    letI := FreeQuiverCover.quiver A
    letI := FiniteQuiver.quiver (FreeQuiverCover.finiteHull A ∅)
    ∀ x y : Paths (FiniteQuiver.Vertex (FreeQuiverCover.finiteHull A ∅)),
      IsWeaklyContractible (colimitGraph
        (⊤ : MorphismProperty (Paths (FiniteQuiver.Vertex (FreeQuiverCover.finiteHull A ∅)))) x y) :=
  FreeQuiverCover.finiteHull_colimit_isWeaklyContractible A ∅

-- 任意可換環の実際の全自由次数で全ての元の有限包を検査。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity
  SerrePositivity.EInfinity.SimplicialLocalization SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (A : (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    let Q := MarkedGenerators.quiver W
    ∀ S : Finset (FreeQuiverCover.Vertex (Q := Q) A),
    letI := FreeQuiverCover.quiver (Q := Q) A
    letI := FiniteQuiver.quiver (FreeQuiverCover.finiteHull (Q := Q) A S)
    ∀ x y : Paths (FiniteQuiver.Vertex (FreeQuiverCover.finiteHull (Q := Q) A S)),
      IsWeaklyContractible (colimitGraph
        (⊤ : MorphismProperty
          (Paths (FiniteQuiver.Vertex (FreeQuiverCover.finiteHull (Q := Q) A S)))) x y) := by
  intro C W Q S
  exact FreeQuiverCover.finiteHull_colimit_isWeaklyContractible (Q := Q) A S

-- 元の有限頂点自由圏の包含は全射列を区別する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (S : Finset Q) :
    letI := FiniteQuiver.quiver S
    (FiniteQuiver.pathInclusion S).Faithful := FiniteQuiver.pathInclusion_faithful S

-- 内部頂点を含む射列を持ち上げ、元の射列へ厳密に戻す。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q] (S : Finset Q)
    (x y : FiniteQuiver.Vertex S) (p : Quiver.Path x.val y.val) (hp : pathVertices p ⊆ S) :
    letI := FiniteQuiver.quiver S
    (FiniteQuiver.pathInclusion S).map (FiniteQuiver.liftArrow S x y p hp) = p :=
  FiniteQuiver.liftArrow_projection S x y p hp

-- 元の有限図式の全対象・全射を同じ有限支持へ持ち上げる。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q I : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    [Category.{e2ComplexLimitUniverse} I] [Fintype I] [∀ i j : I, Fintype (i ⟶ j)]
    (F : I ⥤ Paths Q) :
    let S := diagramPathSupport F
    letI := FiniteQuiver.quiver S
    FiniteQuiver.liftFunctor S F (diagramPathSupport_vertex F)
      (fun f => diagramPathSupport_arrow F f) ⋙ FiniteQuiver.pathInclusion S = F :=
  FiniteQuiver.liftFunctor_projection _ F (diagramPathSupport_vertex F)
    (fun f => diagramPathSupport_arrow F f)

-- 空語も含む元の有限 grid の同じ全関手を回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q I : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    (T : WideSubquiver (Quiver.Symmetrify Q)) [Quiver.Arborescence T]
    [Category.{e2ComplexLimitUniverse} I] [Fintype I] [∀ i j : I, Fintype (i ⟶ j)]
    {X Y : Paths Q} (F : I ⥤ Zigzag (⊤ : MorphismProperty (Paths Q)) Word.empty X Y) :
    letI := FiniteQuiver.quiver (FiniteGrid.hull T F)
    FiniteGrid.rootedFunctor T F ⋙
      Zigzag.Relative.functor (FiniteQuiver.pathRelative (FiniteGrid.hull T F)) = F :=
  FiniteGrid.rootedFunctor_projection T F

-- 元の任意の有限 grid を含む有限包の hammock は弱可縮。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {Q I : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    (T : WideSubquiver (Quiver.Symmetrify Q)) [Quiver.Arborescence T]
    [Quiver.IsThin (Quiver.FreeGroupoid Q)] [Category.{e2ComplexLimitUniverse} I]
    [Fintype I] [∀ i j : I, Fintype (i ⟶ j)] {a : Word} {X Y : Paths Q}
    (F : I ⥤ Zigzag (⊤ : MorphismProperty (Paths Q)) a X Y) :
    letI := FiniteQuiver.quiver (FiniteGrid.hull T F)
    IsWeaklyContractible (colimitGraph
      (⊤ : MorphismProperty (Paths (FiniteQuiver.Vertex (FiniteGrid.hull T F))))
      ((Paths.of (FiniteQuiver.Vertex (FiniteGrid.hull T F))).obj (FiniteGrid.leftVertex T F))
      ((Paths.of (FiniteQuiver.Vertex (FiniteGrid.hull T F))).obj (FiniteGrid.rightVertex T F))) :=
  FiniteGrid.rootedHammock_isWeaklyContractible T F

-- 任意可換環の実際の全自由次数・全 hammock 次数で元の grid の回収を検査。
open CategoryTheory SerrePositivity.EInfinity SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n m : SimplexCategoryᵒᵖ)
    (A : (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    let Q := MarkedGenerators.quiver W
    letI := FreeQuiverCover.quiver (Q := Q) A
    letI := FreeQuiverCover.spanningTreeArborescence (Q := Q) A
    ∀ (a : Word) (X Y : Paths (FreeQuiverCover.Vertex (Q := Q) A))
      (σ : (graph (⊤ : MorphismProperty (Paths (FreeQuiverCover.Vertex (Q := Q) A))) a X Y).obj m),
    let T := FreeQuiverCover.spanningTree (Q := Q) A
    letI := FiniteQuiver.quiver (FiniteGrid.hull T σ)
    FiniteGrid.rootedFunctor T σ ⋙
      Zigzag.Relative.functor (FiniteQuiver.pathRelative (FiniteGrid.hull T σ)) = σ := by
  intro C W Q
  let := FreeQuiverCover.quiver (Q := Q) A
  let := FreeQuiverCover.spanningTreeArborescence (Q := Q) A
  intro a X Y σ
  exact FiniteGrid.rootedFunctor_projection (FreeQuiverCover.spanningTree (Q := Q) A) σ

-- 有限集合の包含で移した元の zigzag の単体を射影が区別する。
open CategoryTheory SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    (T : WideSubquiver (Quiver.Symmetrify Q)) [Quiver.Arborescence T]
    (X Y : Q) (a : Word) (S : Finset Q) (n : SimplexCategoryᵒᵖ) :
    Function.Injective ((nerveMap (RootedFinite.projectionFunctor T X Y a S)).app n) :=
  RootedFinite.projection_nerve_injective T X Y a S n

-- 全端点の元の hammock を有限包の元の余極限から回収する。
open CategoryTheory CategoryTheory.Limits SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    (T : WideSubquiver (Quiver.Symmetrify Q)) [Quiver.Arborescence T] (X Y : Q) :
    colimit (RootedFinite.hammockDiagram T X Y) ≅
      colimitGraph (⊤ : MorphismProperty (Paths Q)) ((Paths.of Q).obj X) ((Paths.of Q).obj Y) :=
  RootedFinite.hammockColimitIso T X Y

-- 根付き木の全体の同じ hammock の可縮性。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    (T : WideSubquiver (Quiver.Symmetrify Q)) [Quiver.Arborescence T]
    [Quiver.IsThin (Quiver.FreeGroupoid Q)] (X Y : Q) :
    IsWeaklyContractible (colimitGraph (⊤ : MorphismProperty (Paths Q))
      ((Paths.of Q).obj X) ((Paths.of Q).obj Y)) :=
  RootedFinite.colimit_isWeaklyContractible T X Y

-- 元の評価の fiber の可縮性は被覆性を追加の入力にしない。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    (A : Q) (Y : Paths Q)
    (β : (Quiver.FreeGroupoid.of Q).obj A ⟶ FreeQuiverCover.positiveEvaluation.obj Y) :
    IsWeaklyContractible (SimplicialValueFiber.space
      (Zigzag.Value.colimitValue FreeQuiverCover.positiveEvaluation
        FreeQuiverCover.positiveEvaluation_inverts_top ((Paths.of Q).obj A) Y) β) :=
  FreeQuiverCover.existingHammockValueFiber_isWeaklyContractible A Y β

-- 各項の弱同値を元の有限部分集合の余極限の同じ射へ移す。
open CategoryTheory CategoryTheory.Limits SerrePositivity.InfinityCategories
  SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse}
    {F G : Finset Q ⥤ SSet.{e2ComplexLimitUniverse}} (η : F ⟶ G)
    (hη : ∀ S, IsWeakHomotopyEquivalence (η.app S)) :
    IsWeakHomotopyEquivalence (colim.map η) := weakFiniteSubsetColimitMap η hη

-- 任意可換環の実際の全自由次数で被覆全体へ代入する。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity
  SerrePositivity.EInfinity.SimplicialLocalization SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ)
    (A : (freeResolutionGeneratorBase (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    let Q := MarkedGenerators.quiver W
    letI := FreeQuiverCover.quiver (Q := Q) A
    ∀ X Y : Paths (FreeQuiverCover.Vertex (Q := Q) A),
      IsWeaklyContractible (colimitGraph
        (⊤ : MorphismProperty (Paths (FreeQuiverCover.Vertex (Q := Q) A))) X Y) := by
  intro C W Q
  exact FreeQuiverCover.colimit_isWeaklyContractible (Q := Q) A

-- 元の値への射自身を、各 fiber の弱可縮性で判定する。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {B : Type e2ComplexLimitUniverse} {X : SSet.{e2ComplexLimitUniverse}}
    (ℓ : X ⟶ (Functor.const SimplexCategoryᵒᵖ).obj B)
    (hc : ∀ β, IsWeaklyContractible (SimplicialValueFiber.space ℓ β)) :
    IsWeakHomotopyEquivalence ℓ := ValueSupport.weak_of_contractible_fibers ℓ hc

-- 値の型が空の場合も同じ射の弱同値性を回収する。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {B : Type e2ComplexLimitUniverse} [IsEmpty B] {X : SSet.{e2ComplexLimitUniverse}}
    (ℓ : X ⟶ (Functor.const SimplexCategoryᵒᵖ).obj B) :
    IsWeakHomotopyEquivalence ℓ :=
  ValueSupport.weak_of_contractible_fibers ℓ (fun β => isEmptyElim β)

-- 元の圏同値の unit/counit による比較は厳密逆を要求しない。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] (e : C ≌ D) (X Y : C) :
    IsWeakHomotopyEquivalence (Relative.colimitMap (topRelative e.functor) X Y) :=
  topEquivalence_colimitMap_weak e X Y

-- 元の自由圏の hammock 評価自身の弱同値性。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {Q : Type e2ComplexLimitUniverse} [Quiver.{e2ComplexLimitUniverse} Q]
    (A : Q) (Y : Paths Q) : IsWeakHomotopyEquivalence
      (Zigzag.Value.colimitValue FreeQuiverCover.positiveEvaluation
        FreeQuiverCover.positiveEvaluation_inverts_top ((Paths.of Q).obj A) Y) :=
  FreeQuiverCover.existingHammockValue_isWeakHomotopyEquivalence A Y

-- 元の指定部分圏の評価に、W の乗法性の追加入力はない。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (X Y : Paths C) :
    IsWeakHomotopyEquivalence (UnmarkedGenerators.AllMarked.nativeValue W X Y) :=
  UnmarkedGenerators.AllMarked.nativeValue_isWeakHomotopyEquivalence W X Y

-- 任意可換環の実際の全自由次数の指定部分圏の評価へ代入する。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity
  SerrePositivity.EInfinity.SimplicialLocalization SerrePositivity.EInfinity.Hammock in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    ∀ X Y : Paths C,
      IsWeakHomotopyEquivalence (UnmarkedGenerators.AllMarked.nativeValue W X Y) := by
  intro C W X Y
  exact UnmarkedGenerators.AllMarked.nativeValue_isWeakHomotopyEquivalence W X Y

-- 任意の元の二つの弱比較の直積。始終域の Kan 性は不要。
open CategoryTheory MonoidalCategory SerrePositivity.InfinityCategories
  SerrePositivity.EInfinity.Hammock in
example {A B C D : SSet.{e2ComplexLimitUniverse}} {f : A ⟶ B} {g : C ⟶ D}
    (hf : IsWeakHomotopyEquivalence f) (hg : IsWeakHomotopyEquivalence g) :
    IsWeakHomotopyEquivalence (f ⊗ₘ g) := weakTensor hf hg

-- 空の場合も含む任意の同じ添字での依存和の比較。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock in
example {I : Type e2ComplexLimitUniverse} {A B : I → SSet.{e2ComplexLimitUniverse}}
    (f : ∀ i, A i ⟶ B i) (hf : ∀ i, IsWeakHomotopyEquivalence (f i)) :
    IsWeakHomotopyEquivalence (IndexedSum.map f) := IndexedSum.map_weak f hf

-- 長さ零の元の指定因子を同じ全因子列へ回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (X Y : Paths C) (n : SimplexCategoryᵒᵖ)
    (p : (UnmarkedGenerators.AllMarked.nativeSpace W X Y).obj n) :
    (MarkedSpine.productsIso W Y X).hom.app n ⟨[], p⟩ = MarkedSpine.nil X p :=
  MarkedSpine.productsIso_hom_nil W Y X p

-- 元の hammock から全指定因子の値の列への同じ評価自身の弱同値性。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (X Y : Paths C) :
    IsWeakHomotopyEquivalence (MarkedSpine.hammockEvaluation W Y X) :=
  MarkedSpine.hammockEvaluation_isWeakHomotopyEquivalence W Y X

-- 値の因子列の圏への元の指定部分の矢は実際に反転される。
open CategoryTheory SerrePositivity.EInfinity.SimplicialLocalization
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) {X Y : Quiver.FreeGroupoid (MarkedGenerators.quiver W)} (p : X ⟶ Y) :
    letI := MarkedSpine.valueCategory W
    IsIso ((MarkedSpine.valueMarkedFunctor W).map p) :=
  MarkedSpine.valueMarkedFunctor_map_isIso W p

-- 任意可換環の全自由次数の元の全因子列の評価へ代入する。
open CategoryTheory SerrePositivity.InfinityCategories SerrePositivity.EInfinity
  SerrePositivity.EInfinity.SimplicialLocalization SerrePositivity.EInfinity.Hammock
  SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example (R : Type e2ComplexLimitUniverse) [CommRing R] (n : SimplexCategoryᵒᵖ) :
    let C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).category
    let W : MorphismProperty C := (freeResolutionGeneratorBase
      (BarrattEccles.cofibrantAlgebraRelativeCategory R) n).weakEquivalences
    ∀ X Y : Paths C, IsWeakHomotopyEquivalence (MarkedSpine.hammockEvaluation W Y X) := by
  intro C W X Y
  exact MarkedSpine.hammockEvaluation_isWeakHomotopyEquivalence W Y X

-- 元の自由圏からの関手は元の W.paths を反転する。
open CategoryTheory SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) :
    letI := MarkedSpine.valueCategory W
    W.paths.IsInvertedBy (MarkedSpine.valueLift W) := MarkedSpine.valueLift_inverts W

-- 任意の反転関手を値の因子列から延長して元の全自由射列の関手へ厳密に戻す。
open CategoryTheory SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C D : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    [Category.{e2ComplexLimitUniverse} D] (W : MorphismProperty C) (F : Paths C ⥤ D)
    (hF : W.paths.IsInvertedBy F) :
    letI := MarkedSpine.valueCategory W
    MarkedSpine.valueLift W ⋙ MarkedSpine.valueDescent W F hF = F :=
  MarkedSpine.valueDescent_fac W F hF

-- 元の Q の同じ Hom を元の値の因子列から両側逆で回収する。
open CategoryTheory SerrePositivity.EInfinity.Hammock.UnmarkedGenerators.FirstFactor in
example {C : Type e2ComplexLimitUniverse} [Category.{e2ComplexLimitUniverse} C]
    (W : MorphismProperty C) (X Y : Paths C) (p : W.paths.Q.obj X ⟶ W.paths.Q.obj Y) :
