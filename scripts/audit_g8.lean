-- The exact G8 request, for arbitrary rings and arbitrary unbounded actual objects.
noncomputable section
universe u
open CategoryTheory SerrePositivity SerrePositivity.DerivedCompletion
attribute [local instance] HasDerivedCategory.standard
example {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S) (a : R) :
    derivedComplexCompletionFunctor S (f a) ⋙ derivedRestrictScalars f ≅
      derivedRestrictScalars f ⋙ derivedComplexCompletionFunctor R a :=
  derivedRestrictionCompletionIso f a

example {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S) (a : R)
    (X : DerivedCategory (ModuleCat.{u} S)) :
    (derivedRestrictScalars f).map ((derivedComplexCompletionUnit S (f a)).app X) ≫
        (derivedRestrictionCompletionIso f a).hom.app X =
      (derivedComplexCompletionUnit R a).app ((derivedRestrictScalars f).obj X) :=
  derivedRestrictionCompletionIso_unit f a X
