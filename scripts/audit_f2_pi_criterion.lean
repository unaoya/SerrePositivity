universe u v
example (κ : Cardinal.{u}) [Fact κ.IsRegular] :
    SerrePositivity.InfinityCategories.HA.DerivedCategoryModels.CoherentBar.Compact.DGBarCompactFilteredSpacePiBridge.{u, v} κ :=
  SerrePositivity.InfinityCategories.Project.DerivedCategories.PiCriterion.dgBarCompactFilteredSpacePiBridge κ

#print axioms SerrePositivity.InfinityCategories.Project.DerivedCategories.PiCriterion.dgBarCompactFilteredSpacePiBridge

open Lean in
run_cmd do
  let oldAuditPrefix1 := `SerrePositivity.InfinityCategories.Derived.PiCriterion
  let klw1AuditLayout1 ← IO.ofExcept <| Lean.Json.parse (← IO.FS.readFile "scripts/refactor/targets/bulk-kl-module-map.json")
  let klw1AuditLayout1 ← IO.ofExcept klw1AuditLayout1.getObj?
  let klw1AuditOwners1 := Std.HashSet.ofList (klw1AuditLayout1.toList.filterMap fun (source, dest) =>
    if oldAuditPrefix1.isPrefixOf source.toName then dest.getStr?.toOption.map String.toName else none)
  let env ← getEnv
  let mut count : Nat := 0
  for (name, _) in env.constants.toList do
    let some idx := env.getModuleIdxFor? name | continue
    let mod := env.header.modules[idx.toNat]!.module
    unless (oldAuditPrefix1.isPrefixOf mod || klw1AuditOwners1.contains mod) do
      continue
    let axioms ← collectAxioms name
    unless axioms.all (#[``propext, ``Classical.choice, ``Quot.sound].contains ·) do
      throwError "PiCriterion: unexpected axioms in {name}: {axioms}"
    count := count + 1
  if count == 0 then throwError "PiCriterion: no declarations audited"
  logInfo m!"PiCriterion audit passed: {count} declarations, standard three axioms only."
