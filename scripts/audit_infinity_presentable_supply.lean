import SerrePositivity.InfinityCategories.Project.Entrypoints.F2PresentableSupplyAll
import SerrePositivity.InfinityCategories.Kerodon.LargeInfinityCategories.PresentableInfinityCategories.CosliceBaseChangePreservation
import Lean.Util.CollectAxioms

/-!
概要：P-s の供給宣言を公理監査する。
方針：宣言の所属モジュールを調べ、再帰的な公理依存を検査する。
規約：許す公理は propext・Classical.choice・Quot.sound のみ。
使われ方：Supply.All の対象ビルド後に lake env lean で実行する。
CosliceBaseChangePreservation も同時 import し、局所 instance 名の衝突を検出する。
-/

open Lean in
run_cmd do
  let oldAuditPrefix1 := `SerrePositivity.InfinityCategories.F2.Presentable.Supply
  let klw1AuditLayout1 ← IO.ofExcept <| Lean.Json.parse (← IO.FS.readFile "scripts/refactor/targets/kl-module-map.json")
  let klw1AuditLayout1 ← IO.ofExcept klw1AuditLayout1.getObj?
  let klw1AuditOwners1 := Std.HashSet.ofList (klw1AuditLayout1.toList.filterMap fun (source, dest) =>
    if oldAuditPrefix1.isPrefixOf source.toName then dest.getStr?.toOption.map String.toName else none)
  let env ← getEnv
  let mut count : Nat := 0
  for (name, _) in env.constants.toList do
    let some idx := env.getModuleIdxFor? name | continue
    let mod := env.header.modules[idx.toNat]!.module
    unless (oldAuditPrefix1.isPrefixOf mod || klw1AuditOwners1.contains mod) do
      continue
    let axioms ← collectAxioms name
    unless axioms.all (#[``propext, ``Classical.choice, ``Quot.sound].contains ·) do
      throwError "Presentable supply: unexpected axioms in {name}: {axioms}"
    count := count + 1
  if count == 0 then throwError "Presentable supply: no declarations audited"
  logInfo m!"Presentable supply audit passed: {count} declarations, standard three axioms only."

