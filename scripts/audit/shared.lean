  let allowedFiles : List String := ["SerrePositivity/Paper/Section4/SupportedDescent.lean", "SerrePositivity/Inputs/Descent.lean", "SerrePositivity/InfinityCategories/Project/ModelCategoryComparison/Inputs/KanQuillen.lean"]
