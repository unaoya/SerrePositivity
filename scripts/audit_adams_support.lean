import SerrePositivity.PerfectComplex.ClosedSupportRelations
import Mathlib.Util.AssertNoSorry

-- S1.1: closed support and comparison with the existing ideal support.
assert_no_sorry SerrePositivity.hasHomologySupportOn_zeroLocus
assert_no_sorry SerrePositivity.supportZeroLocus_eq
assert_no_sorry SerrePositivity.HasHomologySupportOn.mono
assert_no_sorry SerrePositivity.hasHomologySupportOn_inf

-- S1.2: closure and empty support.
assert_no_sorry SerrePositivity.module_support_subset_union_of_exact
assert_no_sorry SerrePositivity.HasHomologySupportOn.of_homotopyEquiv
assert_no_sorry SerrePositivity.HasHomologySupportOn.shift
assert_no_sorry SerrePositivity.HasHomologySupportOn.mappingCone
assert_no_sorry SerrePositivity.hasHomologySupportOn_bot_iff

-- S1.3: perfect closed-support category and its universal K₀.
assert_no_sorry SerrePositivity.perfectHomotopyObj_supportedOn_iff
assert_no_sorry SerrePositivity.supportedPerfectOnObj
assert_no_sorry SerrePositivity.K0WithSupport.lift
assert_no_sorry SerrePositivity.K0WithSupport.hom_ext
assert_no_sorry SerrePositivity.K0WithSupport.mk_triangle
assert_no_sorry SerrePositivity.K0WithSupport.mk_shift_one

-- S1.4: comparison with the existing scalar and finite-free models.
assert_no_sorry SerrePositivity.supportedPerfectClosedEquivalence
assert_no_sorry SerrePositivity.scalarClosedSupportK0Equiv
assert_no_sorry SerrePositivity.freeToClosedSupportK0
assert_no_sorry SerrePositivity.freeClosedSupportK0Equiv

-- S1.5: arbitrary base change, support enlargement, and functorial identities.
assert_no_sorry SerrePositivity.HasHomologySupportOn.baseChange
assert_no_sorry SerrePositivity.K0WithSupport.enlarge_refl
assert_no_sorry SerrePositivity.K0WithSupport.enlarge_comp
assert_no_sorry SerrePositivity.K0WithSupport.map_comp
assert_no_sorry SerrePositivity.K0WithSupport.map_id
assert_no_sorry SerrePositivity.K0WithSupport.enlarge_map
assert_no_sorry SerrePositivity.freeToClosedSupportK0_map

-- S1.6: quasi-isomorphisms, cones, short exact sequences, and empty support.
assert_no_sorry SerrePositivity.strictlyPerfectComplex_quasiIso_iff
assert_no_sorry SerrePositivity.supportedPerfectOnConeTriangle_distinguished
assert_no_sorry SerrePositivity.closedSupportConeShortComplex_shortExact
assert_no_sorry SerrePositivity.K0WithSupport.mk_cone
assert_no_sorry SerrePositivity.K0WithSupport.mk_eq_of_quasiIso
assert_no_sorry SerrePositivity.K0WithSupport.mk_eq_zero_of_acyclic
assert_no_sorry SerrePositivity.K0WithSupport.mk_shortExact
assert_no_sorry SerrePositivity.K0WithSupport.mk_degreewise_shortExact
assert_no_sorry SerrePositivity.K0WithSupport.eq_zero_of_empty_support
assert_no_sorry SerrePositivity.closedSupport_shortExactAdditive_iff_triangleAdditive

