-- 引用3の実際の基底に、独立な整域性・Noether性のインスタンスも供給できる。
section
variable (h p : ℕ) [Fact p.Prime] (k : Type*) [Field k] [CharP k p] [PerfectField k]
#synth IsDomain (MvPowerSeries {i : Fin h // (i : ℕ) ≠ 0} (WittVector p k))
#synth IsNoetherianRing (MvPowerSeries {i : Fin h // (i : ℕ) ≠ 0} (WittVector p k))
end
