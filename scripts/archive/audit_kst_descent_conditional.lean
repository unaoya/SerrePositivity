import SerrePositivity.KST.Descent
import SerrePositivity.Archive.KST.DescentConditional.Auxiliary
import Lean.Util.CollectAxioms

/-!
## 概要
K-L8 の全宣言を内部補助宣言も含めて監査する。
## 方針
定数の定義元モジュールで選び、再帰的な依存公理を検査する。
## 規約
許容する公理は標準三公理だけ。公理の監査と数学的工程の完成は別に判定する。
## 使われ方
各保存単位で `lake env lean scripts/audit_kst_descent.lean` を実行する。
-/

open Lean in
set_option maxHeartbeats 0 in
run_cmd do
  let env ← getEnv
  let mut declarations : Nat := 0
  let mut modules : Array Name := #[]
  for (name, _) in env.constants.toList do
    let some idx := env.getModuleIdxFor? name | continue
    let mod := env.header.modules[idx.toNat]!.module
    unless (`SerrePositivity.KST.Descent).isPrefixOf mod ||
        (`SerrePositivity.Archive.KST.DescentConditional).isPrefixOf mod do continue
    let axioms ← collectAxioms name
    let unexpected := axioms.filter fun ax ↦
      !(#[``propext, ``Classical.choice, ``Quot.sound].contains ax)
    unless unexpected.isEmpty do throwError "Unexpected axioms in {name}: {unexpected}"
    declarations := declarations + 1
    unless modules.contains mod do modules := modules.push mod
  for expected in #[`SerrePositivity.KST.Descent.TransferBaseChangeComposite,
      `SerrePositivity.Archive.KST.DescentConditional.TransferRankChartBaseChangeDescent,
