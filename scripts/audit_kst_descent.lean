      `SerrePositivity.KST.Descent.FiniteTypeLimits,
      `SerrePositivity.KST.Descent.FiniteTypeStrictTransform,
      `SerrePositivity.KST.Descent.FiniteTypeCech,
      `SerrePositivity.KST.Descent.EquivariantPullbackComparison,
      `SerrePositivity.KST.Descent.AffinePullbackDescent,
      `SerrePositivity.KST.Descent.FiniteTypeCechAction,
      `SerrePositivity.KST.Descent.FiniteTypeLimitPreservation,
      `SerrePositivity.KST.Descent.FiniteTypeCechGeometry,
      `SerrePositivity.KST.Descent.AffineFiniteDimension,
      `SerrePositivity.KST.Descent.CechFiniteDimension,
      `SerrePositivity.KST.Descent.SchemeActionTransport,
      `SerrePositivity.KST.Descent.AffineSchemeBaseChange,
      `SerrePositivity.KST.Descent.FiniteTypeAffineBaseChange,
      `SerrePositivity.KST.Descent.AffineCechDescent,
      `SerrePositivity.KST.Descent.CechPullback,
      `SerrePositivity.KST.Descent.CechBaseChange,
      `SerrePositivity.KST.Descent.CechBaseChangeOver,
      `SerrePositivity.KST.Descent.ObservedTransfer,
      `SerrePositivity.KST.Descent.DoubleCechGeometry,
      `SerrePositivity.KST.Descent.DoubleCechNaturality,
      `SerrePositivity.KST.Descent.CechHomotopyIndex,
      `SerrePositivity.KST.Descent.CechRefinementHomotopy,
      `SerrePositivity.KST.Descent.CechRefinementEquivalence] do
    unless modules.contains expected do throwError "Required module missing: {expected}"
  logInfo m!"KST descent audit passed: {declarations} declarations in {modules.size} modules."
  logInfo "Standard axioms only. This checks dependencies, not completion of Theorem 3.1."
