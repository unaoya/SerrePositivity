  let expected := #[
    `SerrePositivity.InfinityCategories.Stable.Cocone,
    `SerrePositivity.InfinityCategories.Stable.PushoutShape,
    `SerrePositivity.InfinityCategories.Stable.Pointed,
    `SerrePositivity.InfinityCategories.Stable.FiniteShapes,
    `SerrePositivity.InfinityCategories.Stable.Definition,
    `SerrePositivity.InfinityCategories.Stable.ZeroHomotopy,
    `SerrePositivity.InfinityCategories.Stable.InitialTransport,
    `SerrePositivity.InfinityCategories.Stable.SuspensionSquare,
    `SerrePositivity.InfinityCategories.Stable.SuspensionDiagrams,
    `SerrePositivity.InfinityCategories.Stable.CoconeFamily,
    `SerrePositivity.InfinityCategories.Stable.CoconeFixedComparison,
    `SerrePositivity.InfinityCategories.Stable.FatJoinRightTensor,
    `SerrePositivity.InfinityCategories.Stable.LaxCoslice,
    `SerrePositivity.InfinityCategories.Stable.LaxCosliceUncurry,
    `SerrePositivity.InfinityCategories.Stable.LaxCosliceUniversal,
    `SerrePositivity.InfinityCategories.Stable.LaxCosliceNaturality,
    `SerrePositivity.InfinityCategories.Stable.RightJoinCoproduct,
    `SerrePositivity.InfinityCategories.Stable.CosliceCylinderExtension,
    `SerrePositivity.InfinityCategories.Stable.CosliceCylinderFixedDiagram,
    `SerrePositivity.InfinityCategories.Stable.CosliceFixedDiagramIso,
    `SerrePositivity.InfinityCategories.Stable.CosliceLaxEquivalence,
    `SerrePositivity.InfinityCategories.Stable.FatJoinRightTensorComparison,
    `SerrePositivity.InfinityCategories.Stable.CosliceCoconeFamilyEquivalence,
    `SerrePositivity.InfinityCategories.Stable.ColimitCoconeFamily,
    `SerrePositivity.InfinityCategories.Stable.BoundaryOpposite,
    `SerrePositivity.InfinityCategories.Stable.InitialOpposite,
    `SerrePositivity.InfinityCategories.Stable.RelativeInitialBoundary,
    `SerrePositivity.InfinityCategories.Stable.VertexFiberOpposite,
    `SerrePositivity.InfinityCategories.Stable.CartesianInitialBoundary,
    `SerrePositivity.InfinityCategories.Stable.CoconeLastVertex,
    `SerrePositivity.InfinityCategories.Stable.CoconeTransport,
    `SerrePositivity.InfinityCategories.Stable.CoconeTransportPrism,
    `SerrePositivity.InfinityCategories.Stable.CoconeRestrictionEdges,
    `SerrePositivity.InfinityCategories.Stable.FinalHornProductBoundary,
    `SerrePositivity.InfinityCategories.Stable.FinalHornRestrictionLifting,
    `SerrePositivity.InfinityCategories.Stable.CoconeRestrictionCartesianEdge,
    `SerrePositivity.InfinityCategories.Stable.CoconeCartesianTransport,
    `SerrePositivity.InfinityCategories.Stable.CoconeRestrictionOppositeFibration,
    `SerrePositivity.InfinityCategories.Stable.ColimitRelativeBoundary,
    `SerrePositivity.InfinityCategories.Stable.RelativeInitialVertices,
    `SerrePositivity.InfinityCategories.Stable.ColimitCoconeFamilies,
    `SerrePositivity.InfinityCategories.Stable.TerminalPrismBoundary,
    `SerrePositivity.InfinityCategories.Stable.ZeroTargetArrows,
    `SerrePositivity.InfinityCategories.Stable.SpanFamilies,
    `SerrePositivity.InfinityCategories.Stable.SuspensionDiagramArrows,
    `SerrePositivity.InfinityCategories.Stable.SuspensionEvaluationLifting,
    `SerrePositivity.InfinityCategories.Stable.Suspension,
    `SerrePositivity.InfinityCategories.Stable.InitialExtension,
    `SerrePositivity.InfinityCategories.Stable.InitialPrismBoundary,
    `SerrePositivity.InfinityCategories.Stable.ZeroSourceArrows,
    `SerrePositivity.InfinityCategories.Stable.LimitConeFamilies,
    `SerrePositivity.InfinityCategories.Stable.CospanFamilies,
    `SerrePositivity.InfinityCategories.Stable.LoopDiagramArrows,
    `SerrePositivity.InfinityCategories.Stable.LoopEvaluationLifting,
    `SerrePositivity.InfinityCategories.Stable.Loop,
    `SerrePositivity.InfinityCategories.Stable.SuspensionEquivalence,
    `SerrePositivity.InfinityCategories.Stable.PastingShapes,
    `SerrePositivity.InfinityCategories.Stable.CosliceRestriction,
    `SerrePositivity.InfinityCategories.Stable.PrismRetraction,
    `SerrePositivity.InfinityCategories.Stable.PastingCorner,
    `SerrePositivity.InfinityCategories.Stable.ColimitRestriction,
    `SerrePositivity.InfinityCategories.Stable.PastingCofinality]
  let mut count : Nat := 0
  let mut seen : Array Name := #[]
  for (name, _) in env.constants.toList do
    let some idx := env.getModuleIdxFor? name | continue
    let mod := env.header.modules[idx.toNat]!.module
    unless expected.contains mod do continue
    let axioms ← collectAxioms name
    unless axioms.all (#[``propext, ``Classical.choice, ``Quot.sound].contains ·) do
      throwError "Unexpected axioms in {name}: {axioms}"
    count := count + 1
    unless seen.contains mod do seen := seen.push mod
  for mod in expected do
    unless seen.contains mod do throwError "Module not audited: {mod}"
  logInfo m!"Stable axiom audit passed: {count} declarations in {seen.size} modules."
