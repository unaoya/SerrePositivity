    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.EpsilonTensorSeparation,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.EpsilonWordRigidity,
    `SerrePositivity.InfinityCategories.HA.DerivedCategoryModels.SuspensionAction.EpsilonCellRigidity,
    `SerrePositivity.InfinityCategories.HA.DerivedCategoryModels.SuspensionAction.NativeUnitRequirement,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.NativeSimplexLift,
    `SerrePositivity.InfinityCategories.HA.DerivedCategoryModels.SuspensionAction.EpsilonSimplexLift,
