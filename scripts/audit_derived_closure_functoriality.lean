    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.StrictRange,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.ExtensionRange,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.FamilyImage,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.FullFunctor,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.Comparison,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.Parameter,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.InputParameter,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.InputFunctor,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.NativeHom,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.ClosureFunctor,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.SphereFree,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.ModuleExtension,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.SphereClosure,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.Perfect,
    `SerrePositivity.InfinityCategories.Project.DerivedCategories.ClosureFunctoriality.ImageLaws,
    `SerrePositivity.InfinityCategories.HA.DerivedCategoryModels.SuspensionAction.QuotientNative,
    `SerrePositivity.InfinityCategories.HA.DerivedCategoryModels.SuspensionAction.NativeTarget,
    `SerrePositivity.InfinityCategories.HA.DerivedCategoryModels.SuspensionAction.ConeData,
    `SerrePositivity.InfinityCategories.HA.DerivedCategoryModels.SuspensionAction.SphereConeData,
    `SerrePositivity.InfinityCategories.HA.DerivedCategoryModels.SuspensionAction.UnconditionalData,
    `SerrePositivity.InfinityCategories.HA.DerivedCategoryModels.SuspensionAction.QuotientParameter,
    `SerrePositivity.InfinityCategories.HA.DerivedCategoryModels.SuspensionAction.QuotientContractionComparison,
    `SerrePositivity.InfinityCategories.HA.DerivedCategoryModels.SuspensionAction.ResolvedZeroObstruction]
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut counts : Array Nat := modules.map (fun _ => 0)
  for (name, _) in env.constants.toList do
    let some index := env.getModuleIdxFor? name | continue
    let moduleName := env.header.modules[index.toNat]!.module
    let some position := modules.idxOf? moduleName | continue
    let dependencies ← collectAxioms name
    for dependency in dependencies do
      unless allowed.contains dependency do
        throwError "Forbidden axiom {dependency} in {name}"
    counts := counts.modify position (· + 1)
  for position in [:modules.size] do
    unless counts[position]! > 0 do
      throwError "No declarations checked in {modules[position]!}"
  let total := counts.foldl (· + ·) (0 : Nat)
  logInfo m!"D-S closure audit passed: {total} declarations in {modules.size} modules."

