    (M : ModuleCat.{0} R) :
    ((cochainLinearDualFunctor K).obj M).restriction nonnegativeCochainEmbedding ≅
      (chainLinearYonedaFunctor (toChain K)).obj M :=
  cochainLinearDualNonnegativeIso K M

