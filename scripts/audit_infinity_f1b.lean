/-- 監査の補助：本体の環境の中で、与えたモジュールから import を辿った閉包（別環境を読み込む代わりに本体の環境で辿る。2026-11-17、A1）。 -/
def auditImportClosure (env : Environment) (roots : Array Name) : Array Import := Id.run do
  let mut todo := roots
  let mut visited : Std.HashSet Name := {}
  let mut out : Array Import := #[]
  while !todo.isEmpty do
    let m := todo.back!
    todo := todo.pop
    if visited.contains m then continue
    visited := visited.insert m
    out := out.push { module := m }
    if let some idx := env.getModuleIdx? m then
      for imp in env.header.moduleData[idx.toNat]!.imports do
        todo := todo.push imp.module
  return out


/-!
概要：α2b の全宣言を監査する。
方針：宣言元モジュールで抽出し、生成宣言を含め依存公理を再帰的に調べる。
規約：許す公理は propext・Classical.choice・Quot.sound のみ。
読み込んだリポジトリ内モジュールに straightening 系があれば拒否する。
使われ方：B1〜B5 の保存単位で対象ビルド後に実行する。
-/

open Lean in
run_cmd do
  let oldAuditPrefix1 := `SerrePositivity.InfinityCategories.F1B
  let klw1AuditLayout1 ← IO.ofExcept <| Lean.Json.parse (← IO.FS.readFile "scripts/refactor/targets/bulk-kl-module-map.json")
  let klw1AuditLayout1 ← IO.ofExcept klw1AuditLayout1.getObj?
  let klw1AuditOwners1 := Std.HashSet.ofList (klw1AuditLayout1.toList.filterMap fun (source, dest) =>
    if oldAuditPrefix1.isPrefixOf source.toName then dest.getStr?.toOption.map String.toName else none)
  let env ← getEnv
  let mut importedRepo : Nat := 0
  for mod in closureMods do
    unless `SerrePositivity |>.isPrefixOf mod.module do continue
    importedRepo := importedRepo + 1
    if (mod.module.toString.toLower.splitOn "straightening").length != 1 then
      throwError "F1B: forbidden straightening dependency: {mod.module}"
  logInfo m!"F1B import audit passed: {importedRepo} repository modules, no straightening."
  let mut count : Nat := 0
  for (name, _) in env.constants.toList do
    let some idx := env.getModuleIdxFor? name | continue
    let mod := env.header.modules[idx.toNat]!.module
    unless (oldAuditPrefix1.isPrefixOf mod || klw1AuditOwners1.contains mod) do continue
    let axioms ← collectAxioms name
    unless axioms.all (#[``propext, ``Classical.choice, ``Quot.sound].contains ·) do
      throwError "F1B: unexpected axioms in {name}: {axioms}"
    count := count + 1
  if count == 0 then throwError "F1B: no declarations audited"
  logInfo m!"F1B audit passed: {count} declarations, standard three axioms only."

