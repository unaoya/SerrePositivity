  for mod in required do
    unless env.header.modules.any (·.module == mod) do
      throwError "Missing general entry: {mod}"
  for mod in env.header.modules do
    if forbidden.contains mod.module ||
        (`SerrePositivity.HomotopicalAlgebra.Rectification).isPrefixOf mod.module then
      throwError "Dedicated rectification imported by general tools: {mod.module}"
  let mut declarations : Nat := 0
  let mut modules : Array Name := #[]
  for (name, _) in env.constants.toList do
    let some idx := env.getModuleIdxFor? name | continue
    let mod := env.header.modules[idx.toNat]!.module
    unless (`SerrePositivity).isPrefixOf mod do continue
    let axioms ← collectAxioms name
    let unexpected := axioms.filter fun ax ↦
      !(#[``propext, ``Classical.choice, ``Quot.sound].contains ax)
    unless unexpected.isEmpty do throwError "Unexpected axioms in {name}: {unexpected}"
    declarations := declarations + 1
    unless modules.contains mod do modules := modules.push mod
  if declarations == 0 then throwError "No general declarations audited"
  logInfo m!"Shared foundations audit: {declarations} declarations, {modules.size} modules; all {required.size} required modules (including split destinations) present."
  logInfo "No B/Rectification imports; standard axioms only."
