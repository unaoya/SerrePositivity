-- IF-W2c: 移動・分割先を定義元で監査し、私有宣言も標準三公理に限る。
open Lean in
set_option maxHeartbeats 0 in
run_cmd do
  let env ← getEnv
  let expected : Array Name := #[
    `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.ArrowCompositionCancellation,
    `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.ArrowInverseControl,
    `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.ArrowIsoRealization,
    `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.ArrowPostcompositionSquare,
    `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.ArrowPrecompositionSquare,
    `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.RelativeConeProductCurry,
    `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.RelativeMappingEdge,
    `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.SimplexTerminalArrowFamily,
    `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.SquareArrowFamily,
    `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.SquareDiagonalEdgeRestriction,
    `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.SquareFrameBoundary,
    `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.SquarePastingHorn,
    `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.SquareTransposeEdges,
    `SerrePositivity.InfinityCategories.HA.Section7_3_4.SquareZeroMultiplication
  ]
  let forbidModel : Array Name := #[`SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.ArrowCompositionCancellation, `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.ArrowInverseControl, `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.ArrowIsoRealization, `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.ArrowPostcompositionSquare, `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.ArrowPrecompositionSquare, `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.RelativeConeProductCurry, `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.RelativeMappingEdge, `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.SimplexTerminalArrowFamily, `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.SquareArrowFamily, `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.SquareDiagonalEdgeRestriction, `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.SquareFrameBoundary, `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.SquarePastingHorn, `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.SquareTransposeEdges, `SerrePositivity.InfinityCategories.HA.Section7_3_4.SquareZeroMultiplication,
    `SerrePositivity.InfinityCategories.Project.QuasicategoryAuxiliaries.Quasicategory.SquareZeroMultiplication,
]
  for mod in expected do
    unless env.header.modules.any (fun entry => entry.module == mod) do
      throwError "W2c: audit module not imported: {mod}"
  let mut count : Nat := 0
  let mut seen : Array Name := #[]
  for (name, info) in env.constants.toList do
    let some idx := env.getModuleIdxFor? name | continue
    let mod := env.header.modules[idx.toNat]!.module
    unless expected.contains mod do continue
    if forbidModel.contains mod && info.type.getUsedConstants.contains `HomotopicalAlgebra.ModelCategory then
      throwError "W2c: ModelCategory assumption in type of {name}"
    let axioms ← collectAxioms name
    unless axioms.all (#[``propext, ``Classical.choice, ``Quot.sound].contains ·) do
      throwError "W2c: unexpected axioms in {name}: {axioms}"
    unless seen.contains mod do seen := seen.push mod
    count := count + 1
  for mod in expected do
    unless seen.contains mod do throwError "W2c: module has no audited declarations: {mod}"
  logInfo m!"W2c: {count} declarations in {expected.size} modules audited."

