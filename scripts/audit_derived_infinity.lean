open Lean in
run_cmd do
  let env ← getEnv
  let expected := #[
    `SerrePositivity.InfinityCategories.Derived.ComplexEdgeCalculus,
    `SerrePositivity.InfinityCategories.Derived.ConeEdgeFunctoriality,
    `SerrePositivity.InfinityCategories.Derived.FiberSquareMaps,
    `SerrePositivity.InfinityCategories.Derived.FiberSquareTriangle,
    `SerrePositivity.InfinityCategories.Derived.ChainMapEdge,
    `SerrePositivity.InfinityCategories.Derived.FiberConnectingShift,
    `SerrePositivity.InfinityCategories.Derived.FiberHomologySequence,
    `SerrePositivity.InfinityCategories.Derived.FiberSquareHZero,
    `SerrePositivity.InfinityCategories.Derived.FiberLongExactSequence,

    `SerrePositivity.InfinityCategories.Derived.Homology,
    `SerrePositivity.InfinityCategories.Derived.FiberTriangle,
    `SerrePositivity.InfinityCategories.Derived.ConeEdgeCompatibility,
    `SerrePositivity.InfinityCategories.Derived.SquareLegCompatibility,

    `SerrePositivity.InfinityCategories.Derived.PullbackPresentation,
    `SerrePositivity.InfinityCategories.Derived.PullbackComparison,
    `SerrePositivity.InfinityCategories.Derived.RightFibrationReflection,
    `SerrePositivity.InfinityCategories.Derived.PullbackCriterion,

    `SerrePositivity.InfinityCategories.Derived.HZero,
    `SerrePositivity.InfinityCategories.Derived.ScalarRestrictionNerve,
    `SerrePositivity.InfinityCategories.Derived.BaseChangeDG,
    `SerrePositivity.InfinityCategories.Derived.BaseChange,
    `SerrePositivity.InfinityCategories.Derived.FiltrationCoordinates,
    `SerrePositivity.InfinityCategories.Derived.SemifreeBasisEquivalence,
    `SerrePositivity.InfinityCategories.Derived.ConeBasis,
    `SerrePositivity.InfinityCategories.Derived.HomotopyCategoryComparison,
    `SerrePositivity.InfinityCategories.Derived.SemifreeBaseChange,
    `SerrePositivity.InfinityCategories.Derived.TensorBasis,
    `SerrePositivity.InfinityCategories.Derived.SemifreeTensor,
    `SerrePositivity.InfinityCategories.Derived.SplitSequence,
    `SerrePositivity.InfinityCategories.Derived.SphereBasis,
    `SerrePositivity.InfinityCategories.Derived.NerveInclusionSimplex,
    `SerrePositivity.InfinityCategories.Derived.NerveInclusion,
    `SerrePositivity.InfinityCategories.Derived.NonpositiveBasis,
    `SerrePositivity.InfinityCategories.Derived.FreeResolution,
    `SerrePositivity.InfinityCategories.Derived.DiscreteEmbedding,
    `SerrePositivity.InfinityCategories.Derived.Semifree,
    `SerrePositivity.InfinityCategories.Derived.SemifreeKProjective,
    `SerrePositivity.InfinityCategories.Derived.SemifreeResolution,
    `SerrePositivity.InfinityCategories.Derived.SemifreeSubcategory,
    `SerrePositivity.InfinityCategories.Derived.DerivedComparison,
    `SerrePositivity.InfinityCategories.Derived.InfinityCategory,
    `SerrePositivity.InfinityCategories.Derived.SemifreeClosure,
    `SerrePositivity.InfinityCategories.Derived.SemifreeBasis,
    `SerrePositivity.InfinityCategories.Derived.SemifreeBasisColimit,
    `SerrePositivity.InfinityCategories.Derived.SemifreeBasisHeight,
    `SerrePositivity.InfinityCategories.Derived.ZeroBasisSpheres,
    `SerrePositivity.InfinityCategories.Derived.BasisCut,
    `SerrePositivity.InfinityCategories.Derived.SemifreeBasisFiltration,
    `SerrePositivity.InfinityCategories.Derived.SemifreeBasisLayers,
    `SerrePositivity.InfinityCategories.Derived.RingGradedSplit,
    `SerrePositivity.InfinityCategories.Derived.DerivedComparisonShift]
  let mut count : Nat := 0
  let mut seen : Array Name := #[]
  for (name, _) in env.constants.toList do
    let some idx := env.getModuleIdxFor? name | continue
    let mod := env.header.modules[idx.toNat]!.module
    unless expected.contains mod do continue
    let axioms ← collectAxioms name
    unless axioms.all (#[``propext, ``Classical.choice, ``Quot.sound].contains ·) do
      throwError "Unexpected axioms in {name}: {axioms}"
    count := count + 1
    unless seen.contains mod do seen := seen.push mod
  for mod in expected do
    unless seen.contains mod do throwError "Module not audited: {mod}"
  logInfo m!"D2 axiom audit passed: {count} declarations in {seen.size} modules."
